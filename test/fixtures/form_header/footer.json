{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/column-formatting.schema.json",
  "elmType": "div",
  "attributes": {
    "class": "ms-borderColor-neutralLight"
  },
  "style": {
    "display": "flex",
    "flex-direction": "column",
    "width": "100%",
    "box-sizing": "border-box",
    "border-width": "0 0 1px 0",
    "border-style": "solid",
    "padding-bottom": "10px",
    "margin-bottom": "16px"
  },
  "children": [
    {
      "elmType": "div",
      "style": {
        "display": "flex",
        "flex-direction": "row",
        "flex-wrap": "wrap",
        "justify-content": "space-between",
        "align-items": "flex-start",
        "width": "100%",
        "box-sizing": "border-box"
      },
      "children": [
        {
          "elmType": "div",
          "style": {
            "display": "flex",
            "align-items": "flex-start",
            "min-width": "0",
            "margin-bottom": "6px"
          },
          "children": [
            {
              "elmType": "div",
              "style": {
                "display": "flex",
                "flex-direction": "column",
                "min-width": "0"
              },
              "children": [
                {
                  "elmType": "div",
                  "style": {
                    "line-height": "16px"
                  },
                  "attributes": {
                    "class": "ms-fontColor-neutralSecondary ms-fontSize-12"
                  },
                  "txtContent": "Static."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "elmType": "div",
      "style": {
        "display": "=if((([$Status] == 'Open')), 'flex', 'none')",
        "flex-direction": "row",
        "align-items": "flex-start",
        "align-self": "flex-start",
        "max-width": "100%",
        "box-sizing": "border-box",
        "margin-top": "4px",
        "padding": "4px 10px",
        "line-height": "20px",
        "border-width": "1px",
        "border-style": "solid",
        "border-radius": "4px"
      },
      "attributes": {
        "class": "ms-bgColor-themeLighterAlt ms-borderColor-themeLighter ms-fontColor-themeDarker ms-fontSize-14"
      },
      "children": [
        {
          "elmType": "span",
          "style": {
            "flex": "none",
            "align-self": "flex-start",
            "margin": "3px 8px 0 0"
          },
          "attributes": {
            "iconName": "Lightbulb",
            "aria-hidden": "true",
            "class": "ms-fontSize-14"
          }
        },
        {
          "elmType": "div",
          "style": {
            "display": "flex",
            "flex-direction": "row",
            "flex-wrap": "wrap",
            "align-items": "baseline",
            "column-gap": "16px",
            "min-width": "0",
            "word-wrap": "break-word"
          },
          "children": [
            {
              "elmType": "span",
              "style": {
                "min-width": "0"
              },
              "children": [
                {
                  "elmType": "span",
                  "style": {
                    "margin-right": "4px"
                  },
                  "attributes": {
                    "class": "ms-fontWeight-bold ms-fontColor-neutralPrimary"
                  },
                  "txtContent": "To do now:"
                },
                {
                  "elmType": "span",
                  "attributes": {
                    "class": "ms-fontWeight-semibold"
                  },
                  "txtContent": "=if(([$Status] == 'Open'), 'Open now', '')"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
