// test/fixtures/cross-site.dbml
Project xsite_test { database_type: 'SharePoint Online' }

Enum status { "Open" "Closed" }

Table Project {
  Id        int        [pk, increment]
  Title     nvarchar   [not null]
  ReportsTo int        [ref: > Project.Id]

  Note: 'Cross-site fixture projects, each optionally reporting to another project.'
}

Table Task {
  Id        int        [pk, increment]
  Title     nvarchar   [not null]
  OwnerProject int     [ref: > Project.Id]
  Status    status     [not null]
  OrgUnitCode nvarchar [not null]
  SchemaVersion         nvarchar [not null]

  Note: 'Cross-site fixture tasks, each owned by a project and tagged with an org unit code.'
}
