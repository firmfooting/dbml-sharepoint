// test/fixtures/simple.dbml
Project simple_test {
  database_type: 'SharePoint Online'
  Note: 'Two-table fixture for parser unit tests.'
}

Enum status {
  "Open"
  "Closed"
}

Table Project {
  Id        int        [pk, increment]
  Title     nvarchar   [not null, note: 'Project name.']
  Status    status     [not null, default: 'Open']
  SortOrder int        [not null, default: 0]

  Note: 'Parser-fixture projects, each with a status and a sort order.'
}

Table Task {
  Id        int        [pk, increment]
  Title     nvarchar   [not null]
  Project   int        [ref: > Project.Id, not null]
  DueDate   date       [note: 'Optional due date.']

  indexes {
    DueDate
  }

  Note: 'Parser-fixture tasks, each belonging to one project and optionally due on a date.'
}

Table AppSettings {
  Id        int        [pk, increment]
  Title     nvarchar   [not null, note: 'App Settings singleton.']

  Note: 'Parser-fixture singleton settings list, one row holding the fixture configuration.'
}
