         columnsReady ? 'PASS' : 'FAIL',
         notes.join('; '));

  // The multi-value lookup, on its own so its failure voids one row only.
  const multiLookupCol = target.id === null
    ? { ok: false, note: `${MULTILOOKUP}: not attempted, the target list has no id` }
    : await ensureColumn(MULTILOOKUP, lookupXml('LookupMulti', MULTILOOKUP, true), 'LookupMulti');

  if (!columnsReady) {
    record('library.view.fixture-values-written',
           'Every file reads back holding the values written to it, and one multi-value item shape took',
           'ABORTED', 'the grouping columns were not all created, so no values were written');
    record('library.view.fixture-multi-lookup-ready',
           'A multi-value lookup on the library is created and holds values',
           'ABORTED', `${multiLookupCol.note}; the rest of the fixture did not build`);
    return abortEverything(`the fixture columns did not build: ${notes.join('; ')}`);
  }

  // ---- fixture-values-written ------------------------------------------
  const rootRead = await spGet(`${libPath}/RootFolder?$select=ServerRelativeUrl`);
  const folderUrl = (!readFailed(rootRead)) ? rootRead.body.ServerRelativeUrl : null;
  if (folderUrl === null) {
    record('library.view.fixture-values-written',
           'Every file reads back holding the values written to it, and one multi-value item shape took',
           'ABORTED', `the library RootFolder did not read back (HTTP ${rootRead.status}), so no file could be uploaded`);
    record('library.view.fixture-multi-lookup-ready',
           'A multi-value lookup on the library is created and holds values',
           'ABORTED', 'no file was uploaded, so nothing held a value');
    return abortEverything('the library RootFolder did not read back, so the fixture has no files');
  }

  const uploads = [];
  for (const file of FILES) {
    const uploaded = await rawPost(
      `web/GetFolderByServerRelativeUrl('${folderUrl}')/Files/add(url='${file.name}',overwrite=true)`,
      `dbml-sharepoint library-grouping probe payload for ${file.name}`,
      { 'Content-Type': 'text/plain' });
    uploads.push(uploaded.ok
      ? `uploaded '${file.name}'`
      : `upload of '${file.name}' FAILED HTTP ${uploaded.status}: ${clip(uploaded.text, 160)}`);
  }

  const entityRead = await spGet(`${libPath}?$select=ListItemEntityTypeFullName`);
  itemEntityType = (!readFailed(entityRead)) ? entityRead.body.ListItemEntityTypeFullName : null;

  const itemsRead = await spGet(`${libPath}/items?$select=Id,FileLeafRef&$top=100`);
  const itemRows = (!readFailed(itemsRead) && Array.isArray(itemsRead.body.value)) ? itemsRead.body.value : [];
  const itemIdByName = {};
  for (const row of itemRows) itemIdByName[row.FileLeafRef] = row.Id;

  // Learn documents no multi-value item payload at all, so the shape is an
  // ordered experiment. See the write-shape finding in the header for where
  // each candidate comes from and why none of them is assumed.
  const MULTI_SHAPES = [
    { name: 'bare-array', verbose: false, build: (values) => values },
    { name: 'bare-results', verbose: false, build: (values) => ({ results: values }) },
    { name: 'collection-metadata', verbose: true, build: (values) => ({ __metadata: { type: 'Collection(Edm.String)' }, results: values }) },
  ];
  const LOOKUP_SHAPES = [
    { name: 'bare-array', verbose: false, build: (ids) => ids },
    { name: 'bare-results', verbose: false, build: (ids) => ({ results: ids }) },
    { name: 'verbose-results', verbose: true, build: (ids) => ({ results: ids }) },
  ];

  const valuesOf = (raw) => {
    if (Array.isArray(raw)) return raw;
    if (raw && Array.isArray(raw.results)) return raw.results;
    return null;
  };
  const sameSet = (left, right) => left !== null
    && left.length === right.length
    && right.every((value) => left.some((held) => String(held) === String(value)));

  // Try each shape in order and stop at the first that WRITES AND READS BACK.
  // Stopping at HTTP 200 alone would count a write that silently kept nothing
  // as a success, which is the failure class this project exists to close.
  let winningShape = { multi: null, lookup: null };
  const writeMultiValue = async (itemId, column, selectKey, values, shapes, kind) => {
    const remembered = winningShape[kind];
    const ordered = remembered
      ? [remembered].concat(shapes.filter((shape) => shape !== remembered))
      : shapes;
    const attempts = [];
    for (const shape of ordered) {
      const body = { [column]: shape.build(values) };
      const wrote = shape.verbose
        ? await mergeItemVerbose(itemId, body)
        : await mergeItem(itemId, body);
      if (!wrote.ok) {
        attempts.push(`${shape.name} write HTTP ${wrote.status}`);
        continue;
      }
      const read = await spGet(`${libPath}/items(${itemId})?$select=${selectKey}`);
      const back = readFailed(read) ? null : valuesOf(read.body[selectKey]);
      if (sameSet(back, values)) {
        winningShape[kind] = shape;
        return { ok: true, shape: shape.name, note: `${shape.name} took and read back ${show(back)}` };
      }
      attempts.push(`${shape.name} wrote HTTP ${wrote.status} but read back ${show(back)}`);
    }
    return { ok: false, shape: null, note: attempts.join(', ') };
  };

  const writeNotes = [];
  const multiLookupNotes = [multiLookupCol.note];
  let multiLookupValuesOk = multiLookupCol.ok;
  for (const file of FILES) {
    const itemId = itemIdByName[file.name];
    if (itemId === undefined) {
      writeNotes.push(`'${file.name}' has no list item, so nothing was written to it`);
      continue;
    }
    const scalar = {};
    if (file.single !== null) scalar[SINGLE] = file.single;
    if (file.title !== null) scalar.Title = file.title;
    if (file.target !== null) scalar[`${LOOKUP}Id`] = targetRowIds[file.target];
    if (Object.keys(scalar).length) {
      const wrote = await mergeItem(itemId, scalar);
      writeNotes.push(wrote.ok
        ? `'${file.name}' scalar write HTTP ${wrote.status}`
        : `'${file.name}' scalar write FAILED HTTP ${wrote.status}: ${clip(wrote.text, 160)}`);
    }
    if (file.multi.length) {
      const wrote = await writeMultiValue(itemId, MULTI, MULTI, file.multi, MULTI_SHAPES, 'multi');
      writeNotes.push(`'${file.name}' ${MULTI}: ${wrote.note}`);
    }
    if (multiLookupCol.ok && file.targets.length) {
      const ids = file.targets.map((index) => targetRowIds[index]);
      const wrote = await writeMultiValue(itemId, `${MULTILOOKUP}Id`, `${MULTILOOKUP}Id`, ids, LOOKUP_SHAPES, 'lookup');
      multiLookupNotes.push(`'${file.name}': ${wrote.note}`);
      if (!wrote.ok) multiLookupValuesOk = false;
    }
  }

  // The readback that decides the fixture row. Selected in one call because
  // every name in it belongs to a column this run has already read back.
  const backRead = await spGet(
    `${libPath}/items?$select=Id,Title,FileLeafRef,${SINGLE},${MULTI},${LOOKUP}Id&$top=100`);
  const backRows = (!readFailed(backRead) && Array.isArray(backRead.body.value)) ? backRead.body.value : [];
  const mismatches = [];
  for (const file of FILES) {
    const row = backRows.find((candidate) => candidate.FileLeafRef === file.name);
    if (!row) {
      mismatches.push(`'${file.name}' is not in the library`);
      continue;
    }
    if ((row[SINGLE] === undefined ? null : row[SINGLE]) !== file.single) {
      mismatches.push(`'${file.name}' ${SINGLE} read back ${show(row[SINGLE])}, wrote ${show(file.single)}`);
    }
    if ((row.Title === undefined ? null : row.Title) !== file.title) {
      mismatches.push(`'${file.name}' Title read back ${show(row.Title)}, wrote ${show(file.title)}`);
    }
    const heldMulti = valuesOf(row[MULTI]) || [];
    if (!sameSet(heldMulti, file.multi)) {
      mismatches.push(`'${file.name}' ${MULTI} read back ${show(row[MULTI])}, wrote ${show(file.multi)}`);
    }
    const wantedTarget = file.target === null ? null : targetRowIds[file.target];
    const heldTarget = row[`${LOOKUP}Id`] === undefined ? null : row[`${LOOKUP}Id`];
    if (wantedTarget !== null && heldTarget !== wantedTarget) {
      mismatches.push(`'${file.name}' ${LOOKUP}Id read back ${show(heldTarget)}, wrote ${show(wantedTarget)}`);
    }
  }

  const valuesReady = mismatches.length === 0 && winningShape.multi !== null;
  record('library.view.fixture-values-written',
         'Every file reads back holding the values written to it, and one multi-value item shape took',
         valuesReady ? 'PASS' : 'FAIL',
         `${uploads.join('; ')}. ${writeNotes.join('; ')}. `
         + `multi-value item shape that took: ${show(winningShape.multi ? winningShape.multi.name : null)}. `
         + (mismatches.length ? `readback mismatches: ${mismatches.join('; ')}` : 'every file read back as written'));

  record('library.view.fixture-multi-lookup-ready',
         'A multi-value lookup on the library is created and holds values',
         multiLookupCol.ok && multiLookupValuesOk ? 'PASS' : 'FAIL',
         multiLookupNotes.join('; '));

  if (!valuesReady) {
    return abortEverything(
      `the files did not read back holding the values written to them, so a group-by over `
      + `them would report the fixture rather than SharePoint: ${mismatches.join('; ') || 'no multi-value shape took'}`);
  }

  // ---- Reading a grouping ----------------------------------------------
  const rowsOf = (res) => {
    if (readFailed(res)) return [];
    if (Array.isArray(res.body.Row)) return res.body.Row;
    if (res.body.ListData && Array.isArray(res.body.ListData.Row)) return res.body.ListData.Row;
    return [];
  };

  // `fields` defaults to the grouped column beside Name. The negative control
  // passes its own, so a column that does not exist is named ONLY in the
  // <GroupBy> and never in <ViewFields>, where a refusal would be about the
  // wrong clause. A null fieldName sends the same query with no <GroupBy> at
  // all, which is the flat shape that control compares against.
  const groupBy = async (fieldName, collapse, renderOptions, fields) => {
    const viewFields = fields || ['FileLeafRef', fieldName];
    const grouping = fieldName === null
      ? ''
      : `<GroupBy Collapse="${collapse}"><FieldRef Name="${fieldName}"/></GroupBy>`;
    const viewXml = `<View><Query>${grouping}</Query><ViewFields>`
      + viewFields.map((name) => `<FieldRef Name="${name}"/>`).join('')
      + `</ViewFields><RowLimit>${ROW_LIMIT}</RowLimit></View>`;
    const parameters = renderOptions === undefined
      ? { ViewXml: viewXml }
      : { ViewXml: viewXml, RenderOptions: renderOptions };
    digest = await getDigest();
    const res = await spPost(`${libPath}/RenderListDataAsStream`, { parameters }, digest);
    return { res, rows: rowsOf(res) };
  };

  const countByFile = (rows) => {
    const perFile = {};
    for (const row of rows) {
      const name = row.FileLeafRef === undefined ? '(no FileLeafRef)' : String(row.FileLeafRef);
      perFile[name] = (perFile[name] || 0) + 1;
    }
    return perFile;
  };

  // Everything the SERVER said about one grouping, and nothing this probe
  // worked out for itself. See the client-side-partition finding in the header.
  const observe = async (fieldName) => {
    const collapsed = await groupBy(fieldName, 'TRUE');
    const expanded = await groupBy(fieldName, 'FALSE');
    const labels = collapsed.rows.map((row) => (fieldName in row ? row[fieldName] : undefined));
    const keys = collapsed.rows.length ? Object.keys(collapsed.rows[0]) : [];
    const groupKeys = keys.filter((key) => /group/i.test(key) || key.startsWith(`${fieldName}.`));
    const perFile = countByFile(expanded.rows);
    return {
      collapsed, expanded, labels, keys, groupKeys, perFile,
      refused: !collapsed.res.ok && isRefusal(collapsed.res.status),
      text: `collapsed HTTP ${collapsed.res.status} returned ${collapsed.rows.length} row(s), `
        + `labels ${clip(show(labels), 300)}, group-shaped keys ${clip(show(groupKeys), 300)}, `
        + `first row ${clip(show(collapsed.rows.length ? collapsed.rows[0] : null), 400)}; `
        + `expanded HTTP ${expanded.res.status} returned ${expanded.rows.length} row(s) over `
        + `${FILES.length} file(s), rows per file ${clip(show(perFile), 300)}`
        + (collapsed.res.ok ? '' : `; collapsed body ${clip(collapsed.res.text, 220)}`),
    };
  };

  // ---- control-missing-group-column-ungrouped: NEGATIVE CONTROL --------
  // See the never-refused finding in the header for why this row is not about
  // a refusal. It establishes the IGNORED signature: the two queries below
  // differ only in the <GroupBy>, so the flat row count is measured in this run
  // rather than assumed to be the file count.
  //
  // The markers are named rather than matched on the column name. Every column
  // in this fixture is called Group*, so the /group/i test observe() uses over
  // a real column's keys would match a label key here and report a grouping
  // that is only a naming coincidence.
  const GROUP_MARKER = /\.COUNT\.group$|\.newgroup$|\.groupindex$/;
  const markersIn = (rows, fieldName) => {
    const seen = [];
    for (const row of rows) {
      for (const key of Object.keys(row)) {
        const marks = GROUP_MARKER.test(key)
          || key === fieldName || key.startsWith(`${fieldName}.`);
        if (marks && !seen.includes(key)) seen.push(key);
      }
    }
    return seen;
  };

  // The premise, read back rather than assumed. A column somebody else made
  // under this name would make the rows below a real grouping.
  const missingField = await readField(libPath, MISSING);
  const missingSeen = await groupBy(MISSING, 'TRUE', undefined, ['FileLeafRef']);
  const ungroupedSeen = await groupBy(null, 'TRUE', undefined, ['FileLeafRef']);
  const missingMarkers = markersIn(missingSeen.rows, MISSING);
  // Reported, never a clause of the verdict: a collapsed query's rows do not
  // carry FileLeafRef. See the collapsed-row finding in the header.
  const missingPerFile = countByFile(missingSeen.rows);
  const flatSignature = !missingField.ok
    && missingSeen.res.ok && ungroupedSeen.res.ok
    && missingMarkers.length === 0
    && missingSeen.rows.length === ungroupedSeen.rows.length;
  const negativeHeld = flatSignature;
  record('library.view.control-missing-group-column-ungrouped', Q_NEGATIVE,
         flatSignature ? 'PASS' : missingMarkers.length ? 'FAIL' : 'NOT ESTABLISHED',
         `'${MISSING}' read back HTTP ${missingField.status}`
         + `${missingField.ok ? ', so the column EXISTS and this is not a control' : ''}; `
         + `a group-by naming it returned HTTP ${missingSeen.res.status} with `
         + `${missingSeen.rows.length} row(s) over ${FILES.length} file(s), rows per file `
         + `${clip(show(missingPerFile), 300)}, grouping markers `
         + `${clip(show(missingMarkers), 300)}, first row `
         + `${clip(show(missingSeen.rows.length ? missingSeen.rows[0] : null), 400)}; `
         + `the same query with no <GroupBy> returned HTTP ${ungroupedSeen.res.status} with `
         + `${ungroupedSeen.rows.length} row(s)`
         + (missingSeen.res.ok ? '' : `; body ${clip(missingSeen.res.text, 220)}`)
         + (flatSignature
           ? '. Flat rows carrying no group label, as many as the same query returns with no '
             + '<GroupBy> at all, so a group-by SharePoint ignored is observable and is not the '
             + 'group rows the positive control reads.'
           : missingMarkers.length
             ? '. The rows carry the markers an honoured group-by carries, so this run cannot '
               + 'tell a group-by SharePoint honoured from one it ignored, and every group-by '
               + 'answer below is void.'
             : '. Neither signature: the ignored one was not observed, so a flat answer below '
               + 'cannot be read as a group-by SharePoint ignored.'));

  // ---- control-group-by-single-value-column: POSITIVE CONTROL ----------
  const controlSeen = await observe(SINGLE);
  // The same collapsed query with RenderOptions 2 (ListData), recorded here
  // once rather than doubling every question: if the group row shape depends
  // on RenderOptions, the reader needs to know which shape the rows below are.
  const controlListData = await groupBy(SINGLE, 'TRUE', 2);
  const controlLabels = controlSeen.labels.map((label) => String(label === null || label === undefined ? '' : label));
  const positiveHeld = controlSeen.collapsed.res.ok
    && controlSeen.collapsed.rows.length >= 2
    && controlLabels.some((label) => label.includes('Alpha'))
    && controlLabels.some((label) => label.includes('Beta'));
  record('library.view.control-group-by-single-value-column',
         'POSITIVE CONTROL: a group-by on a single-value Choice column returns group rows this probe can read',
         positiveHeld ? 'PASS' : 'CONTROL FAILED, METHOD VOID',
         `${SINGLE}: ${controlSeen.text}. With RenderOptions 2: HTTP `
         + `${controlListData.res.status}, ${controlListData.rows.length} row(s), first row `
         + `${clip(show(controlListData.rows.length ? controlListData.rows[0] : null), 400)}`
         + (positiveHeld
           ? ''
           : '. A group-by on the column kind library-view-probe.js already measured working did '
             + 'not return group rows this probe could read, so nothing below is a statement about '
             + 'the other column kinds.'));

  const controlsHeld = negativeHeld && positiveHeld;
  const controlReason = negativeHeld
    ? 'the positive control did not hold, so this run cannot read the shape of a group that works'
    : 'the negative control did not hold, so this run cannot tell a group-by SharePoint honoured from one it ignored';

  // Publish one measurement, keeping the observation either way. A void row
  // still carries what was seen: the reader loses the verdict, not the data.
  const publish = (id, question, outcome, evidence) => {
    if (controlsHeld) {
      record(id, question, outcome, evidence);
      return;
    }
    record(id, question, 'NOT ESTABLISHED', `${evidence}. Recorded rather than answered: ${controlReason}.`, 'void');
  };

  // The two candidate multi-value behaviours differ in TWO server-produced
  // observations, and a verdict is named only when both agree. A joined label
  // beside a row count that also exceeds the file count is neither candidate,
  // and is reported as neither rather than as the nearer one.
  const namesBoth = (label, first, second) => {
    const text = Array.isArray(label) ? label.join(' ') : String(label === null || label === undefined ? '' : label);
    return text.includes(first) && text.includes(second);
  };
  const multiValueVerdict = (seen, first, second) => {
    if (seen.refused) {
      return { outcome: 'REFUSED', note: `the group-by was refused. ${seen.text}` };
    }
    if (!seen.collapsed.res.ok || !seen.expanded.res.ok) {
      return { outcome: 'NOT ESTABLISHED', note: `a grouped query failed without refusing. ${seen.text}` };
    }
    const joined = seen.labels.filter((label) => namesBoth(label, first, second));
    const split = seen.expanded.rows.length > FILES.length;
    if (joined.length && !split) {
      return {
        outcome: 'ONE GROUP PER SET',
        note: `group label(s) ${clip(show(joined), 200)} name both ${first} and ${second}, and the `
          + `expanded query returned one row per file. ${seen.text}`,
      };
    }
    if (!joined.length && split) {
      return {
        outcome: 'ONE ROW PER VALUE',
        note: `no group label names two values, and the expanded query returned `
          + `${seen.expanded.rows.length} row(s) over ${FILES.length} file(s), so the file holding `
          + `two values came back under each of them. ${seen.text}`,
      };
    }
    return {
      outcome: 'NOT ESTABLISHED',
      note: `the two observations do not agree on either candidate: joined label(s) `
        + `${clip(show(joined), 200)}, expanded rows ${seen.expanded.rows.length} against `
        + `${FILES.length} file(s). ${seen.text}`,
    };
  };

  // ---- group-by-multi-value-choice -------------------------------------
  const multiSeen = await observe(MULTI);
  const multiVerdict = multiValueVerdict(multiSeen, 'Alpha', 'Beta');
  publish('library.view.group-by-multi-value-choice',
          'Group-by on a multi-value choice: one row per value held, or one group per set?',
          multiVerdict.outcome, `${MULTI}: ${multiVerdict.note}`);

  // ---- group-by-multi-value-lookup -------------------------------------
  if (!multiLookupCol.ok || !multiLookupValuesOk) {
    record('library.view.group-by-multi-value-lookup',
           'Group-by on a multi-value lookup: one row per value held, or one group per set?',
           'NOT ESTABLISHED',
           `the multi-value lookup fixture did not build, so there were no multi-value lookup `
           + `values to group: ${multiLookupNotes.join('; ')}`,
           'void');
  } else {
    const lookupSeen = await observe(MULTILOOKUP);
    const lookupVerdict = multiValueVerdict(lookupSeen, TGT_ROWS[0], TGT_ROWS[1]);
    publish('library.view.group-by-multi-value-lookup',
            'Group-by on a multi-value lookup: one row per value held, or one group per set?',
            lookupVerdict.outcome, `${MULTILOOKUP}: ${lookupVerdict.note}`);
  }

  // ---- group-by-lookup-column ------------------------------------------
  const singleLookupSeen = await observe(LOOKUP);
  const lookupLabels = singleLookupSeen.labels.map(
    (label) => String(label === null || label === undefined ? '' : label));
  const carriesTitle = lookupLabels.some((label) => TGT_ROWS.some((title) => label.includes(title)));
  const carriesEncoding = lookupLabels.some((label) => label.includes(';#'));
  publish('library.view.group-by-lookup-column',
          'Group-by on a lookup the library holds: what do the group labels carry?',
          singleLookupSeen.refused
            ? 'REFUSED'
            : !singleLookupSeen.collapsed.res.ok
              ? 'NOT ESTABLISHED'
              : carriesTitle && !carriesEncoding
                ? 'LABELS CARRY THE DISPLAY FIELD'
                : carriesTitle && carriesEncoding
                  ? 'LABELS CARRY AN ENCODED PAIR'
                  : 'LABELS CARRY NEITHER THE DISPLAY FIELD NOR AN ENCODED PAIR',
          `${LOOKUP} into '${TGT}'.Title, target row titles ${show(TGT_ROWS)}, `
          + `label ids ${show(targetTitleById)}. ${singleLookupSeen.text}`);

  // ---- group-by-name-column --------------------------------------------
  const nameSeen = await observe('FileLeafRef');
  const nameLabels = nameSeen.labels.map((label) => String(label === null || label === undefined ? '' : label));
  const everyFileIsALabel = FILES.every((file) => nameLabels.some((label) => label.includes(file.name)));
  publish('library.view.group-by-name-column',
          'Group-by on Name (FileLeafRef), the column a library has and a list does not',
          nameSeen.refused
            ? 'REFUSED'
            : !nameSeen.collapsed.res.ok
              ? 'NOT ESTABLISHED'
              : everyFileIsALabel && nameSeen.collapsed.rows.length === FILES.length
                ? 'ONE GROUP PER FILE'
                : 'ACCEPTED, GROUPS DO NOT MATCH THE FILES',
          `FileLeafRef over ${FILES.length} distinct file names. ${nameSeen.text}`);

  // ---- group-by-null-title ---------------------------------------------
  // Title is null on a file after upload, settled at
  // library.file-vs-item.title-after-upload, and this fixture leaves it null
  // on three of four files. The question is what heading the null group takes.
  const titleSeen = await observe('Title');
  const nullLabels = titleSeen.labels.filter(
    (label) => label === null || label === undefined || String(label).trim() === '');
  publish('library.view.group-by-null-title',
          'Group-by on Title where Title is null on most files: is there a null group, and what is its heading?',
          titleSeen.refused
            ? 'REFUSED'
            : !titleSeen.collapsed.res.ok
              ? 'NOT ESTABLISHED'
              : nullLabels.length
                ? 'NULL GROUP PRESENT'
                : 'NO NULL GROUP',
          `${FILES.filter((file) => file.title === null).length} of ${FILES.length} file(s) have a `
          + `null Title and one holds ${show(TITLED)}. Empty-looking label(s) `
          + `${clip(show(nullLabels), 200)}. ${titleSeen.text}`);

  // ---- multi-value-group-by-stored-on-view ------------------------------
  const sentQuery = `<GroupBy Collapse="TRUE"><FieldRef Name="${MULTI}"/></GroupBy>`;
  digest = await getDigest();
  const viewMade = await spPost(`${libPath}/views`, {
    Title: VIEW_TITLE, ViewQuery: sentQuery, RowLimit: ROW_LIMIT,
  }, digest);
  const viewsRead = await spGet(`${libPath}/views?$select=Title,ViewQuery,ServerRelativeUrl&$top=100`);
  const storedView = (!readFailed(viewsRead) && Array.isArray(viewsRead.body.value))
    ? viewsRead.body.value.find((view) => view.Title === VIEW_TITLE) || null
    : null;
  const storedQuery = storedView ? storedView.ViewQuery : null;
  publish('library.view.multi-value-group-by-stored-on-view',
          'Does an SP.View store a GroupBy over the multi-value column, and does ViewQuery read back as sent?',
          !viewMade.ok && isRefusal(viewMade.status)
            ? 'REFUSED'
            : storedQuery === null
              ? 'NOT ESTABLISHED'
              : storedQuery === sentQuery
                ? 'STORED AS SENT'
                : String(storedQuery).includes('GroupBy')
                  ? 'STORED, REWRITTEN'
                  : 'STORED WITHOUT THE GROUPBY',
          `create HTTP ${viewMade.status}${viewMade.ok ? '' : `: ${clip(viewMade.text, 200)}`}; `
          + `sent ViewQuery ${show(sentQuery)}; read back ${show(storedQuery)}; `
          + `view url ${show(storedView ? storedView.ServerRelativeUrl : null)}`);

  return report();
})();
