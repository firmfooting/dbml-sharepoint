    Low: String(mask & LOW_HALF),
  });
  const describeMask = (mask) => `High=${halves(mask).High} Low=${halves(mask).Low}`;
  const decodeMask = (mask) => BASE_PERMISSIONS
    .filter(([, bit]) => (mask & bit) === bit)
    .map(([name]) => name);
  // Null rather than a throw when the shape is not there: whether a $select of
  // a complex type returns it inline is an observation, not something known.
  const maskOf = (definition) => {
    const permissions = definition && definition.BasePermissions;
    if (!permissions || permissions.High == null || permissions.Low == null) return null;
    return toMask(permissions.High, permissions.Low);
  };

  const readLevel = (id) => get(
    `web/roledefinitions(${id})?$select=Id,Name,RoleTypeKind,Description,BasePermissions`,
  );
  const writeMask = (id, mask) => merge(`web/roledefinitions(${id})`, {
    __metadata: { type: 'SP.RoleDefinition' },
    BasePermissions: { __metadata: { type: 'SP.BasePermissions' }, ...halves(mask) },
  });
  const deleteLevel = (id) => post(
    `web/roledefinitions(${id})`,
    undefined,
    { 'X-HTTP-Method': 'DELETE', 'IF-MATCH': '*' },
  );
  const renameLevel = (id, name) => merge(`web/roledefinitions(${id})`, {
    __metadata: { type: 'SP.RoleDefinition' },
    Name: name,
  });
  const enumerateLevels = () => get(
    'web/roledefinitions?$select=Id,Name,RoleTypeKind,Description,BasePermissions&$top=200',
  );
  // A create that answers 2xx without a body this can parse would leave an
  // orphan behind, so the Id is resolved by name rather than assumed absent.
  const idOfCreated = async (created, name) => {
    if (!created.ok) return null;
    if (created.d && created.d.Id != null) return created.d.Id;
    const found = await get(`web/roledefinitions/getbyname('${odataName(name)}')?$select=Id`);
    return found.ok && found.d && found.d.Id != null ? found.d.Id : null;
  };

  // Every level this probe created, recorded the moment it exists so that a
  // crash anywhere below still leaves the `finally` something to clean up.
  const ownedLevels = [];
  // A failed restore stops every remaining arm. Populated only by a read-back
  // that did not match, never by a status code.
  const restoreFailures = [];

  const voidRow = (id, question, reason) => record(id, question, 'VOID', reason, 'void');
  const isVoid = (id) => (results.find((candidate) => candidate.id === id) || {}).state === 'void';

  try {
    // ---- CONTROL: is the surface readable at all? ------------------------
    const census = await enumerateLevels();
    if (!census.ok) {
      record('access.built-in-level.control-roledefinitions-readable',
        'CONTROL: can this caller enumerate web/roledefinitions with BasePermissions?',
        'NOT ESTABLISHED', `HTTP ${census.status}: ${census.error}`);
      log('FAIL', 'web/roledefinitions could not be read, so nothing below can be asked. Stopping.');
      return { results, restoreFailures, restored: true };
    }
    const definitions = (census.d && census.d.results) || [];
    const withBitmaps = definitions.filter((definition) => maskOf(definition) !== null);
    record('access.built-in-level.control-roledefinitions-readable',
      'CONTROL: can this caller enumerate web/roledefinitions with BasePermissions?',
      'PASS',
      `read ${definitions.length} level(s), ${withBitmaps.length} of them carrying a BasePermissions bitmap inline`);

    // ---- The pre-write fingerprint ---------------------------------------
    // One read, before anything is written, printed in full. This is the row
    // an operator restores from by hand if everything else goes wrong.
    const fingerprint = definitions.map((definition) => {
      const mask = maskOf(definition);
      return `Id=${definition.Id} kind=${definition.RoleTypeKind} `
        + `${mask === null ? 'bitmap=unread' : describeMask(mask)} '${definition.Name}'`;
    });
    record('access.built-in-level.level-census',
      'What Id, Name, RoleTypeKind and bitmap does every level on this site carry BEFORE any write?',
      `${definitions.length} LEVEL(S)`, fingerprint.join(' | '));

    // ---- CONTROL: is the roster present, and unambiguous? ----------------
    const missing = LEVELS.filter(
      (entry) => !definitions.some((definition) => definition.RoleTypeKind === entry.kind));
    const ambiguous = LEVELS.filter(
      (entry) => definitions.filter(
        (definition) => definition.RoleTypeKind === entry.kind).length > 1);
    const rosterOk = missing.length === 0 && ambiguous.length === 0;
    const byKind = new Map();
    for (const definition of definitions) {
      if (!byKind.has(definition.RoleTypeKind)) byKind.set(definition.RoleTypeKind, definition);
    }
    record('access.built-in-level.control-roster-complete',
      'CONTROL: is every targeted RoleTypeKind present exactly once on this site?',
      rosterOk ? 'PASS' : 'NOT ESTABLISHED',
      rosterOk
        ? `all ${LEVELS.length} targeted kinds present once: `
          + LEVELS.map((entry) => `${entry.kind}='${byKind.get(entry.kind).Name}'`).join(', ')
        : `missing kind(s) [${missing.map((entry) => entry.kind).join(', ')}], `
          + `duplicated kind(s) [${ambiguous.map((entry) => entry.kind).join(', ')}]. `
          + 'The probe targets a fixed roster and refuses rather than widening to whatever is here.');

    // ---- CONTROL: did this site arrive tampered? -------------------------
    // The fail-closed gate. Reported, never repaired: nothing below writes a
    // reference mask to anything.
    const readerDefinition = byKind.get(2);
    const readerMask = readerDefinition ? maskOf(readerDefinition) : null;
    const readerHalves = readerMask === null ? null : halves(readerMask);
    const readerMatches = readerHalves !== null
      && readerHalves.High === REFERENCE_READ_HIGH
      && readerHalves.Low === REFERENCE_READ_LOW;
    record('access.built-in-level.control-read-mask-matches-reference',
      'CONTROL: is this site\'s built-in Read still at the mask measured on 2026-08-14?',
      readerMatches ? 'PASS' : 'NOT ESTABLISHED',
      readerHalves === null
        ? 'no level with RoleTypeKind 2 carried a readable bitmap on this site'
        : `this site: High=${readerHalves.High} Low=${readerHalves.Low}; `
          + `reference: High=${REFERENCE_READ_HIGH} Low=${REFERENCE_READ_LOW} (${REFERENCE_READ_SOURCE}). `
          + (readerMatches
            ? 'No deviation.'
            : 'DEVIATION. Either this Read was legitimately customised, which Learn permits, or it '
              + 'was tampered with. Both must be explained before a probe that writes to permission '
              + 'levels is pasted into this site. Nothing has been repaired and nothing will be.'));

    const writeArmAllowed = rosterOk && readerMatches;
    if (!writeArmAllowed) {
      const reason = !rosterOk
        ? 'access.built-in-level.control-roster-complete failed'
        : 'access.built-in-level.control-read-mask-matches-reference failed';
      log('FAIL', `${reason}, so no write is attempted. Every write-arm row is void.`);
      for (const entry of LEVELS) {
        voidRow(entry.ids.editable, `Does a one-bit MERGE stick on the built-in ${entry.english}?`, reason);
        voidRow(entry.ids.cascade, `While that bit was cleared on ${entry.english}, did any OTHER bit change?`, reason);
        voidRow(entry.ids.restore, `Did ${entry.english} read back at exactly its pre-write mask?`, reason);
        voidRow(entry.ids.deletable, `Is DELETE refused on the built-in ${entry.english}?`, reason);
      }
      voidRow('access.built-in-level.masquerade-create-accepted', 'Is a POST carrying a built-in RoleTypeKind accepted for a CUSTOM level?', reason);
      voidRow('access.built-in-level.masquerade-roletypekind-readback', 'Does the read-back keep RoleTypeKind 2, or is it forced to 0?', reason);
      voidRow('access.built-in-level.masquerade-delete-guarded', 'Is DELETE refused for a custom level wearing a built-in RoleTypeKind?', reason);
      voidRow('access.built-in-level.masquerade-level-removed', 'Was the masquerade level this probe created removed again?', reason);
      voidRow('access.built-in-level.rename-to-builtin-accepted', 'May a custom level take the built-in Read level\'s exact Name?', reason);
      voidRow('access.built-in-level.duplicate-name-resolution', 'With a duplicate name present, which Id does getbyname() resolve to?', reason);
      voidRow('access.built-in-level.rename-level-removed', 'Was the rename level this probe created removed again?', reason);
      voidRow('access.built-in-level.documented-editability-agrees', 'Does the run agree with what Microsoft documents, level by level?', reason);
      return { results, restoreFailures, restored: true };
    }

    // ---- MASQUERADE (question 5) -----------------------------------------
    // Runs before anything touches a built-in, because its answer decides
    // whether the delete arm below is allowed to ask its question at all.
    const masquerade = await post('web/roledefinitions', {
      __metadata: { type: 'SP.RoleDefinition' },
      Name: MASQUERADE_LEVEL,
      Description: PROBE_DESCRIPTION,
      RoleTypeKind: 2,
      BasePermissions: { __metadata: { type: 'SP.BasePermissions' }, High: '0', Low: String(OPEN_BIT) },
    });
    const masqueradeId = await idOfCreated(masquerade, MASQUERADE_LEVEL);
    if (masqueradeId != null) {
      ownedLevels.push({ id: masqueradeId, name: MASQUERADE_LEVEL, row: 'access.built-in-level.masquerade-level-removed' });
    }
    record('access.built-in-level.masquerade-create-accepted',
      'Is a POST carrying a built-in RoleTypeKind accepted for a CUSTOM level?',
      masquerade.ok ? 'ACCEPTED' : 'REFUSED',
      masquerade.ok
        ? `HTTP ${masquerade.status}, created Id=${masqueradeId} named '${MASQUERADE_LEVEL}' with RoleTypeKind 2 requested`
        : `HTTP ${masquerade.status}: ${masquerade.error}`);

    let masqueradeKind = null;
    if (masqueradeId != null) {
      const readback = await readLevel(masqueradeId);
      masqueradeKind = readback.ok && readback.d ? readback.d.RoleTypeKind : null;
      record('access.built-in-level.masquerade-roletypekind-readback',
        'Does the read-back keep RoleTypeKind 2, or is it forced to 0?',
        !readback.ok ? 'NOT ESTABLISHED' : masqueradeKind === 2 ? 'PRESERVED' : 'SERVER-ASSIGNED',
        !readback.ok
          ? `HTTP ${readback.status}: ${readback.error}`
          : `requested RoleTypeKind 2, read back ${masqueradeKind}. `
            + (masqueradeKind === 2
              ? 'A custom level can wear a built-in kind, so a deleted built-in could be rebuilt with its kind intact.'
              : 'RoleTypeKind is server-assigned on create, so a deleted built-in could NOT be rebuilt with its kind.'));
    } else {
      voidRow('access.built-in-level.masquerade-roletypekind-readback',
        'Does the read-back keep RoleTypeKind 2, or is it forced to 0?',
        'access.built-in-level.masquerade-create-accepted failed, so there is nothing to read back');
    }

    // The non-destructive proxy for question 4: if SharePoint guards DELETE on
    // RoleTypeKind, it can be shown here without touching a real built-in.
    if (masqueradeKind === 2) {
      const guarded = await deleteLevel(masqueradeId);
      record('access.built-in-level.masquerade-delete-guarded',
        'Is DELETE refused for a custom level wearing a built-in RoleTypeKind?',
        guarded.ok ? 'DELETED' : isRefusal(guarded.status) ? 'REFUSED' : 'NOT ESTABLISHED',
        guarded.ok
          ? `HTTP ${guarded.status}. The guard is not keyed on RoleTypeKind, so this says nothing about a real built-in.`
          : `HTTP ${guarded.status}: ${guarded.error}`);
      if (guarded.ok) {
        const index = ownedLevels.findIndex((owned) => owned.id === masqueradeId);
        if (index >= 0) ownedLevels[index].deleted = true;
      }
    } else {
      voidRow('access.built-in-level.masquerade-delete-guarded',
        'Is DELETE refused for a custom level wearing a built-in RoleTypeKind?',
        masquerade.ok
          ? `the level read back with RoleTypeKind ${masqueradeKind}, so it is not wearing a built-in kind and cannot answer this`
          : 'access.built-in-level.masquerade-create-accepted failed, so there is no level to delete');
    }

    // ---- RENAME (question 6) ---------------------------------------------
    // Collides with whatever this site's RoleTypeKind 2 level is ACTUALLY
    // called, not with the English word, because the built-in names are
    // localised and a hard-coded 'Read' would make this vacuous elsewhere.
    const readerName = readerDefinition.Name;
    const renameCreate = await post('web/roledefinitions', {
      __metadata: { type: 'SP.RoleDefinition' },
      Name: RENAME_LEVEL,
      Description: PROBE_DESCRIPTION,
      BasePermissions: { __metadata: { type: 'SP.BasePermissions' }, High: '0', Low: String(OPEN_BIT) },
    });
    const renameId = await idOfCreated(renameCreate, RENAME_LEVEL);
    if (renameId != null) {
      ownedLevels.push({ id: renameId, name: RENAME_LEVEL, row: 'access.built-in-level.rename-level-removed' });
      const collided = await renameLevel(renameId, readerName);
      record('access.built-in-level.rename-to-builtin-accepted',
        'May a custom level take the built-in Read level\'s exact Name?',
        collided.ok ? 'ACCEPTED' : isRefusal(collided.status) ? 'REFUSED' : 'NOT ESTABLISHED',
        collided.ok
          ? `HTTP ${collided.status}. Id=${renameId} now also answers to '${readerName}', beside built-in Id=${readerDefinition.Id}.`
          : `HTTP ${collided.status}: ${collided.error}`);

      if (collided.ok) {
        // The consequence that matters: the deploy resolves levels by name.
        const filtered = await get(
          `web/roledefinitions?$filter=Name eq '${odataName(readerName)}'&$select=Id,Name,RoleTypeKind`);
        const matched = (filtered.ok && filtered.d && filtered.d.results) || [];
        const resolved = await get(
          `web/roledefinitions/getbyname('${odataName(readerName)}')?$select=Id,Name,RoleTypeKind`);
        const resolvedId = resolved.ok && resolved.d ? resolved.d.Id : null;
        record('access.built-in-level.duplicate-name-resolution',
          'With a duplicate name present, which Id does getbyname() resolve to?',
          !resolved.ok ? 'NOT ESTABLISHED' : resolvedId === readerDefinition.Id ? 'RESOLVES TO BUILT-IN' : 'RESOLVES TO IMPOSTOR',
          !resolved.ok
            ? `$filter returned ${matched.length} row(s); getbyname answered HTTP ${resolved.status}: ${resolved.error}`
            : `$filter returned ${matched.length} row(s) [`
              + matched.map((row) => `Id=${row.Id} kind=${row.RoleTypeKind}`).join(', ')
              + `]; getbyname resolved to Id=${resolvedId} (built-in is Id=${readerDefinition.Id}, `
              + `impostor is Id=${renameId}).`);
      } else {
        voidRow('access.built-in-level.duplicate-name-resolution',
          'With a duplicate name present, which Id does getbyname() resolve to?',
          'access.built-in-level.rename-to-builtin-accepted was refused, so no duplicate exists to resolve');
      }
      // Renamed back at once. The duplicate is the most dangerous state this
      // probe can leave behind, because anything resolving a level by name
      // while it stands may bind the wrong one.
      await renameLevel(renameId, RENAME_LEVEL);
    } else {
      record('access.built-in-level.rename-to-builtin-accepted',
        'May a custom level take the built-in Read level\'s exact Name?',
        'NOT ESTABLISHED',
        `the probe's own level was not created, or was created without an Id this could resolve: HTTP ${renameCreate.status}${renameCreate.error ? `: ${renameCreate.error}` : ''}`);
      voidRow('access.built-in-level.duplicate-name-resolution',
        'With a duplicate name present, which Id does getbyname() resolve to?',
        'access.built-in-level.rename-to-builtin-accepted was never asked, because its level was not created');
    }

    // ---- EDIT (questions 2 and 3), safest first --------------------------
    const verdicts = new Map();
    for (const entry of LEVELS) {
      const question = `Does a one-bit MERGE stick on the built-in ${entry.english}?`;
      if (restoreFailures.length) {
        record(entry.ids.editable, question, 'NOT REACHED', 'an earlier level did not restore, so the run stopped writing');
        record(entry.ids.cascade, `While that bit was cleared on ${entry.english}, did any OTHER bit change?`, 'NOT REACHED', 'the run stopped writing');
        record(entry.ids.restore, `Did ${entry.english} read back at exactly its pre-write mask?`, 'NOT REACHED', 'the run stopped writing');
        continue;
      }
      const definition = byKind.get(entry.kind);
      const before = await readLevel(definition.Id);
      const preMask = before.ok ? maskOf(before.d) : null;
      if (preMask === null) {
        record(entry.ids.editable, question, 'NOT ESTABLISHED',
          `could not read ${entry.english} (Id=${definition.Id}) immediately before writing: HTTP ${before.status} ${before.error || 'no bitmap in the payload'}`);
        voidRow(entry.ids.cascade, `While that bit was cleared on ${entry.english}, did any OTHER bit change?`,
          `${entry.ids.editable} could not establish a pre-write mask`);
        voidRow(entry.ids.restore, `Did ${entry.english} read back at exactly its pre-write mask?`,
          `${entry.ids.editable} could not establish a pre-write mask`);
        continue;
      }
      const chosen = clearableBit(preMask);
      if (!chosen) {
        record(entry.ids.editable, question, 'NOT ESTABLISHED',
          `${entry.english} carries no named, unprotected, low-half bit to clear (${describeMask(preMask)}), and the probe does not widen its rule to find one`);
        voidRow(entry.ids.cascade, `While that bit was cleared on ${entry.english}, did any OTHER bit change?`,
          `${entry.ids.editable} had no eligible bit`);
        voidRow(entry.ids.restore, `Did ${entry.english} read back at exactly its pre-write mask?`,
          `${entry.ids.editable} had no eligible bit`);
        continue;
      }
      const [bitName, bit] = chosen;
      const target = preMask & ~bit;
      log('INFO', `${entry.english} (Id=${definition.Id}): clearing ${bitName} from ${describeMask(preMask)} to ${describeMask(target)}.`);
      const wrote = await writeMask(definition.Id, target);
      const after = await readLevel(definition.Id);
      const afterMask = after.ok ? maskOf(after.d) : null;

      const cleared = afterMask !== null && (afterMask & bit) === 0n;
      const editableOutcome = afterMask === null
        ? 'NOT ESTABLISHED'
        : cleared ? 'EDITABLE' : wrote.ok ? 'ACCEPTED BUT IGNORED' : 'REFUSED';
      verdicts.set(entry.slug, editableOutcome);
      record(entry.ids.editable, question, editableOutcome,
        afterMask === null
          ? `MERGE answered HTTP ${wrote.status}${wrote.ok ? '' : `: ${wrote.error}`}, and the read-back could not be decoded: HTTP ${after.status} ${after.error || 'no bitmap in the payload'}`
          : `MERGE answered HTTP ${wrote.status}${wrote.ok ? '' : `: ${wrote.error}`}; cleared ${bitName}; read back ${describeMask(afterMask)} against a pre-write ${describeMask(preMask)}`);

      const cascadeQuestion = `While that bit was cleared on ${entry.english}, did any OTHER bit change?`;
      if (!cleared || afterMask === null) {
        voidRow(entry.ids.cascade, cascadeQuestion,
          `${entry.ids.editable} recorded ${editableOutcome}, so no bit was cleared and there was nothing to observe alongside it`);
      } else {
        const moved = afterMask ^ target;
        record(entry.ids.cascade, cascadeQuestion,
          moved === 0n ? 'NO CASCADE' : 'CASCADED',
          moved === 0n
            ? `the read-back equals the requested mask exactly, so clearing ${bitName} moved nothing else`
            : `bits [${decodeMask(moved).join(', ') || describeMask(moved)}] differ between the requested ${describeMask(target)} and the read-back ${describeMask(afterMask)}`);
      }

      // Restore, then verify by exact read-back. The status of the restoring
      // write decides nothing; only the mask that comes back does.
      const restored = await writeMask(definition.Id, preMask);
      const back = await readLevel(definition.Id);
      const backMask = back.ok ? maskOf(back.d) : null;
      const restoreOk = backMask !== null && backMask === preMask;
      record(entry.ids.restore, `Did ${entry.english} read back at exactly its pre-write mask?`,
        restoreOk ? 'PASS' : 'FAIL',
        restoreOk
          ? `restore answered HTTP ${restored.status}; ${describeMask(backMask)} matches the pre-write mask exactly`
          : `restore answered HTTP ${restored.status}${restored.ok ? '' : `: ${restored.error}`}; read back `
            + `${backMask === null ? 'nothing decodable' : describeMask(backMask)} against a pre-write ${describeMask(preMask)}`);
      if (!restoreOk) {
        restoreFailures.push({
          level: entry.english, id: definition.Id, name: definition.Name,
          writeBackHigh: halves(preMask).High, writeBackLow: halves(preMask).Low,
        });
      }
    }

    // ---- The documentation, compared against the run ---------------------
    const disagreements = LEVELS
      .filter((entry) => verdicts.has(entry.slug))
      .map((entry) => {
        const observed = verdicts.get(entry.slug);
        const predicted = entry.documented === 'refused' ? 'REFUSED' : 'EDITABLE';
        return { entry, observed, predicted, agrees: observed === predicted };
      });
    const judged = disagreements.filter((row) => row.observed !== 'NOT ESTABLISHED');
    const differing = judged.filter((row) => !row.agrees);
    record('access.built-in-level.documented-editability-agrees',
      'Does the run agree with what Microsoft documents, level by level?',
      judged.length === 0 ? 'NOT ESTABLISHED' : differing.length === 0 ? 'AGREES' : 'DISAGREES',
      judged.length === 0
        ? 'no level produced a decidable edit verdict, so there is nothing to compare'
        : `${judged.length} level(s) judged: `
          + judged.map((row) => `${row.entry.english} documented ${row.predicted}, observed ${row.observed}`).join('; ')
          + (differing.length === 0
            ? '. Every level behaved as documented.'
            : `. DISAGREES on ${differing.map((row) => row.entry.english).join(', ')}. `
              + differing.map((row) => row.entry.cite).join(' ')));

    // ---- DELETE (question 4) ---------------------------------------------
    const rebuildable = masqueradeKind === 2;
    for (const entry of LEVELS) {
      const question = `Is DELETE refused on the built-in ${entry.english}?`;
      const definition = byKind.get(entry.kind);
      if (!ALLOW_DESTRUCTIVE_DELETE) {
        record(entry.ids.deletable, question, 'NOT ESTABLISHED',
          'ALLOW_DESTRUCTIVE_DELETE is false. Microsoft documents four of the six roster levels as '
          + 'deletable, so this arm is a request to delete a built-in permission level, not a '
          + 'refusal-capture experiment. Set it only on a disposable site.');
        continue;
      }
      if (!rebuildable) {
        voidRow(entry.ids.deletable, question,
          'access.built-in-level.masquerade-roletypekind-readback showed RoleTypeKind is not preserved '
          + 'on create, so a successful delete could not be undone. This probe does not ask a question '
          + 'whose "yes" it cannot reverse.');
        continue;
      }
      if (restoreFailures.length) {
        record(entry.ids.deletable, question, 'NOT REACHED', 'an earlier level did not restore, so the run stopped writing');
        continue;
      }
      const before = await readLevel(definition.Id);
      const preMask = before.ok ? maskOf(before.d) : null;
      if (preMask === null) {
        record(entry.ids.deletable, question, 'NOT ESTABLISHED',
          `could not fingerprint ${entry.english} immediately before deleting it, and this probe does not delete what it cannot rebuild`);
        continue;
      }
      const removed = await deleteLevel(definition.Id);
      if (!removed.ok) {
        record(entry.ids.deletable, question,
          isRefusal(removed.status) ? 'REFUSED' : 'NOT ESTABLISHED',
          `HTTP ${removed.status}: ${removed.error}`);
        continue;
      }
      // Deleted. Rebuild at once from the fingerprint, and say plainly what a
      // rebuild cannot bring back.
      const rebuilt = await post('web/roledefinitions', {
        __metadata: { type: 'SP.RoleDefinition' },
        Name: before.d.Name,
        Description: before.d.Description || '',
        RoleTypeKind: before.d.RoleTypeKind,
        BasePermissions: { __metadata: { type: 'SP.BasePermissions' }, ...halves(preMask) },
      });
      const check = rebuilt.ok && rebuilt.d && rebuilt.d.Id != null
        ? await readLevel(rebuilt.d.Id)
        : { ok: false, status: rebuilt.status, error: rebuilt.error, d: null };
      const rebuiltMask = check.ok ? maskOf(check.d) : null;
      const rebuiltOk = rebuiltMask === preMask && check.ok && check.d.RoleTypeKind === before.d.RoleTypeKind;
      record(entry.ids.deletable, question, 'DELETED',
        `DELETE answered HTTP ${removed.status}. Rebuild ${rebuiltOk ? 'verified' : 'NOT verified'}: `
        + `new Id=${rebuilt.d && rebuilt.d.Id} (was ${definition.Id}), kind=${check.d ? check.d.RoleTypeKind : 'unread'}, `
        + `${rebuiltMask === null ? 'bitmap unread' : describeMask(rebuiltMask)} against ${describeMask(preMask)}. `
        + 'The Id changed and every role assignment naming the old level is gone at every scope.');
      if (!rebuiltOk) {
        restoreFailures.push({
          level: entry.english, id: definition.Id, name: before.d.Name,
          writeBackHigh: halves(preMask).High, writeBackLow: halves(preMask).Low,
        });
      }
    }
  } finally {
    // ---- Cleanup: only what this probe created, by Id ---------------------
    for (const owned of ownedLevels) {
      if (owned.deleted) continue;
      await renameLevel(owned.id, owned.name);
      let gone = await deleteLevel(owned.id);
      if (!gone.ok) {
        // A level wearing a built-in RoleTypeKind may be refused; drop the
        // kind first rather than leave the object behind.
        await merge(`web/roledefinitions(${owned.id})`, {
          __metadata: { type: 'SP.RoleDefinition' }, RoleTypeKind: 0,
        });
        gone = await deleteLevel(owned.id);
      }
      owned.deleted = gone.ok;
      owned.status = gone.status;
      owned.error = gone.error;
    }
    // Verified by re-enumeration rather than by the delete's status code, and
    // by Id rather than by name, because a name is what this probe just proved
    // is not an identity.
    const remaining = await enumerateLevels();
    const survivingIds = new Set(
      ((remaining.ok && remaining.d && remaining.d.results) || []).map((row) => row.Id));
    for (const [row, name, question] of [
      ['access.built-in-level.masquerade-level-removed', MASQUERADE_LEVEL, 'Was the masquerade level this probe created removed again?'],
      ['access.built-in-level.rename-level-removed', RENAME_LEVEL, 'Was the rename level this probe created removed again?'],
    ]) {
      const owned = ownedLevels.find((candidate) => candidate.row === row);
      if (isVoid(row)) {
        // A control refused the write arm, so this row is already void and
        // "nothing was created" is not the reason worth keeping.
        continue;
      }
      if (!owned) {
        record(row, question, 'NOT ESTABLISHED', `'${name}' was never created, so there was nothing to remove`);
      } else if (!remaining.ok) {
        record(row, question, 'NOT ESTABLISHED',
          `could not re-enumerate to confirm removal: HTTP ${remaining.status}: ${remaining.error}`);
      } else {
        const survives = survivingIds.has(owned.id);
        record(row, question, survives ? 'FAIL' : 'PASS',
          survives
            ? `Id=${owned.id} named '${name}' is STILL PRESENT after DELETE answered HTTP ${owned.status}${owned.error ? `: ${owned.error}` : ''}. Delete it by hand.`
            : `Id=${owned.id} named '${name}' is gone from web/roledefinitions.`);
      }
    }

    if (restoreFailures.length) {
      log('FAIL', `${restoreFailures.length} level(s) were NOT restored. Fix this by hand before leaving the site.`);
      for (const failure of restoreFailures) {
        log('FAIL', `  ${failure.level} (Id=${failure.id}, '${failure.name}'): MERGE BasePermissions High='${failure.writeBackHigh}' Low='${failure.writeBackLow}'.`);
      }
    }
    console.table(results);
  }
  return { results, restoreFailures, restored: restoreFailures.length === 0 };
})();
