{
  "elmType": "div",
  "attributes": { "class": "ms-borderColor-neutralTertiary" },
  "style": {
    "width": "99%",
    "border-top-width": "0px",
    "border-bottom-width": "1px",
    "border-left-width": "0px",
    "border-right-width": "0px",
    "border-style": "solid",
    "margin-bottom": "16px"
  },
  "children": [
    {
      "elmType": "div",
      "style": { "display": "flex", "box-sizing": "border-box", "align-items": "center" },
      "children": [
        {
          "elmType": "div",
          "attributes": {
            "iconName": "Shield",
            "class": "ms-fontSize-42 ms-fontWeight-regular ms-fontColor-themePrimary",
            "title": "Risk"
          },
          "style": { "flex": "none", "padding": "0px", "height": "auto" }
        }
      ]
    },
    {
      "elmType": "div",
      "style": { "box-sizing": "border-box", "width": "100%", "text-align": "left", "padding": "4px 8px", "overflow": "hidden" },
      "children": [
        {
          "elmType": "div",
          "attributes": { "class": "ms-fontColor-neutralSecondary ms-fontWeight-bold ms-fontSize-16" },
          "txtContent": "='Risk: ' + [$Title]"
        },
        {
          "elmType": "div",
          "attributes": { "class": "ms-fontColor-neutralSecondary ms-fontSize-12" },
          "txtContent": "Pick Likelihood and Consequence — the rating and score calculate themselves."
        },
        {
          "elmType": "a",
          "txtContent": "Project risk process guide",
          "attributes": {
            "target": "_blank",
            "href": "https://REPLACE-WITH-PROJECT-RISK-PROCESS-URL",
            "class": "ms-fontColor-themePrimary ms-fontSize-12 ms-fontWeight-semibold"
          }
        },
        {
          "elmType": "div",
          "style": { "display": "=if([$ResidualRiskRating] == '', 'none', 'flex')", "flex-wrap": "wrap", "margin-top": "6px" },
          "children": [
            {
              "elmType": "div",
              "attributes": { "class": "=if(indexOf([$ResidualRiskRating], 'Extreme') >= 0, 'sp-field-severity--blocked', if(indexOf([$ResidualRiskRating], 'High') >= 0, 'sp-field-severity--severeWarning', if(indexOf([$ResidualRiskRating], 'Medium') >= 0, 'sp-field-severity--warning', 'sp-field-severity--good'))) + ' ms-fontColor-neutralSecondary'" },
              "style": { "display": "inline-flex", "align-items": "center", "padding": "4px 10px", "border-radius": "4px", "font-weight": "600" },
              "children": [
                { "elmType": "span", "style": { "display": "inline-block", "padding": "0 4px" }, "attributes": { "iconName": "=if(indexOf([$ResidualRiskRating], 'Extreme') >= 0, 'ErrorBadge', if(indexOf([$ResidualRiskRating], 'High') >= 0, 'Warning', if(indexOf([$ResidualRiskRating], 'Medium') >= 0, 'Error', 'CheckMark')))" } },
                { "elmType": "span", "txtContent": "='Residual: ' + if(indexOf([$ResidualRiskRating], ';#') >= 0, substring([$ResidualRiskRating], indexOf([$ResidualRiskRating], ';#') + 2, 1000), [$ResidualRiskRating])" }
              ]
            }
          ]
        }
      ]
    }
  ]
}
