// ============================================================================
// Service evidence register — a contemporaneous record of what an external
// service provider is actually delivering, the chases it took to get an
// answer, and the themes worth raising formally.
//
// Deliberately domain-neutral: the same register serves a technology
// arrangement, a payroll bureau, a facilities contractor or a finance shared
// service. Nothing here names a provider or a sector.
//
// The organising principle is that FACT, IMPACT and CHARACTERISATION are
// separate columns. A row where all three share one text box is an anecdote;
// a row where they are separate is a business record.
//
// Render the ERD by pasting this file into https://dbdiagram.io
// ============================================================================

Project service_evidence_register { database_type: 'SharePoint Online Lists' }

// Generic enough to describe any outsourced arrangement. Replace these
// members with your own service breakdown before first deploy — renaming a
// choice afterwards strands the rows already on the old value.
Enum service_domain {
  "Requests or help desk"
  "Access, accounts or permissions"
  "Systems, applications or tools"
  "Equipment or physical assets"
  "Connectivity or infrastructure"
  "Data, records or reporting"
  "Projects or change delivery"
  "Advice or professional support"
  "Onboarding or offboarding"
  "Billing or charging"
  "Other"
}

// One ladder, shared by FollowUp and ServiceIssue, so a single chase and the
// theme it feeds describe escalation the same way.
Enum escalation_level {
  "Operational contact"
  "Service desk or first line"
  "Service manager"
  "Relationship or contract manager"
  "Executive"
  "Formal contract mechanism"
}

// Judged on the pattern, not on the worst single event in it.
Enum issue_materiality {
  "Irritant"
  "Material"
  "Serious"
  "Critical to service"
}

Enum issue_status {
  "Assembling"
  "Ready to raise"
  "Raised"
  "Response received"
  "Remedy agreed"
  "Resolved"
  "Unresolved"
  "Closed"
}

// A theme, not an occurrence: the pattern you take to a review meeting, with
// the evidence behind it and what happened when you raised it.
Table ServiceIssue {
  Id                   int                [pk, increment]
  Title                nvarchar           [not null, note: 'The theme in one line, as you would say it in the meeting where you raise it']
  Provider             nvarchar           [not null, note: 'The provider or service arrangement this concerns. Write the name the same way on every record so the grouped views hold together']
  ServiceAffected      service_domain     [note: 'The part of the service this pattern sits in']
  IssueSummary         longtext           [not null, note: 'The pattern in three or four sentences: what keeps happening, since when, and what it is costing']
  FirstObserved        date               [not null, note: 'The date of the earliest event supporting this theme']

  Materiality          issue_materiality  [not null, note: 'How much this matters to the organisation. Judge the pattern, not the worst single event in it']
  EventCount           int                [note: 'How many logged events support this theme. Fill this in when you assemble the pack; the linked events stay the source of truth']
  CommitmentEngaged    nvarchar           [note: 'The commitment, target or obligation this pattern bears on. Leave blank if nothing was written down - an unmet reasonable expectation is still worth raising']
  BusinessConsequence  longtext           [note: 'What the pattern means for the organisation, as distinct from any single event']

  Status               issue_status       [not null, default: 'Assembling', note: 'Where this theme has got to']
  RaisedDate           date               [note: 'The date you raised it']
  RaisedWith           nvarchar           [note: 'The forum, role or meeting where it was raised. Name the role rather than the individual']
  EscalationLevel      escalation_level   [note: 'How far this has been taken']

  ResponseDate         date               [note: 'The date they responded']
  ResponseSummary      longtext           [note: 'What they said, as close to their words as you can manage']
  RemedyAgreed         longtext           [note: 'What was agreed, by whom, and by when']
  RemedyDueDate        date               [note: 'The date the agreed remedy falls due']

  IssueOwner           person             [note: 'The person carrying this issue. Naming someone here does not grant them access']
  NextReviewDue        date               [note: 'When you will next look at this']
  Outcome              longtext           [note: 'How it ended, including anything left unresolved']
  ClosedDate           date               [note: 'The date this theme was closed']

  DaysToResponse       calculated_number  [note: 'Calculated automatically: days from raising it to their response']

  indexes {
    Status
    Provider
    Materiality
    EscalationLevel
    RaisedDate
    RemedyDueDate
    NextReviewDue
    FirstObserved
  }
}
