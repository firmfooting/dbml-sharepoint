{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/column-formatting.schema.json",
  "elmType": "div",
  "style": { "display": "flex", "border-radius": "4px", "margin": "1px 4px 1px 0" },
  "attributes": {
    "class": "=if(@currentField, 'sp-field-severity--low', 'ms-bgColor-neutralLight') + ' ms-fontColor-neutralSecondary'"
  },
  "children": [
    {
      "elmType": "span",
      "style": { "display": "inline-block", "padding": "0 4px" },
      "txtContent": "=if(@currentField, 'Active', 'Moved on')"
    }
  ]
}
