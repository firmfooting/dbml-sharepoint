{# src/dbml_sharepoint/templates/central-log.js.j2
   The deploy-central-log sidecar: create the central logging SITE (if
   absent) and the deployment log LIST on it, then stamp one provenance row.
   Consent-shaped: a DEPLOY never creates a site, an operator who pastes
   THIS script has.

   Pasted anywhere on the tenant (the digest and cookies are site-bound but
   SharePoint answers cross-web REST the same as local, same origin). The
   transport and the site guard are the shared partials, exactly as
   rollback.js includes them; cross-web requests go through centralApi(),
   which keeps the apiUrl() suffix discipline (no template writes an API
   itself) while pointing at the central web.

   Every write reads back. An existing site or list is adopted only when its
   Description matches this tool's marker compared WHOLE (the same
   fail-closed ownership test every sidecar uses); a foreign object of the
   same name stops the script with an ERROR and changes nothing. #}
/**
 * dbml-sharepoint deploy-central-log script.
 *
 * Creates, if absent: the site '{{ central_log_site }}' and the list
 * '{{ central_log_list }}' on it, then stamps one provenance row. Run it
 * ONCE per tenant, from any site you own. If both already exist and carry
 * this tool's marker, it changes nothing and says so.
 *
 * Creating a SITE needs tenant rights (SharePoint admin or a provisioned
 * self-service path). If the site create is refused, the script says who
 * to ask; creating the list afterwards still needs only Site Owner on the
 * central site.
 */
(async () => {
  const CENTRAL_SITE = {{ central_log_site | tojson }};
  const CENTRAL_LIST = {{ central_log_list | tojson }};
  const CENTRAL_MARKER = {{ central_log_marker | tojson }};
  const DEPLOYER_VERSION = {{ deployer_version | tojson }};
  const GENERATED_AT = {{ generated_at | tojson }};
  // The page this script is pasted on. It only names the tenant root; the
  // site guard verifies the page is a real web of THIS tenant before any
  // request is made.

  const log = (level, msg) => console.log(`[SP-CENTRAL-LOG] [${level}] ${msg}`);
  const summary = { created: [], adopted: [], errors: [] };

  // NO strict site guard: this script is intentionally cross-site. It is
  // pasted on any site the operator owns and writes to a DIFFERENT one,
  // so there is nothing to pin the page against. Everything it does is
  // bounded by the two names below and by the marker comparison.
  //
  // Identity comes from REST (`web/currentuser`), NOT `_spPageContextInfo`:
  // the modern pages this is most likely to be pasted on (CollabHome) do
  // not define that global at all (measured 2026-08-26, see the test
  // agent's SharePoint-REST notes). The origin alone answers TENANT_ROOT.
  const SITE_URL = window.location.origin;
  const odataName = (name) => encodeURIComponent(String(name).replace(/'/g, "''"));
  // apiUrl() local form: the digest partial POSTs contextinfo to the page's
  // OWN web. On a modern page (CollabHome) there is no web path to reuse,
  // so the digest targets the tenant root's contextinfo -- a digest is
  // tenant-wide, not web-scoped, so any web's contextinfo serves.
  const SITE_PATH = (/^\/sites\/[^/]+/.exec(window.location.pathname) || [''])[0];
  const apiUrl = (suffix) => `${SITE_PATH}/_api/${suffix}`;
  // BUT the digest must come from the CENTRAL web, not the pasted page's
  // web: SharePoint scopes a form digest's validation to the web that
  // issued it (live finding 2026-09-05: a TestSampleTeam digest POSTed to
  // firmfooting-logging answered 403 "security validation ... invalid",
  // the same body's own digest answered 201). crossWebPost() is the
  // cross-web write the sidecar uses everywhere.
  const crossWebPost = (site, suffix, body) => {
    const digestUrl = `${TENANT_ROOT}/sites/${odataName(site)}/_api/contextinfo`;
    return fetchWithRetry(digestUrl, {
      method: 'POST',
      headers: { 'Accept': 'application/json;odata=verbose' },
    }).then((r) => r.json()).then((j) => {
      const digest = (((j.d || {}).GetContextWebInformation || {}).FormDigestValue) || '';
      if (!digest) throw new Error(`contextinfo for '${site}' carried no digest`);
      return fetchWithRetry(centralApi(suffix), {
        method: 'POST',
        headers: spHeaders(digest),
        body: JSON.stringify(body),
      });
    });
  };
  // The central web's API: the cross-web form of apiUrl() -- same suffix
  // discipline, pointed at the central logging site. Same origin, so the
  // session cookies ride along. WEB and odataName come from the context
  // block above.
{% include "_cross_web.js.j2" %}
  const centralApi = (suffix) => crossWebApi(CENTRAL_SITE, suffix);

{% include "_http.js.j2" %}

{% include "_http_write.js.j2" %}

{% include "_digest_cached.js.j2" %}

  // --- 1. The site -------------------------------------------------------
  // web/ exists on ANY site, so probing the central site directly: a 200
  // means it is there (adopt it), a 404 means create it. A 403 also means
  // it is there -- someone else's guard answered -- and is adopted for
  // probing but will fail loudly at the first write if the operator
  // cannot write to it.
  let centralWebOk = false;
  const siteProbe = await fetchWithRetry(centralApi('?$select=Url'), {
    headers: { 'Accept': 'application/json;odata=verbose' },
  });
  if (siteProbe.ok || siteProbe.status === 403) {
    centralWebOk = true;
    log('INFO', `Site '${CENTRAL_SITE}' already exists${siteProbe.status === 403 ? ' (visible but this account was refused; writes may fail)' : ''}.`);
    summary.adopted.push(`site ${CENTRAL_SITE}`);
  } else if (siteProbe.status === 404) {
    log('INFO', `Site '${CENTRAL_SITE}' not found; creating it under ${TENANT_ROOT}.`);
    const digest = await getDigest();
    // Webs/Add is the one TENANT-ROOT call (site creation cannot target a
    // web that does not exist yet), so it is a full URL, not centralApi().
    const create = await fetchWithRetry(`${TENANT_ROOT}/_api/web/Webs/Add`, {
      method: 'POST',
      headers: spHeaders(digest),
      body: JSON.stringify({
        __metadata: { type: 'SP.WebInfoCreationInformation' },
        Url: CENTRAL_SITE,
        Title: CENTRAL_SITE,
        Description: CENTRAL_MARKER,
        WebTemplate: 'SITEPAGEPUBLISHING#0',
        Language: 1033,
        UseUniquePermissions: false,
      }),
    });
    if (!create.ok && create.status !== 409) {
      const text = await create.text();
      log('ERROR', `Could not create site '${CENTRAL_SITE}': HTTP ${create.status} `
        + `${spError(text) || text.slice(0, 160)}. Creating a site needs tenant rights; `
        + `ask a SharePoint administrator, or create the site by hand and paste again.`);
      summary.errors.push({ step: 'site-create', error: `HTTP ${create.status}` });
      console.log(summary);
      return;
    }
    if (create.ok) {
      summary.created.push(`site ${CENTRAL_SITE}`);
      log('INFO', `Site '${CENTRAL_SITE}' created.`);
    } else {
      summary.adopted.push(`site ${CENTRAL_SITE}`);
      log('INFO', `Site '${CENTRAL_SITE}' appeared while this script was running; adopting it.`);
    }
    centralWebOk = true;
  } else {
    const text = await siteProbe.text();
    log('ERROR', `Site probe for '${CENTRAL_SITE}': HTTP ${siteProbe.status} ${spError(text) || text.slice(0, 160)}. Nothing was changed.`);
    summary.errors.push({ step: 'site-probe', error: `HTTP ${siteProbe.status}` });
    console.log(summary);
    return;
  }

  // --- 2. The list -------------------------------------------------------
  // Existence via the LISTS ENUMERATION (same no-red-404 rule as the
  // deployer's own shape probes), ownership by Description compared WHOLE.
  const listsResp = await fetchWithRetry(centralApi('lists?$select=Title,Description&$top=5000'), {
    headers: { 'Accept': 'application/json;odata=verbose' },
  });
  if (!listsResp.ok) {
    const text = await listsResp.text();
    log('ERROR', `Could not read the lists on '${CENTRAL_SITE}': HTTP ${listsResp.status} ${spError(text) || text.slice(0, 160)}. The site exists but this account cannot read it; nothing was changed.`);
    summary.errors.push({ step: 'lists-enumerate', error: `HTTP ${listsResp.status}` });
    console.log(summary);
    return;
  }
  const wanted = CENTRAL_LIST.toLowerCase();
  const found = (((await listsResp.json()).d || {}).results || [])
    .find((l) => String(l.Title || '').toLowerCase() === wanted) || null;
  if (found) {
    if (String(found.Description || '') !== CENTRAL_MARKER) {
      log('ERROR', `A list titled '${CENTRAL_LIST}' already exists on '${CENTRAL_SITE}' and its Description is not this tool's marker. It is not touched; rename one of the two, or clear the Description only if you own that list.`);
      summary.errors.push({ step: 'list-ownership', error: 'foreign list' });
      console.log(summary);
      return;
    }
    log('INFO', `List '${CENTRAL_LIST}' already exists and carries this tool's marker; nothing to do.`);
    summary.adopted.push(`list ${CENTRAL_LIST}`);
  } else {
    const createdList = await crossWebPost(CENTRAL_SITE, 'lists', {
      __metadata: { type: 'SP.List' },
      Title: CENTRAL_LIST,
      BaseTemplate: 100,
      Description: CENTRAL_MARKER,
      Hidden: true,
    });
    if (!createdList.ok && createdList.status !== 409) {
      const text = await createdList.text();
      log('ERROR', `Could not create list '${CENTRAL_LIST}': HTTP ${createdList.status} ${spError(text) || text.slice(0, 160)}. The site exists; creating the list needs Site Owner on it.`);
      summary.errors.push({ step: 'list-create', error: `HTTP ${createdList.status}` });
      console.log(summary);
      return;
    }
    if (createdList.ok) {
      summary.created.push(`list ${CENTRAL_LIST}`);
      log('INFO', `List '${CENTRAL_LIST}' created (hidden).`);
    } else {
      summary.adopted.push(`list ${CENTRAL_LIST}`);
      log('INFO', `List '${CENTRAL_LIST}' appeared while this script was running; adopting it.`);
    }
  }

  // --- 3. Read back, then stamp ------------------------------------------
  // A create this script did not confirm by reading it back is not a fact.
  const check = await fetchWithRetry(
    centralApi(`lists/getbytitle('${odataName(CENTRAL_LIST)}')?$select=Id,Title,Hidden`),
    { headers: { 'Accept': 'application/json;odata=verbose' } },
  );
  if (!check.ok) {
    const text = await check.text();
    log('ERROR', `Read-back for '${CENTRAL_LIST}' failed: HTTP ${check.status} ${spError(text) || text.slice(0, 160)}.`);
    summary.errors.push({ step: 'read-back', error: `HTTP ${check.status}` });
    console.log(summary);
    return;
  }
  const shape = (await check.json()).d;
  if (!shape || !shape.Id) {
    log('ERROR', `Read-back for '${CENTRAL_LIST}' returned no list; the create did not take.`);
    summary.errors.push({ step: 'read-back', error: 'no list' });
    console.log(summary);
    return;
  }

  // The stamp needs the list's real entity type: SharePoint mangles
  // non-alphanumeric characters in 'SP.Data.<Title>ListItem' (the live
  // list's type is SP.Data.DbmldeploymentlogListItem, no underscores), so
  // a derived literal is wrong exactly when the title is interesting.
  // Same lesson the seeds phase learnt; same resolution one GET earlier.
  const typeResp = await fetchWithRetry(
    centralApi(`lists/getbytitle('${odataName(CENTRAL_LIST)}')?$select=ListItemEntityTypeFullName`),
    { headers: { 'Accept': 'application/json;odata=verbose' } },
  );
  if (!typeResp.ok) {
    log('WARN', `Could not resolve the list's entity type (HTTP ${typeResp.status}); the provenance row needs it, so it was skipped. The list itself is ready.`);
  } else {
    const entityType = (await typeResp.json()).d.ListItemEntityTypeFullName;
    const stamp = await crossWebPost(
      CENTRAL_SITE,
      `lists/getbytitle('${odataName(CENTRAL_LIST)}')/items`,
      {
        // WEB is the strict guard's variable; this script is cross-web and
        // deliberately does not define it. The pasted page's own path names
        // where the provisioning happened, which is the audit fact wanted.
        __metadata: { type: entityType },
        Title: `dbml-sharepoint provenance: central log provisioned by deployer v${DEPLOYER_VERSION} `
          + `at ${GENERATED_AT} from ${window.location.pathname}`.slice(0, 255),
      },
    );
    if (!stamp.ok && stamp.status !== 409) {
      const text = await stamp.text();
      log('WARN', `Central log is ready, but the provenance row was refused: HTTP ${stamp.status} `
        + `${spError(text) || text.slice(0, 160)}. This account holds no AddListItems on the list; `
        + `delegating rows will be refused until it is granted Contribute.`);
    } else {
      log('INFO', `Provenance row stamped into '${CENTRAL_LIST}'.`);
    }
  }

  log('DONE', `Central log ready: site '${CENTRAL_SITE}', list '${CENTRAL_LIST}'. Every firmfooting `
    + `deploy that can reach it will now stamp its start, stop and provenance rows here.`);
  console.log(summary);
  return summary;
})();
