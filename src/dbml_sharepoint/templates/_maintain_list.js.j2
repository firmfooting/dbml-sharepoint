{# Shared list resolution for the two maintenance scripts (protection.js,
   columns.js). Expects log, LIST_PATH, LIST_SLUG, summary, apiUrl,
   odataName, fetchWithRetry, spError, spHeaders and getDigest to be
   defined. Emits the ManageLists preflight, the by-URL list read that names
   what does exist on a miss, the guid-addressed list and field paths, the
   custom column filter, and the MERGE helpers every write goes through.

   RESOLVED BY URL, NOT BY TITLE; `_get_list_by_path.js.j2` carries the
   reason. LIST_TITLE is read back from the list here, so every message below
   names what the list is called now rather than what its folder is called. #}
  const verbose = () => ({ headers: { 'Accept': 'application/json;odata=verbose' } });

{% include "_get_list_by_path.js.j2" %}

  // One entity read. Throws with SharePoint's own reason rather than a bare status.
  async function getOne(suffix, what) {
    const r = await fetchWithRetry(apiUrl(suffix), verbose());
    if (!r.ok) throw new Error(`${what}: HTTP ${r.status} ${spError(await r.text())}`);
    const j = await r.json();
    return (j && j.d) || {};
  }

  // A whole collection, following OData's __next, the same shape extract.js
  // and rollback.js enumerate with.
  async function getAll(suffix, what) {
    const rows = [];
    let nextUrl = apiUrl(suffix);
    let pages = 0;
    while (nextUrl) {
      if (++pages > 100) throw new Error(`${what}: exceeded 100 pages; aborting`);
      const r = await fetchWithRetry(nextUrl, verbose());
      if (!r.ok) throw new Error(`${what}: HTTP ${r.status} ${spError(await r.text())}`);
      const j = await r.json();
      for (const row of ((j && j.d && j.d.results) || [])) rows.push(row);
      nextUrl = (j && j.d && typeof j.d.__next === 'string') ? j.d.__next : null;
    }
    return rows;
  }

  // === Preflight: ManageLists (Low bit 0x800) ===
  {
    const permsResp = await fetchWithRetry(apiUrl('web?$select=EffectiveBasePermissions'), verbose());
    const permsJson = await permsResp.json();
    const haveLow = Number(permsJson?.d?.EffectiveBasePermissions?.Low || 0);
    if ((haveLow & 0x800) !== 0x800) {
      log('ERROR', 'Current user lacks ManageLists on this site.');
      return { ...summary, aborted: 'insufficient-permissions' };
    }
  }

{% include "_guid.js.j2" %}

  // The list, by the server-relative URL the operator pasted. A GET on an
  // absent path answers 404, which the console paints red, so the failure
  // names the lists that do exist instead of leaving a red line to decode.
  let list;
  {
    const r = await fetchWithRetry(
      listByPathUrl(LIST_PATH, '&$select=Id,Title,Description,AllowDeletion,ItemCount'),
      verbose(),
    );
    if (r.status === 404) {
      const titles = (await getAll('web/lists?$select=Title,Hidden&$top=5000', 'list enumeration'))
        .filter((l) => !l.Hidden).map((l) => l.Title).sort();
      log('ERROR', `No list at '${LIST_PATH}' on this web. Lists here: ${titles.join(', ') || '(none)'}.`);
      return { ...summary, aborted: 'list-not-found' };
    }
    if (!r.ok) throw new Error(`list at '${LIST_PATH}': HTTP ${r.status} ${spError(await r.text())}`);
    list = ((await r.json()) || {}).d || {};
  }
  // What the list is CALLED, read back rather than guessed from the folder.
  // These differ on any renamed list, and the operator needs to see the name
  // before confirming a destructive write against it.
  const LIST_TITLE = String(list.Title || LIST_SLUG);
  if (LIST_TITLE !== LIST_SLUG) {
    log('INFO', `'${LIST_PATH}' is the list titled '${LIST_TITLE}'; its URL keeps the slug it was created with.`);
  }
  const LIST_ID = sharePointGuid(list.Id, 'list');
  const listPath = `web/lists(guid'${LIST_ID}')`;
  const fieldPath = (fieldId) => `${listPath}/fields(guid'${sharePointGuid(fieldId, 'field')}')`;
  // The one place a field URL is built as a literal, so the endpoint
  // inventory in test_template_lint.py sees the family it belongs to.
  const fieldUrl = (fieldId, query = '') => apiUrl(`web/lists(guid'${LIST_ID}')/fields(guid'${sharePointGuid(fieldId, 'field')}')${query}`);
  // Reported, never gated on: the operator named this list by URL, and the
  // typed confirmation is what makes each write deliberate.
  const provisioned = String(list.Description || '').indexOf({{ marker_prefix | tojson }}) !== -1;
  log(provisioned ? 'INFO' : 'WARN',
    `'${LIST_TITLE}' ${provisioned ? 'carries' : 'does NOT carry'} a dbml-sharepoint provenance marker.`);

  // Every property here is documented on the remote Field entity, and the
  // deployer and the probes already read the first six live.
  const FIELD_SELECT = 'Id,InternalName,Title,TypeAsString,Hidden,ReadOnlyField,Sealed,FromBaseType,CanBeDeleted';
  const readFields = () => getAll(`${listPath}/fields?$select=${FIELD_SELECT}`, `fields of '${LIST_TITLE}'`);
  // Custom means a column somebody added: not hidden, not inherited from
  // the base type, and not one SharePoint itself refuses to delete.
  //
  // A SEAL IS NOT THAT REFUSAL. Sealing a column is what makes SharePoint
  // report CanBeDeleted:false -- MEASURED 2026-09-03 on a live list, where all
  // 11 sealed columns read false and all 3 unsealed ones read true. This tool
  // sealed those columns and can unseal them, so filtering on CanBeDeleted
  // alone hid every column these scripts exist to act on: the delete path
  // unseals and reads back before deleting, and the protection script's
  // unseal verb had no targets at all. A column refusing deletion while
  // UNSEALED is refusing for SharePoint's own reasons, and still does not
  // belong on the menu.
  const isCustom = (f) => !f.Hidden && !f.FromBaseType
    && (f.CanBeDeleted !== false || f.Sealed === true);

  const mismatch = (message) => {
    const err = new Error(message);
    err.readbackMismatch = true;
    return err;
  };

  async function merge(suffix, body, what) {
    const digest = await getDigest();
    const r = await fetchWithRetry(apiUrl(suffix), {
      method: 'POST',
      headers: spHeaders(digest, { 'IF-MATCH': '*', 'X-HTTP-Method': 'MERGE' }),
      body: JSON.stringify(body),
    });
    if (!r.ok) throw new Error(`${what}: MERGE failed, HTTP ${r.status} ${spError(await r.text())}`);
  }

  // Sealed columns accept a write, report success and discard it (probe
  // transcript, form-visibility-evidence-probe.js), so the readback is the
  // only thing that counts.
  async function setSealed(field, want) {
    await merge(fieldPath(field.Id), { __metadata: { type: 'SP.Field' }, Sealed: want }, `'${field.InternalName}'`);
    const back = await getOne(`${fieldPath(field.Id)}?$select=Id,Sealed`, `'${field.InternalName}' readback`);
    if (back.Sealed !== want) {
      throw mismatch(`'${field.InternalName}' reads back Sealed=${back.Sealed} after writing ${want}; the write was discarded`);
    }
  }
