{# src/dbml_sharepoint/templates/deploy/_reader_enrolment.js.j2
   Phase body: enrol the ONE account named by `build --enterprise-reader`
   into the mapping's `enroll_enterprise_reader` group, which holds Read.
   Emitted only when that flag was given, so an ordinary build carries no
   enrolment code at all. Unlike the operator's run-scoped enrolment, this
   membership is PERMANENT — nothing removes it at the end of the run.
   Every resolution is refused unless it is a single user (PrincipalType
   strictly 1), is not one of SharePoint's tenant-wide claims, and matches
   the address the build asked for; the membership is then read back before
   the run is allowed to call it done. #}
{% if enterprise_reader %}
  // === Enterprise reader enrolment (--enterprise-reader) ===
  // Grants one named service account read-only access to the registers
  // this bundle provisions, by adding it to the group the mapping flagged
  // with `enroll_enterprise_reader` — a group the validator requires to
  // hold Read and nothing more. The group's grants are unchanged here;
  // this phase only decides WHO is in it.
  //
  // THIS MEMBERSHIP IS PERMANENT. Operator self-enrolment (the phase
  // before this one) removes itself on the way out because it exists to
  // let this run write. A reporting account exists between runs, so
  // nothing removes it — remove it by hand in Site permissions > Groups.
  //
  // Everything below is a guard against granting Read to the wrong
  // principal, which is the failure this phase can cause and cannot show:
  // the deploy reads back byte-identical whether the member is one service
  // account or the entire tenant. `ensureuser` will happily resolve a
  // security group, a distribution list, or an everyone-claim, so each is
  // refused explicitly and the run aborts before any list is created.
{% if phase.first_in_group %}
  log('INFO', 'Group {{ phase.group_number }} — {{ phase.group_name }}');
{% endif %}
  log('INFO', 'Starting Phase {{ phase.number }}: {{ phase.name }}.');
  {
    const READER_ADDRESS = {{ enterprise_reader | tojson }};
    // The build refuses --enterprise-reader against a mapping that declares
    // no flagged group, and the validator refuses more than one, so on any
    // bundle this tool produced the list holds exactly one group. Written
    // as a loop anyway: a hand-edited bundle then reports per group instead
    // of silently enrolling into whichever one happened to come first.
    const readerGroups = SCHEMA.groups.filter(g => g.enroll_enterprise_reader);
    for (const grp of readerGroups) {
      try {
        // 1. Resolve the address. EnsureUser is a write (it materialises
        // the principal in the site's user information list), hence the
        // digest, and it is the only documented way to turn a UPN into the
        // claims LoginName a group membership needs.
        const digestR = await getDigest();
        const resolveResp = await fetchWithRetry(apiUrl('web/ensureuser?$select=Id,LoginName,Title,Email,PrincipalType'), {
          method: 'POST',
          headers: spHeaders(digestR),
          body: JSON.stringify({ logonName: READER_ADDRESS }),
        });
        if (!resolveResp.ok) {
          const text = await resolveResp.text();
          throw new Error(`could not resolve '${READER_ADDRESS}': HTTP ${resolveResp.status} ${text}`);
        }
        const resolved = (await resolveResp.json()).d;
        if (!resolved || !Number.isInteger(resolved.Id)
            || typeof resolved.LoginName !== 'string' || resolved.LoginName === '') {
          throw new Error(`resolving '${READER_ADDRESS}' returned an invalid principal response`);
        }

        // 2. Principal type, STRICT equality. Microsoft Learn documents
        // SP.PrincipalType as None 0, User 1, DistributionList 2,
        // SecurityGroup 4, SharePointGroup 8, All 15 — and marks it
        // [Flags]. A bitwise `& 1` would therefore admit any combination
        // that happens to carry the User bit, so the comparison is `!== 1`
        // and stays that way.
        if (resolved.PrincipalType !== 1) {
          throw new Error(
            `'${READER_ADDRESS}' resolved to '${resolved.Title || resolved.LoginName}' with PrincipalType `
            + `${resolved.PrincipalType}, which is not a single user (1). Enrolling a group would grant Read `
            + `to every one of its members. Nothing was changed; name an individual account.`,
          );
        }

        // 3. The tenant-wide claims. They resolve as ordinary users, so the
        // type check above does not catch them, and granting one hands Read
        // on this register to every account in the tenant — the one mistake
        // in this phase with no cheap undo.
        const login = resolved.LoginName.toLowerCase();
        const claim = ['spo-grid-all-users', 'c:0(.s|true', 'c:0-.f|rolemanager']
          .find(c => login.includes(c));
        if (claim) {
          throw new Error(
            `'${READER_ADDRESS}' resolved to '${resolved.LoginName}', which is a tenant-wide claim `
            + `(matched '${claim}') and would grant Read to every user in the tenant. Nothing was changed.`,
          );
        }

        // 4. Identity. EnsureUser answering with SOMEBODY ELSE is the quiet
        // failure here: the deploy reports success and the wrong account
        // holds Read. Two addresses are compared, and either may match: the
        // mailbox Email, and the UPN the claims LoginName ends in. They are
        // routinely different for the same account (an alias mailbox), so
        // requiring the Email alone would refuse correct resolutions — while
        // a resolution of a DIFFERENT account matches neither.
        const upnPart = (name) => {
          const parts = String(name).split('|');
          return parts[parts.length - 1];
        };
        const candidates = [resolved.Email, upnPart(resolved.LoginName)]
          .map(v => String(v == null ? '' : v).toLowerCase())
          .filter(v => v !== '');
        if (!candidates.includes(READER_ADDRESS.toLowerCase())) {
          throw new Error(
            `'${READER_ADDRESS}' resolved to a different account: '${resolved.Title || resolved.LoginName}' `
            + `(${candidates.join(', ') || 'no address'}). Nothing was changed.`,
          );
        }

        // 5. The target group, created and reconciled by Phase
        // {{ phase.group_number }}.2 earlier in this same run.
        const grpResp = await fetchWithRetry(apiUrl(`web/sitegroups/getbyname('${odataName(grp.name)}')?$select=Id`), {
          headers: { 'Accept': 'application/json;odata=verbose' },
        });
        if (!grpResp.ok) {
          throw new Error(`group probe for '${grp.name}' failed: HTTP ${grpResp.status}`);
        }
        const groupId = (await grpResp.json()).d.Id;
        if (!Number.isInteger(groupId)) {
          throw new Error(`group probe for '${grp.name}' returned an invalid response`);
        }

        // 6. Membership, enumerated in full: the phase reports who else is
        // in the group, and the same read verifies the write below.
        const readMembers = async () => {
          const found = [];
          let membersUrl = apiUrl(`web/sitegroups(${groupId})/users?$select=Id,LoginName,Title&$top=5000`);
          while (membersUrl) {
            const membersResp = await fetchWithRetry(membersUrl, {
              headers: { 'Accept': 'application/json;odata=verbose' },
            });
            if (!membersResp.ok) {
              const text = await membersResp.text();
              throw new Error(`membership probe for '${grp.name}' failed: HTTP ${membersResp.status} ${text}`);
            }
            const membersJson = await membersResp.json();
            if (!membersJson.d || !Array.isArray(membersJson.d.results)) {
              throw new Error(`membership probe for '${grp.name}' returned an invalid response`);
            }
            found.push(...membersJson.d.results);
            membersUrl = membersJson.d.__next || null;
          }
          return found;
        };
        // nameKey: claims logins are resolved case-insensitively, so a
        // member stored as I:0#.F|... must not read as a different account.
        const isReader = (u) => nameKey(u && u.LoginName) === nameKey(resolved.LoginName);
        const before = await readMembers();

        // 7. Anybody else in the group is REPORTED, never removed:
        // membership is an operator-owned concern and this phase owns one
        // account only.
        const others = before.filter(u => !isReader(u));
        if (others.length > 0) {
          log('INFO', `Group '${grp.name}' also contains ${others.length} other member(s), left untouched: ${others.map(u => u.Title || u.LoginName).join(', ')}.`);
        }
        if (before.some(isReader)) {
          log('INFO', `'${resolved.Title || READER_ADDRESS}' is already a member of '${grp.name}'; membership left untouched.`);
          continue;
        }

        const digestA = await getDigest();
        const addResp = await fetchWithRetry(apiUrl(`web/sitegroups(${groupId})/users`), {
          method: 'POST',
          headers: spHeaders(digestA),
          body: JSON.stringify({ __metadata: { type: 'SP.User' }, LoginName: resolved.LoginName }),
        });
        if (!addResp.ok) {
          const text = await addResp.text();
          throw new Error(`enrolment of '${READER_ADDRESS}' into '${grp.name}' failed: HTTP ${addResp.status} ${text}`);
        }

        // 8. Read the membership back. HTTP 200 is not evidence that the
        // account is in the group, and a grant reported but never made is
        // worse than a failure: the operator stops looking.
        const after = await readMembers();
        if (!after.some(isReader)) {
          throw new Error(`'${READER_ADDRESS}' was accepted into '${grp.name}' but is absent when the membership is read back; the grant did not take effect`);
        }
        log('INFO', `Enrolled '${resolved.Title || READER_ADDRESS}' into '${grp.name}' with the group's read-only grants. This membership is PERMANENT: remove it in Site permissions > Groups when the account no longer needs access.`);
      } catch (err) {
        log('ERROR', `Enterprise reader enrolment for '${grp.name}': ${err.message}`);
        summary.errors.push({ phase: '{{ phase.number }}', group: grp.name, error: err.message });
      }
    }
  }
  if (summary.errors.length > 0) {
    log('ERROR', 'Enterprise reader enrolment failed; aborting before list creation.');
    return { ...summary, aborted: 'reader-enrolment-errors' };
  }
{% endif %}
