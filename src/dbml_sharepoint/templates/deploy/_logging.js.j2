{# src/dbml_sharepoint/templates/deploy/_logging.js.j2
   Phase body: ensure the tool's sidecar lists, stamp the run log, probe the
   external deployment log, and declare the change-log writer every later
   phase calls.

   THREE lists, three different contracts:

   - `dbml Local Log` is created on EVERY deploy, hidden, and left with no
     role assignments, so an ordinary member sees nothing and a paste
     returns to a site that shows no trace of it. It records this run:
     start stamp, stop stamp, and what the run did. Title carries the
     readable line and the stamp columns carry the same facts queryably.
     A log the marker matches is REUSED, and the ones already on live
     sites were created before those columns existed, so the phase
     creates the ones it finds missing and falls back to a Title-only
     stamp when it cannot.
   - The change log (default `dbml_Logs`) is created on every deploy,
     hidden, and holds one Read assignment for the site group flagged
     `enroll_enterprise_reader`, so a Power Automate reader can list and
     read rows without seeing the registers themselves. It receives
     type-2 rows: every change carries its key in ChangeKey, plus
     EffectiveFrom/EffectiveTo and IsCurrent, and a change CLOSES the
     previous current row for its key in the same logical step, so a
     reader always sees exactly one current row per key. ChangeKey and
     IsCurrent are indexed because the close reads them both in one
     $filter, and both sides of an AND have to be indexed to survive the
     5,000-item threshold on a log that grows forever.
   - The EXTERNAL deployment log (probe `dbml-deployment-log`) is NEVER
     created. An operator with a site-wide deployment log names it (flag
     or DBMLSP_DEPLOY_LOG_LIST) and this phase writes deployment
     start, deployment stop and provenance rows into it. One field read
     decides the row shape: a list carrying every column the
     `deployment-log` family declares gets the full stamp, and anything
     else gets Title alone, which is the one column every generic list
     has. Absent, this phase says so once and moves on.

   The two created lists carry the tool's provenance marker in their
   Description. A list of the same title whose Description is not EXACTLY
   the marker is somebody else's and this phase ABORTS the run, the same
   fail-closed contract as verify.js's scratch list. Creation is
   idempotent; a rollback never deletes these lists because rollback only
   deletes declared TARGET_LISTS.

   Change events raised BEFORE this phase (renames, phase 1.3) were
   buffered by deploy.js.j2's shim. If the run aborts before reaching
   this phase they are lost, and so is everything else about that run:
   with no sidecar lists there is no record at all, which is the state
   every deploy before this phase existed in. From this phase onward the
   writer is live and events are written as they happen.
#}
{% if sidecar_run_log_title %}
{% if phase.first_in_group %}
  log('INFO', 'Group {{ phase.group_number }}: {{ phase.group_name }}');
{% endif %}
  log('INFO', 'Starting Phase {{ phase.number }}: {{ phase.name }}.');

  {
    // ---- Constants, rendered from the single authority -----------------
    const RUN_LOG_TITLE = {{ sidecar_run_log_title | tojson }};
    const RUN_LOG_MARKER = {{ sidecar_run_log_marker | tojson }};
    const CHANGE_LOG_TITLE = {{ sidecar_change_log_title | tojson }};
    const CHANGE_LOG_MARKER = {{ sidecar_change_log_marker | tojson }};
    // Empty string: no external log was named, so no probing either.
    const EXTERNAL_LOG_TITLE = {{ deployment_log_list | tojson }};
    const EXTERNAL_LOG_SITE = {{ deployment_log_site | tojson }};
    // The columns the `deployment-log` family declares on that list. All
    // present: the stamp is written in full. Any missing: Title only.
    const EXTERNAL_LOG_COLUMNS = {{ deployment_log_columns | tojson }};
    const EXTERNAL_ROW_PREFIX = {{ deployment_log_row_prefix | tojson }};
    const CHANGE_FIELDS = {{ sidecar_change_fields | tojson(indent=2) }};
    const RUN_LOG_FIELDS = {{ sidecar_run_log_fields | tojson(indent=2) }};
    // Resolved once. The site guard has already refused a page with no
    // _spPageContextInfo, so this cannot be reached without one.
    const OPERATOR_LOGIN = (_spPageContextInfo && _spPageContextInfo.userLoginName) || '(unknown)';

    // ---- Failure recording ---------------------------------------------
    // The registers this deploy maintains must never depend on the logs
    // that document them, so every logging failure is recorded on
    // summary.loggingFailures -- NOT on summary.errors, which is the abort
    // bus phases 2.1, 2.2, 3.x and 4.x each gate on. A change row that
    // would not write used to halt the whole deploy from here, which is the
    // opposite of what this phase promises.
    //
    // The two sidecar OWNERSHIP guards below are the exceptions and they
    // stay on summary.errors: a list of the tool's title that is not the
    // tool's is a documented halt, the same fail-closed contract as
    // verify.js's scratch list.
    const recordFailure = (where, err) => {
      summary.loggingFailures.push({
        phase: '{{ phase.number }}', where,
        error: err && err.message ? err.message : String(err),
      });
    };

    // ---- Sidecar creation, marker-guarded ------------------------------
    // Same contract as verify.js's scratch list: exact-Description
    // ownership or abort. Returns the list Id.
    const ensureSidecar = async (title, marker) => {
      let shape = null;
      try {
        shape = await readListShape(title);
      } catch (err) {
        throw new Error(`sidecar '${title}' probe failed: ${err.message}`);
      }
      if (shape) {
        if (shape.Description !== marker) {
          throw new Error(
            `A list titled '${title}' exists and its Description is not this `
            + `tool's marker. It is not touched; rename or remove it and paste again.`,
          );
        }
        log('INFO', `Sidecar '${title}' exists (marker matched); reusing it.`);
        return shape.Id;
      }
      const digestS = await getDigest();
      const created = await postJson(apiUrl('web/lists'), {
        __metadata: { type: 'SP.List' },
        Title: title,
        BaseTemplate: 100,
        Description: marker,
        Hidden: true,
        ContentTypesEnabled: false,
        EnableVersioning: false,
      }, digestS);
      if (!created.d || typeof created.d.Id !== 'string') {
        throw new Error(`Sidecar '${title}' create returned an invalid response`);
      }
      invalidateListShapes();
      log('INFO', `Created hidden sidecar list '${title}'.`);
      return created.d.Id;
    };

    let runLogId = null;
    try {
      runLogId = await ensureSidecar(RUN_LOG_TITLE, RUN_LOG_MARKER);
    } catch (err) {
      throw err;  // foreign run log: fatal, nothing about this run gets recorded
    }
    let changeLogId = null;
    let changeLogFatal = null;
    try {
      changeLogId = await ensureSidecar(CHANGE_LOG_TITLE, CHANGE_LOG_MARKER);
    } catch (err) {
      // The second ownership guard, and the second documented halt: a list
      // titled `dbml_Logs` whose Description is not this tool's marker
      // belongs to somebody else, and writing a change feed into it is the
      // one thing this phase must never do. On summary.errors deliberately
      // -- unlike every other failure here, this one stops the run at the
      // next phase gate rather than degrading to a warning.
      log('ERROR', `Phase {{ phase.number }}: ${err.message}`);
      summary.errors.push({
        phase: '{{ phase.number }}', where: `ensuring '${CHANGE_LOG_TITLE}'`,
        error: err && err.message ? err.message : String(err),
      });
      changeLogFatal = err;
    }

    // ---- Column ensure, shared by both sidecars -------------------------
    // Probe, create what is missing, read back, and return the read-back
    // field map. BOTH logs go through it, because both are reused whenever
    // their marker matches and neither can assume the columns of whichever
    // version of this phase created it. A run log created by the bare-Title
    // version carried none of the stamp columns, and the stamp that named
    // one was refused with HTTP 400 "The property 'StampKind' does not
    // exist on type 'SP.Data.Dbml_x0020_Local_x0020_LogListItem'" (live
    // 2026-09-05).
    //
    // `$top=500` for the same reason _verify_body.js.j2:141 carries it: a
    // /fields read with no explicit page size is a read whose page size is
    // the server's, and a truncated field map reads exactly like a list
    // that is missing columns.
    const ensureFields = async (title, fields) => {
      const readPresent = async () => {
        const resp = await fetchWithRetry(apiUrl(
          `web/lists/getbytitle('${odataName(title)}')/fields`
          + `?$select=Id,InternalName,Indexed&$top=500`
          + `&$filter=Hidden eq false and ReadOnlyField eq false`
        ), { headers: { 'Accept': 'application/json;odata=verbose' } });
        if (!resp.ok) {
          throw new Error(`HTTP ${resp.status} ${await resp.text()}`);
        }
        return new Map((((await resp.json()).d || {}).results || [])
          .map((f) => [f.InternalName, f]));
      };
      const present = await readPresent();
      for (const fieldBody of fields) {
        if (present.has(fieldBody.Title)) continue;
        const digestF = await getDigest();
        // Field creates need BOTH the verbose transport (spHeaders) and the
        // __metadata type: without the type the verbose parser refuses the
        // entry ("An entry without a type name was found", live 2026-09-05
        // on a dbml_Logs create), and the subtype name SP.FieldText /
        // SP.FieldDateTime is exactly what it wants. An earlier comment
        // here claimed the opposite from a misread probe; the live matrix
        // (measured twice now) is unambiguous.
        // `Indexed` comes out for a different reason: it is part of the
        // DECLARATION, asserted by the MERGE _indexes.js.j2 uses, because
        // whether a create body honours it has never been measured here and
        // a reused log would never see it either way.
        const createBody = { ...fieldBody };
        delete createBody.Indexed;
        const addResp = await fetchWithRetry(apiUrl(
          `web/lists/getbytitle('${odataName(title)}')/fields`
        ), {
          method: 'POST', headers: spHeaders(digestF),
          body: JSON.stringify(createBody),
        });
        if (!addResp.ok) {
          throw new Error(`field '${fieldBody.Title}': HTTP ${addResp.status} ${await addResp.text()}`);
        }
      }
      const back = await readPresent();
      for (const fieldBody of fields) {
        if (!back.has(fieldBody.Title)) {
          throw new Error(`field '${fieldBody.Title}' was accepted but is absent on read-back`);
        }
      }
      return back;
    };

    // The list's own ListItemEntityTypeFullName. Read from the list rather
    // than derived from its title: an item POST without a type name is
    // refused ("An entry without a type name was found", live 2026-09-05),
    // and the derived spelling is not always the real one.
    const listEntityType = async (title) => {
      const resp = await fetchWithRetry(apiUrl(
        `web/lists/getbytitle('${odataName(title)}')?$select=ListItemEntityTypeFullName`
      ), { headers: { 'Accept': 'application/json;odata=verbose' } });
      if (!resp.ok) {
        throw new Error(`entity-type probe: HTTP ${resp.status} ${await resp.text()}`);
      }
      const name = ((await resp.json()).d || {}).ListItemEntityTypeFullName;
      if (typeof name !== 'string' || !name) {
        throw new Error('ListItemEntityTypeFullName probe returned no value');
      }
      return name;
    };

    // ---- Change log columns --------------------------------------------
    // Every column write is read back before the first event.
    let changeLogReady = false;
    let entityTypeFullName = null;
    if (changeLogId) {
      try {
        const back = await ensureFields(CHANGE_LOG_TITLE, CHANGE_FIELDS);
        // The declared indexes, asserted after the read-back. Recorded and
        // carried past rather than thrown: an unindexed key column costs
        // the type-2 close its 5,000-item headroom, which is a problem for
        // a log that has grown, not a reason to refuse to write to one.
        for (const fieldBody of CHANGE_FIELDS) {
          if (!fieldBody.Indexed) continue;
          const shape = back.get(fieldBody.Title);
          if (shape.Indexed === true) continue;
          try {
            await patchFieldById(changeLogId, shape.Id, {
              __metadata: { type: 'SP.Field' }, Indexed: true,
            }, await getDigest());
          } catch (err) {
            recordFailure(`index on '${CHANGE_LOG_TITLE}'.${fieldBody.Title}`, err);
          }
        }
        entityTypeFullName = await listEntityType(CHANGE_LOG_TITLE);
        changeLogReady = true;
      } catch (err) {
        recordFailure(`columns on '${CHANGE_LOG_TITLE}'`, err);
      }
    }

    // ---- Run log stamp columns ------------------------------------------
    // Decided ONCE, here, and read by every later stamp: a stamp that
    // re-probed would pay a field read per row and could still disagree
    // with itself between the start stamp and the stop stamp. False means
    // the columns are neither present nor creatable, and stampRunLog
    // degrades to Title alone rather than losing the stamp entirely, the
    // same philosophy the central log's stamp already follows.
    let runLogStructured = false;
    if (runLogId) {
      try {
        await ensureFields(RUN_LOG_TITLE, RUN_LOG_FIELDS);
        runLogStructured = true;
      } catch (err) {
        // On loggingFailures, not on the abort bus: a run log that can only
        // hold a Title still records that the run happened, which is the
        // whole reason the list exists.
        recordFailure(`stamp columns on '${RUN_LOG_TITLE}'`, err);
        log('WARN', `Run log '${RUN_LOG_TITLE}' has no stamp columns and they could not be `
          + `created (${err.message}); this run's stamps carry Title only.`);
      }
    }

    // ---- The type-2 change writer --------------------------------------
    // One insert per event; a key that already has a current row gets that
    // row MERGEd closed (EffectiveTo, IsCurrent) in the same logical step.
    // The current-row decision is read from the server per event: at
    // deploy volumes one read is affordable and a run-local cache would
    // lie about rows an earlier run left behind.
    //
    // ONE argument, the change. This is the function published as
    // `logChange`, and every call site -- the buffering shim in
    // deploy.js.j2, and the phases that call it directly -- passes the
    // change object alone. It fetches its own digest, which getDigest()
    // caches, and it never REJECTS: _lists.js.j2 calls it without awaiting,
    // so a rejection here would surface as an unhandled rejection rather
    // than as a logging failure.
    const writeChange = async (change) => {
      if (!changeLogReady) return;
      try {
        await insertChange(change);
      } catch (err) {
        recordFailure(`change '${change && change.key}'`, err);
      }
    };
    const insertChange = async (change) => {
      const effectiveFrom = change.at || new Date().toISOString();
      const currentResp = await fetchWithRetry(apiUrl(
        `web/lists/getbytitle('${odataName(CHANGE_LOG_TITLE)}')/items`
        + `?$select=Id,IsCurrent&$filter=ChangeKey eq '${odataName(change.key)}' and IsCurrent eq true`
      ), { headers: { 'Accept': 'application/json;odata=verbose' } });
      const currentRows = currentResp.ok
        ? (((await currentResp.json()).d || {}).results || [])
        : [];
      if (!currentResp.ok) {
        recordFailure(`current-row read for '${change.key}'`,
          new Error(`HTTP ${currentResp.status} ${await currentResp.text()}`));
        return;
      }
      if (currentRows.length > 1) {
        recordFailure(`change key '${change.key}'`,
          new Error(`${currentRows.length} rows are marked current; a previous run died mid-close. Close all but one by hand before the next deploy with changes to this key.`));
        return;
      }
      // One digest for both writes, taken after the read that decides
      // whether there are two. getDigest() caches, so this costs nothing
      // per event beyond the first.
      const digest = await getDigest();
      if (currentRows.length === 1) {
        const closeResp = await fetchWithRetry(apiUrl(
          `web/lists/getbytitle('${odataName(CHANGE_LOG_TITLE)}')/items(${currentRows[0].Id})`
        ), {
          method: 'POST',
          headers: spHeaders(digest, { 'IF-MATCH': '*', 'X-HTTP-Method': 'MERGE' }),
          body: JSON.stringify({
            __metadata: { type: entityTypeFullName },
            EffectiveTo: effectiveFrom,
            IsCurrent: false,
          }),
        });
        if (!closeResp.ok) {
          recordFailure(`closing row ${currentRows[0].Id} for '${change.key}'`,
            new Error(`HTTP ${closeResp.status} ${await closeResp.text()}`));
          return;
        }
      }
      const insertResp = await fetchWithRetry(apiUrl(
        `web/lists/getbytitle('${odataName(CHANGE_LOG_TITLE)}')/items`
      ), {
        method: 'POST',
        headers: spHeaders(digest),
        body: JSON.stringify({
          __metadata: { type: entityTypeFullName },
          // Both, and the same value in each. ChangeKey is what the close
          // query above filters on and what the reader groups by; Title is
          // what the SharePoint UI shows in every default view, and a log
          // whose rows all read "Item" is unreadable in the browser.
          Title: change.key,
          ChangeKey: change.key,
          ChangeKind: change.kind,
          TargetName: change.target || '',
          OldValue: change.oldValue || '',
          NewValue: change.newValue || '',
          EffectiveFrom: effectiveFrom,
          EffectiveTo: null,
          IsCurrent: true,
          ReleaseTag: RELEASE_TAG,
        }),
      });
      if (!insertResp.ok) {
        recordFailure(`inserting '${change.key}'`,
          new Error(`HTTP ${insertResp.status} ${await insertResp.text()}`));
      }
    };

    // ---- The reader's Read grant on the change log ---------------------
    // The SAME level the reader group holds on the declared lists,
    // resolved by role definition Id read back from the site, never by
    // trusting the name at runtime. No reader configured: the change log
    // sits at zero assignments, like the run log.
{% if enterprise_reader %}
    {
      const readerGroup = SCHEMA.groups.find((g) => g.enroll_enterprise_reader);
      const readerGrant = readerGroup && SCHEMA.list_assignments
        .map((la) => la.assignments.find((a) => a.principal.kind === 'group'
                && a.principal.name === readerGroup.name))
        .find((a) => a);
      const levelName = readerGrant ? readerGrant.level : null;
      if (!readerGroup || !levelName) {
        log('INFO', 'Change log: no reader group grant found to mirror; leaving it with no role assignments.');
      } else {
        try {
          const breakResp = await fetchWithRetry(apiUrl(
            `web/lists/getbytitle('${odataName(CHANGE_LOG_TITLE)}')`
            + `/breakroleinheritance(copyRoleAssignments=false,clearSubscopes=false)`
          ), { method: 'POST', headers: spHeaders(await getDigest()) });
          if (!breakResp.ok) {
            throw new Error(`breakroleinheritance: HTTP ${breakResp.status} ${await breakResp.text()}`);
          }
          const roleResp = await fetchWithRetry(apiUrl(
            `web/roledefinitions/getbyname('${odataName(levelName)}')?$select=Id`
          ), { headers: { 'Accept': 'application/json;odata=verbose' } });
          if (!roleResp.ok) {
            throw new Error(`role definition '${levelName}': HTTP ${roleResp.status} ${await roleResp.text()}`);
          }
          const roleId = sharePointGuid(((await roleResp.json()).d || {}).Id, `role definition '${levelName}'`);
          const grpResp = await fetchWithRetry(apiUrl(
            `web/sitegroups/getbyname('${odataName(readerGroup.name)}')?$select=Id`
          ), { headers: { 'Accept': 'application/json;odata=verbose' } });
          if (!grpResp.ok) {
            throw new Error(`group '${readerGroup.name}': HTTP ${grpResp.status} ${await grpResp.text()}`);
          }
          const groupId = sharePointGuid(((await grpResp.json()).d || {}).Id, `group '${readerGroup.name}'`);
          const grantResp = await fetchWithRetry(apiUrl(
            `web/lists/getbytitle('${odataName(CHANGE_LOG_TITLE)}')`
            + `/roleassignments/addroleassignment(principalid=${groupId},roleDefId=${roleId})`
          ), { method: 'POST', headers: spHeaders(await getDigest()) });
          if (!grantResp.ok) {
            throw new Error(`addroleassignment: HTTP ${grantResp.status} ${await grantResp.text()}`);
          }
          log('INFO', `Change log '${CHANGE_LOG_TITLE}': granted '${readerGroup.name}' the '${levelName}' level for the enterprise reader.`);
          await writeChange({
            key: 'enterprise reader grant',
            kind: 'permission',
            target: CHANGE_LOG_TITLE,
            oldValue: '(no access)',
            newValue: `${levelName} for group '${readerGroup.name}'`,
          });
        } catch (err) {
          recordFailure(`reader grant on '${CHANGE_LOG_TITLE}'`, err);
        }
      }
    }
{% else %}
    log('INFO', `Change log '${CHANGE_LOG_TITLE}' holds no role assignments: no enterprise reader was configured.`);
{% endif %}

    // ---- The external deployment log (the CENTRAL logging site) --------
    // One site per org collects every firmfooting application's deployment
    // rows. Cross-site writes are same-origin REST: the tenant host is the
    // one this page is already on, so the session cookies ride along and
    // SharePoint answers a cross-web POST exactly like a local one.
    //
    // Three checks before the first stamp, in order, all degrade to INFO:
    //  - the SITE exists (web GET; 403 also means "exists but not to you");
    //  - the LIST exists on it (404-specific, getbytitle answers 404 for
    //    an absent list);
    //  - the operator holds AddListItems on that list -- Contribute or
    //    better -- read from the list's own EffectiveBasePermissions so a
    //    web-level Contribute cannot mask a list-scoped refusal. Bit
    //    0x2 = AddListItems; the low mask checked here is the same low
    //    half the operator-rights probe reads.
    // Absent site, absent list or no write bit: one INFO line each, and
    // the run carries on, because a deploy must not die because a shared
    // logging site is missing. Creating the site is the sidecar's job.
    const externalApi = (suffix) => crossWebApi(EXTERNAL_LOG_SITE, suffix);
{% include "_cross_web.js.j2" %}
    let externalReady = false;
    // Set once the field probe below finds every column the family
    // declares, and left false for a list that carries only Title.
    let externalStructured = false;
    // The CENTRAL list's own ListItemEntityTypeFullName, read from the list
    // rather than derived from its title, for the same reason the local
    // stamps read theirs.
    let externalEntityType = null;
    if (EXTERNAL_LOG_SITE) {
      let siteOk = false;
      try {
        const siteResp = await fetchWithRetry(externalApi('?$select=Url'), {
          headers: { 'Accept': 'application/json;odata=verbose' },
        });
        siteOk = siteResp.status === 200 || siteResp.status === 403;
      } catch (err) {
        log('INFO', `Central log site '${EXTERNAL_LOG_SITE}' unreachable (${err.message}); external stamps skipped.`);
      }
      if (!siteOk) {
        log('INFO', `Central log site '${EXTERNAL_LOG_SITE}' not found: create the site by hand `
          + `(SharePoint start page, Create site; this tool provisions lists, never sites) `
          + `and deploy the deployment-log family to it. Or set DBMLSP_DEPLOY_LOG_SITE / `
          + `DBMLSP_DEPLOY_LOG_LIST. The run log holds this run's record.`);
      } else {
        let listOk = false;
        let canAdd = false;
        try {
          const listResp = await fetchWithRetry(
            externalApi(`lists/getbytitle('${odataName(EXTERNAL_LOG_TITLE)}')`
              + `?$select=Id,ListItemEntityTypeFullName`),
            { headers: { 'Accept': 'application/json;odata=verbose' } },
          );
          if (listResp.status === 404) {
            listOk = false;
          } else if (listResp.ok) {
            listOk = true;
            externalEntityType = ((await listResp.json()).d || {}).ListItemEntityTypeFullName || null;
            const permResp = await fetchWithRetry(
              externalApi(`lists/getbytitle('${odataName(EXTERNAL_LOG_TITLE)}')/effectivebasepermissions`),
              { headers: { 'Accept': 'application/json;odata=verbose' } },
            );
            if (permResp.ok) {
              const low = Number((((await permResp.json()).d || {}).EffectiveBasePermissions || {}).Low || 0);
              canAdd = (low & 0x2) === 0x2;  // AddListItems
            }
          }
        } catch (err) {
          log('INFO', `Central log list '${EXTERNAL_LOG_TITLE}' probe failed (${err.message}); external stamps skipped.`);
        }
        if (!listOk) {
          log('INFO', `Central log site '${EXTERNAL_LOG_SITE}' exists but has no list '${EXTERNAL_LOG_TITLE}': `
            + `deploy the deployment-log family to that site to create it. The run log holds this run's record.`);
        } else if (!canAdd) {
          log('INFO', `Central log list '${EXTERNAL_LOG_TITLE}' found but this account holds no AddListItems on it: `
            + `ask its owner for Contribute. The run log holds this run's record.`);
        } else if (!externalEntityType) {
          log('INFO', `Central log list '${EXTERNAL_LOG_TITLE}' returned no ListItemEntityTypeFullName, so an `
            + `item POST cannot name its type; external stamps skipped. The run log holds this run's record.`);
        } else {
          externalReady = true;
          // One field read decides the shape of every stamp this run
          // writes. A list this tool provisioned carries them all; a list
          // the operator pointed at may carry none, and Title alone is
          // what a generic list can always accept.
          try {
            const fieldsResp = await fetchWithRetry(
              externalApi(`lists/getbytitle('${odataName(EXTERNAL_LOG_TITLE)}')/fields`
                + `?$select=InternalName&$top=500`),
              { headers: { 'Accept': 'application/json;odata=verbose' } },
            );
            if (fieldsResp.ok) {
              const present = new Set(((((await fieldsResp.json()).d || {}).results) || [])
                .map((f) => f.InternalName));
              externalStructured = EXTERNAL_LOG_COLUMNS.every((name) => present.has(name));
            }
          } catch (err) {
            recordFailure(`central log '${EXTERNAL_LOG_TITLE}' field probe`, err);
          }
          log('INFO', `Central log '${EXTERNAL_LOG_TITLE}' on '${EXTERNAL_LOG_SITE}' ready; stamping `
            + `deployment start and provenance `
            + `${externalStructured ? 'in full' : 'as Title only (the list carries no stamp columns)'}.`);
        }
      }
    }
    // A cross-web write needs a digest issued by the CENTRAL web: SharePoint
    // scopes digest validation to the issuing web (live finding 2026-09-05:
    // a digest from the deploy target's web POSTed to the logging site
    // answered 403 "security validation ... invalid"; the logging web's own
    // digest answered 201).
    //
    // `crossWebDigestUrl`, NOT `externalApi`. contextinfo sits at the API
    // ROOT, while `externalApi` builds every URL under the web scope, so
    // `externalApi('contextinfo')` addresses a web-scoped member instead.
    // Measured, both against the same site on 2026-09-05: the web-scoped
    // URL answered 403 with the SAME "security validation ... invalid"
    // sentence the wrong-web digest answers, and the API-root URL stamped
    // its rows. Because the two failures read identically, a wrong URL here
    // looks exactly like the digest-scope bug above, which is how it was
    // reintroduced (8843796) after being fixed once (8246ec0).
    //
    // Fetched per stamp, not cached: stamps are a handful of POSTs per run
    // and the ~30-minute cache lifetime is not worth a second invalidation
    // rule.
    const externalDigest = async () => {
      const r = await fetchWithRetry(crossWebDigestUrl(EXTERNAL_LOG_SITE), {
        method: 'POST',
        headers: { 'Accept': 'application/json;odata=verbose' },
      });
      if (!r.ok) {
        throw new Error(`central contextinfo: HTTP ${r.status} ${spError(await r.text())}`);
      }
      const digest = ((((await r.json()).d || {}).GetContextWebInformation || {}).FormDigestValue) || '';
      if (!digest) throw new Error('central contextinfo carried no FormDigestValue');
      return digest;
    };
    const stampExternal = async (kind, text, details) => {
      if (!externalReady) return;
      const body = {
        // Typed, like every other item POST: a verbose-transport entry with
        // no type name is refused ("An entry without a type name was
        // found", live 2026-09-05).
        __metadata: { type: externalEntityType },
        // Composed FIRST, then sliced: `A + B.slice(0, 255)` caps only B and
        // lets the row through at len(A) + 255, which SharePoint refuses for
        // a 255-character Title.
        Title: `${EXTERNAL_ROW_PREFIX} ${kind}: ${text}`.slice(0, 255),
      };
      if (externalStructured) {
        body.StampKind = kind;
        body.StampUtc = new Date().toISOString();
        body.SourceSite = SITE_URL;
        body.ReleaseTag = RELEASE_TAG;
        body.SchemaVersion = SCHEMA_VERSION;
        body.DeployerVersion = {{ ('dbml-sharepoint/' ~ release.deployer_version) | tojson }};
        body.Operator = OPERATOR_LOGIN;
        body.Details = details || '';
      }
      try {
        const resp = await fetchWithRetry(externalApi(
          `lists/getbytitle('${odataName(EXTERNAL_LOG_TITLE)}')/items`
        ), {
          method: 'POST', headers: spHeaders(await externalDigest()),
          body: JSON.stringify(body),
        });
        if (!resp.ok) {
          recordFailure(`external log '${EXTERNAL_LOG_TITLE}' ${kind}`,
            new Error(`HTTP ${resp.status} ${await resp.text()}`));
        }
      } catch (err) {
        recordFailure(`external log '${EXTERNAL_LOG_TITLE}' ${kind}`, err);
      }
    };
    if (externalReady) {
      await stampExternal('deployment start',
        `${RELEASE_TAG} (schema v${SCHEMA_VERSION}) at ${new Date().toISOString()} by `
        + `${OPERATOR_LOGIN} on {{ site_url }}`,
        `site {{ site_url }}; role {{ site_role }}`);
      await stampExternal('provenance',
        `generated from {{ source_dbml }}; release ${RELEASE_TAG}; schema v${SCHEMA_VERSION}; `
        + `deployer v{{ release.deployer_version }}; {{ generated_at }}; {{ env_file_line }}`,
        `generated from {{ source_dbml }} at {{ generated_at }}; {{ env_file_line }}`);
    }

    // ---- Drain what the shim buffered ----------------------------------
    for (const change of DEPLOY_CHANGES.splice(0, DEPLOY_CHANGES.length)) {
      await writeChange(change);
    }

    // ---- The run log's stamps ------------------------------------------
    // The entity type is resolved once and memoised across BOTH stamps: a
    // typeless item POST is refused (live finding 2026-09-05, "An entry
    // without a type name was found"), and the stop stamp is written from
    // deploy.js.j2's finally, long after this block has returned, so a
    // `const runEntityType` declared inside the start stamp's own try was
    // a ReferenceError on every stop stamp.
    let runEntityType = null;
    const runLogEntityType = async () => {
      if (!runEntityType) runEntityType = await listEntityType(RUN_LOG_TITLE);
      return runEntityType;
    };
    const stampRunLog = async (kind, details) => {
      try {
        const type = await runLogEntityType();
        const digest = await getDigest();
        const body = {
          __metadata: { type },
          // Parenthesised, then sliced: `A + B.slice(0, 255)` caps only B
          // and lets the row through at len(A) + 255, which SharePoint
          // refuses for a 255-character Title.
          Title: (`${EXTERNAL_ROW_PREFIX} ${kind}: ${RELEASE_TAG} (schema v${SCHEMA_VERSION}) `
            + `at ${new Date().toISOString()}`).slice(0, 255),
        };
        // The structured half, only when the columns are known present or
        // were created above. Naming one the list does not have is refused
        // outright, and the refusal costs the whole row rather than the
        // extra columns. Details is not sliced: it is a Note, which carries
        // no 255-character cap.
        if (runLogStructured) {
          body.StampKind = kind;
          body.StampUtc = new Date().toISOString();
          body.ReleaseTag = RELEASE_TAG;
          body.SchemaVersion = SCHEMA_VERSION;
          body.Operator = OPERATOR_LOGIN;
          body.Details = details;
        }
        const resp = await fetchWithRetry(apiUrl(
          `web/lists/getbytitle('${odataName(RUN_LOG_TITLE)}')/items`
        ), {
          method: 'POST', headers: spHeaders(digest),
          body: JSON.stringify(body),
        });
        if (!resp.ok) {
          recordFailure(`run log ${kind}`, new Error(`HTTP ${resp.status} ${await resp.text()}`));
        }
      } catch (err) {
        recordFailure(`run log ${kind}`, err);
      }
    };

    // ---- Publish the writers to the rest of the run --------------------
    // From here every phase logs changes directly; the finally in
    // deploy.js.j2 calls these two on every exit path.
    logChange = writeChange;
    finishRunLog = async () => {
      const kind = summary.errors.length > 0 ? 'abort' : 'deployment stop';
      const note = `errors ${summary.errors.length}; logging failures ${summary.loggingFailures.length}; `
        + `lists +${summary.listsCreated.length}, `
        + `renamed ${summary.listsRenamed.length}, columns +${summary.columnsCreated}, `
        + `skipped ${summary.columnsSkipped}; ${Math.round((Date.now() - RUN_STARTED_AT) / 1000)}s`;
      await stampRunLog(kind, note);
      if (EXTERNAL_LOG_TITLE) {
        await stampExternal(kind,
          `${RELEASE_TAG} (schema v${SCHEMA_VERSION}) at ${new Date().toISOString()}; ${note}`,
          note);
      }
      // Counted again here, because most logging failures happen in the
      // phases AFTER this one and none of them are on summary.errors, so
      // nothing else in the run says a word about them.
      if (summary.loggingFailures.length > 0) {
        log('WARN', `${summary.loggingFailures.length} logging operation(s) failed during this run; `
          + `the deploy was not stopped by them. The returned summary lists them under loggingFailures.`);
      }
    };

    // ---- The start stamp, last -----------------------------------------
    // Written once the phase's own setup has fully succeeded, so a start
    // stamp exists only for a run that got past creating its log lists.
    await stampRunLog('deployment start', `site {{ site_url }}; role {{ site_role }}`);

    log('INFO', `Run log '${RUN_LOG_TITLE}' stamped; `
      + (changeLogReady
        ? `change log '${CHANGE_LOG_TITLE}' ready.`
        : `change log '${CHANGE_LOG_TITLE}' NOT ready${changeLogFatal ? ' (foreign list refused)' : ' (setup failed)'}; changes will not be recorded this run.`));
    // This phase's OWN setup failures, counted here rather than left to the
    // exit line, so an operator watching the console sees a half-built log
    // before the phases that write to it start.
    if (summary.loggingFailures.length > 0) {
      log('WARN', `Phase {{ phase.number }} setup: ${summary.loggingFailures.length} logging operation(s) `
        + `failed; the deploy carries on. The returned summary lists them under loggingFailures.`);
    }
  }
{% else %}
  // --no-sidecars: no run log, no change log, no external stamps. The
  // shim logChange still buffers whatever renames raise, and nothing
  // drains it: a build that declines its own logging records nothing.
{% endif %}
