/**
 * dbml-sharepoint PROTECTION script for one list.
 *
 * Target site:  {{ site_url | comment_safe }}
 * List:         {{ list_path | comment_safe }}
 *               (resolved by URL; its title is read back at run time,
 *                because a renamed list keeps its original slug)
 * Deployer:     v{{ deployer_version | comment_safe }}
 * Generated at: {{ generated_at | comment_safe }}
 *
 * Reads the list's deletion lock and the Sealed flag on each custom column,
 * prints them, then takes one word at a time until you leave the prompt
 * blank: lock or unlock sets AllowDeletion; seal or unseal sets Sealed on
 * every custom column not already in that state. Each write is read back,
 * and a readback that disagrees stops the run with the list as it stands.
 *
 * A column the deployer provisioned is sealed on purpose: a sealed column
 * rejects schema edits in the UI and silently discards REST writes. Unseal
 * for the edit you are about to make, and seal again afterwards.
 *
 * Paste the whole file into the browser console on the site above, from a
 * classic page such as .../_layouts/15/settings.aspx.
 */
(async () => {
  const SITE_URL = {{ site_url | tojson }};
  const LIST_PATH = {{ list_path | tojson }};
  const LIST_SLUG = {{ list_title | tojson }};

  const log = (level, msg) => console.log(`[SP-PROTECT] [${level}] ${msg}`);
  const summary = { list: null, actions: [], errors: [] };

{% include "_site_guard.js.j2" %}

{% include "_http.js.j2" %}

{% include "_http_write.js.j2" %}

{% include "_digest_cached.js.j2" %}

{% include "_maintain_list.js.j2" %}

  async function printState() {
    const meta = await getOne(`${listPath}?$select=AllowDeletion,ItemCount`, `'${LIST_TITLE}' settings`);
    const all = await readFields();
    const fields = all.filter(isCustom);
    const sealed = fields.filter((f) => f.Sealed === true).length;
    // The built-in Title, REPORTED and never offered. `isCustom` excludes
    // anything FromBaseType and Title reads FromBaseType:true on every list
    // (measured 2026-09-07, test/manual/title-seal-probe.js, two sites), so
    // the one column whose display name a site owner can change without
    // touching anything this tool manages was the one column this readout
    // never showed. It stays out of `fields`, which is what the seal and
    // unseal loops walk: the same run established that a generic list
    // refuses Sealed:true on its Title by every route, so offering it would
    // only produce an error nobody can act on.
    const builtInTitle = all.find((f) => f.InternalName === 'Title') || null;
    log('INFO', `'${LIST_TITLE}': AllowDeletion ${meta.AllowDeletion} (${meta.AllowDeletion ? 'deletable' : 'deletion blocked'}), `
      + `${meta.ItemCount} item(s), ${fields.length} custom column(s), ${sealed} sealed`
      + `${builtInTitle ? `; built-in Title displays as '${builtInTitle.Title}'` : ''}.`);
    const row = (f, builtIn) => ({
      internal_name: f.InternalName, title: f.Title, type: f.TypeAsString,
      sealed: f.Sealed === true, read_only: f.ReadOnlyField === true,
      built_in: builtIn,
    });
    console.table([
      ...(builtInTitle ? [row(builtInTitle, true)] : []),
      ...fields.map((f) => row(f, false)),
    ]);
    summary.list = {
      title: LIST_TITLE, id: LIST_ID, allow_deletion: meta.AllowDeletion, item_count: meta.ItemCount,
      custom_columns: fields.length, sealed_columns: sealed, provisioned_by_dbml_sharepoint: provisioned,
      // Its DISPLAY title, which is the drift a deploy would silently correct
      // and nothing else reports between deploys.
      built_in_title: builtInTitle
        ? { title: builtInTitle.Title, sealed: builtInTitle.Sealed === true }
        : null,
    };
    return { meta, fields };
  }

  // The lock readback as a value or a failure, since a failed read says nothing about the MERGE before it.
  async function readLock() {
    let r;
    try {
      r = await fetchWithRetry(apiUrl(`${listPath}?$select=AllowDeletion`), verbose());
    } catch (transport) {
      return { failed: `the read never answered: ${transport.message}` };
    }
    try {
      if (!r.ok) return { failed: `HTTP ${r.status} ${spError(await r.text())}` };
      return { AllowDeletion: (((await r.json()) || {}).d || {}).AllowDeletion };
    } catch (body) {
      return { failed: `HTTP ${r.status}, and its body never arrived: ${body.message}` };
    }
  }

  // The lock MERGE, returning the transport error when its fetch rejects, since the write may still have taken.
  async function mergeLock(want) {
    const digest = await getDigest();
    let r;
    try {
      r = await fetchWithRetry(apiUrl(listPath), {
        method: 'POST',
        headers: spHeaders(digest, { 'IF-MATCH': '*', 'X-HTTP-Method': 'MERGE' }),
        body: JSON.stringify({ __metadata: { type: 'SP.List' }, AllowDeletion: want }),
      });
    } catch (transport) {
      return transport;
    }
    if (!r.ok) {
      throw new Error(`'${LIST_TITLE}' AllowDeletion: MERGE failed, HTTP ${r.status} ${spError(await r.text())}`);
    }
    return null;
  }

  const outcomeUnknown = (message) => {
    const err = new Error(message);
    err.outcomeUnknown = true;
    return err;
  };

  for (;;) {
    const state = await printState();
    const word = String(prompt(`Type lock, unlock, seal or unseal for '${LIST_TITLE}', or leave blank to finish:`) || '')
      .trim().toLowerCase();
    if (!word) break;
    try {
      if (word === 'lock' || word === 'unlock') {
        const want = word === 'unlock';
        const lost = await mergeLock(want);
        if (lost) {
          log('WARN', `The MERGE of AllowDeletion=${want} on '${LIST_TITLE}' never answered (${lost.message}); `
            + 'reading AllowDeletion back to settle whether it took.');
        }
        const back = await readLock();
        if (back.failed) {
          // Recorded, because the MERGE may have taken even though nothing read it back.
          summary.actions.push({
            action: word, list: LIST_TITLE, requested: { AllowDeletion: want },
            outcome: 'unknown', readback: back.failed, verified: false,
          });
          throw outcomeUnknown(`OUTCOME UNKNOWN: '${LIST_TITLE}' was sent AllowDeletion=${want}, and the `
            + `readback that would confirm it failed (${back.failed}), so the write may or may not have `
            + 'taken. Re-run this script and leave the prompt blank to see the actual state.');
        }
        if (back.AllowDeletion !== want) {
          throw mismatch(`AllowDeletion reads back ${back.AllowDeletion} after writing ${want}`);
        }
        // A lost request on a list already in that state proves the state, not that the write happened.
        const already = lost && state.meta.AllowDeletion === want;
        summary.actions.push(!lost
          ? { action: word, verified: true }
          : { action: word, list: LIST_TITLE, requested: { AllowDeletion: want },
              outcome: already ? 'already-in-state' : 'applied', verified: true });
        log('INFO', already
          ? `'${LIST_TITLE}': AllowDeletion was already ${want} and still reads ${want}; whether the lost request reached SharePoint is unknown.`
          : `'${LIST_TITLE}': AllowDeletion is now ${want} (read back).`);
      } else if (word === 'seal' || word === 'unseal') {
        const want = word === 'seal';
        const targets = state.fields.filter((f) => (f.Sealed === true) !== want);
        let written = 0;
        try {
          for (const field of targets) {
            await setSealed(field, want);
            written += 1;
            log('INFO', `'${field.InternalName}': Sealed is now ${want} (read back).`);
          }
        } catch (err) {
          // Recorded before the run stops. The columns already written and
          // read back are state the operator has to know about, and a summary
          // reporting no action at all hides them behind the error.
          if (written) summary.actions.push({ action: word, columns: written, verified: true });
          throw err;
        }
        summary.actions.push({ action: word, columns: written, verified: true });
        log('INFO', `${word}: ${written} column(s) written and read back.`);
      } else {
        log('WARN', `'${word}' is not one of lock, unlock, seal or unseal.`);
      }
    } catch (err) {
      summary.errors.push({ action: word, error: err.message });
      log('ERROR', `${word}: ${err.message}`);
      const aborted = err.readbackMismatch ? 'readback-mismatch'
        : (err.outcomeUnknown ? 'outcome-unknown' : 'write-failed');
      return { ...summary, aborted };
    }
  }

  log('INFO', `DONE: ${summary.actions.length} action(s), ${summary.errors.length} error(s), ${requestCount} request(s).`);
  return summary;
})();
