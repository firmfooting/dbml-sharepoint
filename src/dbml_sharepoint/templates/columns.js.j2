/**
 * dbml-sharepoint COLUMNS script for one list.
 *
 * Target site:  {{ site_url | comment_safe }}
 * List:         {{ list_path | comment_safe }}
 *               (resolved by URL; its title is read back at run time,
 *                because a renamed list keeps its original slug)
 * Deployer:     v{{ deployer_version | comment_safe }}
 * Generated at: {{ generated_at | comment_safe }}
 *
 * Lists the custom columns, asks for one by internal name, and deletes that
 * column after four guards: built-in and hidden fields never
 * appear on the menu; every item is read to see whether the column holds a
 * value, and the values found are printed so they can be re-keyed into a
 * replacement column; an empty column needs its internal name typed again
 * after that scan, and one that holds values, or whose values could not be
 * read, needs DELETE NON-EMPTY typed;
 * a sealed column is unsealed and read back before the delete, and the
 * column must read back as GONE after it, by a 404, by the documented
 * absent-field 400, or by being absent from the fields collection. A column
 * still there stops the run. The table is printed again after each delete,
 * and a blank answer finishes.
 *
 * Deleting a column removes its values from every item, and neither the
 * column nor the values go to the recycle bin (Microsoft Learn, SharePoint
 * data deletion). The item scan is what keeps that from being a surprise.
 *
 * Paste the whole file into the browser console on the site above, from a
 * classic page such as .../_layouts/15/settings.aspx.
 */
(async () => {
  const SITE_URL = {{ site_url | tojson }};
  const LIST_PATH = {{ list_path | tojson }};
  const LIST_SLUG = {{ list_title | tojson }};

  const log = (level, msg) => console.log(`[SP-COLUMNS] [${level}] ${msg}`);
  const summary = { list: null, deleted: [], skipped: [], errors: [] };

{% include "_site_guard.js.j2" %}

{% include "_http.js.j2" %}

{% include "_http_write.js.j2" %}

{% include "_digest_cached.js.j2" %}

{% include "_maintain_list.js.j2" %}

  summary.list = { title: LIST_TITLE, id: LIST_ID, item_count: list.ItemCount, provisioned_by_dbml_sharepoint: provisioned };

  // Lookup and person columns project their value as <name>Id; every other
  // type answers under its own internal name.
  const idProjected = (f) => /^(Lookup|LookupMulti|User|UserMulti)$/.test(String(f.TypeAsString));

  // The same read the deployer's shape probe makes on a lookup, then one
  // GET on the target: a lookup whose list was deleted is the column this
  // script exists to remove, so the table says so.
  async function lookupTarget(f) {
    if (!/^Lookup(Multi)?$/.test(String(f.TypeAsString))) return '';
    const shape = await getOne(`${fieldPath(f.Id)}?$select=LookupList,LookupField`, `'${f.InternalName}' lookup shape`);
    const target = String(shape.LookupList || '').replace(/[{}]/g, '');
    if (!GUID.test(target)) return 'UNREADABLE';
    const r = await fetchWithRetry(apiUrl(`web/lists(guid'${target}')?$select=Title`), verbose());
    if (r.status === 404) return 'MISSING';
    if (!r.ok) return 'UNREADABLE';
    const d = ((await r.json()) || {}).d || {};
    return d.Title || target;
  }

  async function enumerate() {
    const fields = (await readFields()).filter(isCustom);
    // No position column. Selection is by internal name, and a number here
    // would sit beside console.table's own 0-based (index) as a second,
    // differently-based way to name a row on a destructive menu.
    const rows = [];
    for (const f of fields) {
      rows.push({
        internal_name: f.InternalName, title: f.Title, type: f.TypeAsString,
        sealed: f.Sealed === true, read_only: f.ReadOnlyField === true, lookup_target: await lookupTarget(f),
      });
    }
    console.table(rows);
    return fields;
  }

  // The delete's readback. Strict 404 read a successful delete as a failure
  // and aborted the run (#383, live 2026-09-03): the by-GUID read of a
  // just-deleted field answered HTTP 400, and each invocation deleted one
  // column and then reported it had not.
  //
  // 404 and a recognised absent-400 both mean gone. Any OTHER status is
  // settled by re-reading the fields collection, because whether the
  // by-GUID getter carries the same absent-400 shape as the by-name ones
  // has not been measured, and absence enumerated is a measurement rather
  // than a claim about an error body. A delete that really failed still
  // finds the column there and still aborts.
  async function confirmDeleted(field) {
    const gone = await fetchWithRetry(fieldUrl(field.Id, '?$select=Id'), verbose());
    if (gone.status === 404) return 'HTTP 404 on readback';
    if (isAbsent400(gone.status, await gone.text())) {
      return 'HTTP 400 absent-field on readback';
    }
    if ((await readFields()).some((f) => f.InternalName === field.InternalName)) {
      throw mismatch(`'${field.InternalName}' still reads back after the delete (HTTP ${gone.status})`);
    }
    return `absent from the fields collection; the readback answered HTTP ${gone.status}`;
  }

  const hasValue = (v) => {
    if (v === null || v === undefined || v === '') return false;
    if (typeof v === 'object' && Array.isArray(v.results)) return v.results.length > 0;
    return true;
  };

  // Paged by Id, the documented way past the view threshold, and never
  // filtered: a $filter on an unindexed column throws past 5,000 items and a
  // Note column refuses one outright. Every page is read rather than stopping
  // at the first value, because the values are what the operator re-keys
  // after the redeploy. Past the page cap the count is partial and the state
  // is unknown if nothing was seen; both are gated exactly like a column
  // that holds values.
  const VALUE_PAGES_MAX = 40;
  const VALUE_SAMPLE_MAX = 50;
  const shown = (v) => (v && typeof v === 'object' && Array.isArray(v.results)) ? v.results.join('; ') : v;
  async function holdsValues(f) {
    const projected = idProjected(f) ? `${f.InternalName}Id` : f.InternalName;
    let nextUrl = apiUrl(`${listPath}/items?$select=Id,${projected}&$orderby=Id&$top=5000`);
    let pages = 0;
    let count = 0;
    const sample = [];
    const seen = (partial) => ({ state: 'values', count, partial, sample });
    try {
      while (nextUrl) {
        if (++pages > VALUE_PAGES_MAX) {
          return count ? seen(true) : { state: 'unknown', why: `more than ${VALUE_PAGES_MAX} pages of items` };
        }
        const r = await fetchWithRetry(nextUrl, verbose());
        if (!r.ok) return { state: 'unknown', why: `HTTP ${r.status} ${spError(await r.text())}` };
        const j = await r.json();
        for (const row of ((j && j.d && j.d.results) || [])) {
          if (!hasValue(row[projected])) continue;
          count += 1;
          if (sample.length < VALUE_SAMPLE_MAX) sample.push({ item: row.Id, value: shown(row[projected]) });
        }
        nextUrl = (j && j.d && typeof j.d.__next === 'string') ? j.d.__next : null;
      }
    } catch (err) {
      return { state: 'unknown', why: err.message };
    }
    return count ? seen(false) : { state: 'empty' };
  }

  for (;;) {
    const fields = await enumerate();
    if (!fields.length) {
      log('INFO', `'${LIST_TITLE}' has no custom columns left.`);
      break;
    }
    // BY NAME, NOT BY POSITION. console.table prints its own 0-based (index)
    // column immediately left of the row's own fields, so a menu number sat
    // beside a number one lower naming a different column. Off by one, on a
    // delete that takes the values with it and puts neither in the recycle
    // bin. An internal name cannot be off by one.
    const answer = String(prompt(`Type the internal name of the column to delete from '${LIST_TITLE}', or leave blank to finish:`) || '').trim();
    if (!answer) break;
    const field = fields.find((f) => f.InternalName === answer);
    if (!field) {
      // Case-insensitively close is still not it: SharePoint resolves a field
      // case-insensitively, so accepting that here would let one name select
      // the other of a pair differing only by case. Name the one to copy.
      const near = fields.find((f) => f.InternalName.toLowerCase() === answer.toLowerCase());
      log('WARN', near
        ? `'${answer}' is not on the menu; did you mean '${near.InternalName}'? Type it exactly.`
        : `'${answer}' is not an internal name on the menu.`);
      continue;
    }
    const held = await holdsValues(field);
    let confirmed;
    if (held.state === 'empty') {
      const typed = prompt(`'${field.InternalName}' holds no values in ${list.ItemCount} item(s). Type its internal name (${field.InternalName}) to ${field.Sealed === true ? 'unseal and ' : ''}delete it, or anything else to skip:`);
      confirmed = typed === field.InternalName;
    } else {
      let reason = `values could not be read (${held.why})`;
      if (held.state === 'values') {
        console.table(held.sample);
        const printed = held.sample.length < held.count ? `the first ${held.sample.length} are` : 'they are';
        reason = `holds values in ${held.count}${held.partial ? ' or more' : ''} item(s); ${printed} printed above`;
      }
      const typed = prompt(`'${field.InternalName}' ${reason}. Deleting a column removes its values from every item and nothing goes to the recycle bin. Type DELETE NON-EMPTY to delete it anyway, or anything else to skip:`);
      confirmed = typed === 'DELETE NON-EMPTY';
    }
    if (!confirmed) {
      summary.skipped.push({ column: field.InternalName, reason: 'not-confirmed' });
      log('INFO', `Skipped '${field.InternalName}'; nothing was written.`);
      continue;
    }
    try {
      if (field.Sealed === true) {
        await setSealed(field, false);
        log('INFO', `Unsealed '${field.InternalName}' (read back).`);
      }
      const digest = await getDigest();
      const r = await fetchWithRetry(fieldUrl(field.Id), {
        method: 'POST',
        headers: spHeaders(digest, { 'IF-MATCH': '*', 'X-HTTP-Method': 'DELETE' }),
      });
      if (!r.ok) throw new Error(`DELETE refused: HTTP ${r.status} ${spError(await r.text())}`);
      const how = await confirmDeleted(field);
      summary.deleted.push(field.InternalName);
      log('INFO', `Deleted '${field.InternalName}' and confirmed it is gone (${how}).`);
    } catch (err) {
      summary.errors.push({ column: field.InternalName, error: err.message });
      log('ERROR', `'${field.InternalName}': ${err.message}`);
      return { ...summary, aborted: err.readbackMismatch ? 'readback-mismatch' : 'write-failed' };
    }
  }

  log('INFO', `DONE: ${summary.deleted.length} deleted, ${summary.skipped.length} skipped, ${summary.errors.length} error(s), ${requestCount} request(s).`);
  return summary;
})();
