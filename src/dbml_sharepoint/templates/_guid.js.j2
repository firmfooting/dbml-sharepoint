{# A GUID SharePoint returned, checked before it is spliced into a URL.

   Every id here comes back from the API and is then interpolated into a path
   like `web/lists(guid'<id>')`, so the shape is asserted rather than trusted:
   an id that is not a GUID means the read did not return what was asked for,
   and the failure should say so at the read rather than as a malformed URL
   two calls later.

   `deploy/_helpers.js.j2` carries the same function for the deploy bundle.
   The two are deliberately not shared yet: folding them together edits the
   emitted deploy and moves `test/fixtures/expected/simple-deploy.js`, which
   is a golden review of its own and does not belong in a maintenance fix. #}
  const GUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
  const sharePointGuid = (value, label) => {
    const held = String(value || '');
    if (!GUID.test(held)) throw new Error(`Invalid ${label} GUID returned by SharePoint`);
    return held;
  };
