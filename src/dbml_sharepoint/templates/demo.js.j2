/**
 * dbml-sharepoint DEMO DATA script (built with --seed).
{% include "_provenance.js.j2" %}
 *
 * Paste AFTER deploy.js.txt has finished with errors: []. Creates the declared
 * demo/sample rows. Every Title starts with '{{ demo_title_prefix }}' (visible in every
 * view and form), and each row's text
 * identifies it as demonstration data to delete before active use.
 * Re-pasting is safe: rows that already exist (matched by Title) are
 * skipped, never duplicated. rollback.js.txt confirms every list before delete;
 * the Title prefix is a visible notice, not deletion authority.
 */
(async () => {
  const SITE_URL  = {{ site_url | tojson }};
  const DEMO_PLAN = {{ demo_plan | tojson(indent=2) }};

  const log = (level, msg) => console.log(`[SP-DEMO] [${level}] ${msg}`);
  const summary = { created: [], skipped: [], errors: [] };

{% include "_site_guard.js.j2" %}

{% include "_http.js.j2" %}

{% include "_http_write.js.j2" %}

{% include "_http_batch.js.j2" %}

{% include "_digest_cached.js.j2" %}

  // A Map, because a list titled `__proto__` is `in` an empty object and
  // reads back as Object.prototype, so the fetch below would be skipped
  // and the caller would send that object as the item type.
  const entityTypes = new Map();
  async function entityTypeFor(listTitle) {
    if (!entityTypes.has(listTitle)) {
      const r = await fetchWithRetry(apiUrl(`web/lists/getbytitle('${odataName(listTitle)}')?$select=ListItemEntityTypeFullName`), {
        headers: { 'Accept': 'application/json;odata=verbose' },
      });
      if (!r.ok) throw new Error(`cannot resolve ListItemEntityTypeFullName for '${listTitle}' (HTTP ${r.status})`);
      entityTypes.set(listTitle, (await r.json()).d.ListItemEntityTypeFullName);
    }
    return entityTypes.get(listTitle);
  }

  async function findByTitle(listTitle, title) {
    const filter = encodeURIComponent(`Title eq '${String(title).replace(/'/g, "''")}'`);
    const r = await fetchWithRetry(apiUrl(`web/lists/getbytitle('${odataName(listTitle)}')/items?$select=Id&$filter=${filter}&$top=1`), {
      headers: { 'Accept': 'application/json;odata=verbose' },
    });
    if (!r.ok) throw new Error(`existence probe on '${listTitle}' failed (HTTP ${r.status})`);
    const rows = (await r.json()).d.results || [];
    return rows.length > 0 ? rows[0].Id : null;
  }

  // Accept only the measured verbose-OData collection shape (probes M3/M4,
  // 2026-08-17 for a Choice; field.multilookup.item-read-shape, 2026-09-02 for
  // a Lookup, whose members come back as ids rather than as member names).
  function storedMembers(item, field, raw, memberType) {
    const name = field.name;
    if (raw == null) return [];
    const keys = typeof raw === 'object' && !Array.isArray(raw) ? Object.keys(raw).sort() : [];
    const metadata = raw && raw.__metadata;
    const results = raw && raw.results;
    if (keys.join(',') !== '__metadata,results'
        || !metadata || metadata.type !== field.metadata_type
        || !Array.isArray(results) || results.some((m) => typeof m !== memberType)) {
      throw new Error(`${name} read back in an unrecognised shape (${JSON.stringify(raw)}), so the members written to demo row '${item.key}' cannot be verified`);
    }
    return results;
  }

  // Verify every declared multi-value member before recording the row as created.
  async function verifyMultiValues(item, itemId, writtenRefIds) {
    // A multi-value lookup reads back through the same <Name>Id alias it was
    // written through, and its members are ids, so each kind carries the
    // select name, the member type and the written values it was measured
    // with instead of the two sharing one set.
    const multi = item.fields
      .filter((f) => f.kind === 'multi_value' || f.kind === 'multi_ref')
      .map((f) => (f.kind === 'multi_value'
        ? { field: f, select: f.name, memberType: 'string', written: f.results }
        : { field: f, select: `${f.name}Id`, memberType: 'number', written: writtenRefIds.get(f.name) || [] }));
    if (!multi.length) return;  // a single-value row keeps its one POST
    const select = multi.map((m) => odataName(m.select)).join(',');
    const r = await fetchWithRetry(apiUrl(`web/lists/getbytitle('${odataName(item.list)}')/items(${itemId})?$select=${select}`), {
      headers: { 'Accept': 'application/json;odata=verbose' },
    });
    if (!r.ok) {
      throw new Error(`the read-back of Id ${itemId} failed (HTTP ${r.status}), so the multi-value members written to demo row '${item.key}' are unverified`);
    }
    const stored = (await r.json()).d || {};
    for (const m of multi) {
      const got = storedMembers(item, m.field, stored[m.select], m.memberType);
      // Compare membership and count because member order is not a declared contract.
      const missing = m.written.filter((v) => !got.includes(v));
      const extra = got.filter((v) => !m.written.includes(v));
      if (missing.length || extra.length || got.length !== m.written.length) {
        throw new Error(`${m.field.name} was written ${JSON.stringify(m.written)} and read back ${JSON.stringify(got)}`);
      }
    }
  }

  // A Map for the same reason as `entityTypes` above: a demo key of
  // `__proto__` would not survive assignment into an object.
  const createdIds = new Map();
  for (const item of DEMO_PLAN) {
    try {
      const digest = await getDigest();
      const titleField = item.fields.find((f) => f.name === 'Title');
      const existingId = await findByTitle(item.list, titleField.value);
      if (existingId != null) {
        createdIds.set(item.key, existingId);  // later demo_refs still resolve
        summary.skipped.push({ list: item.list, key: item.key, id: existingId });
        log('INFO', `'${item.list}': demo row '${item.key}' already exists (Id ${existingId}); skipped.`);
        continue;
      }
      const body = { __metadata: { type: await entityTypeFor(item.list) } };
      const writtenRefIds = new Map();  // resolved ids, for the read-back below
      for (const f of item.fields) {
        if (f.kind === 'literal') {
          body[f.name] = f.value;
        } else if (f.kind === 'multi_value') {
          // A multi-value column takes a collection, not a bare array: the
          // shape below is what SharePoint accepted (probe M3, 2026-08-17).
          body[f.name] = { __metadata: { type: f.metadata_type }, results: f.results };
        } else if (f.kind === 'me') {
          // Person columns write <Name>Id; the demo owner is the operator.
          body[`${f.name}Id`] = _spPageContextInfo.userId;
        } else if (f.kind === 'url') {
          // A URL column takes a record, not a string: SP rejects a bare
          // literal at create time.
          body[f.name] = {
            __metadata: { type: 'SP.FieldUrlValue' },
            Url: f.value.url,
            Description: f.value.description,
          };
        } else if (f.kind === 'ref') {
          const refId = createdIds.get(f.value);
          if (refId == null) throw new Error(`demo_ref '${f.value}' has no created item`);
          body[`${f.name}Id`] = refId;
        } else if (f.kind === 'multi_ref') {
          // A multi-value lookup writes through the SAME <Name>Id alias, but
          // takes a { results: [...] } object. A bare array is refused HTTP
          // 400 (probe field.multilookup.item-write-shape, 2026-09-02).
          const refIds = f.value.map((key) => {
            const refId = createdIds.get(key);
            if (refId == null) throw new Error(`demo_ref '${key}' has no created item`);
            return refId;
          });
          writtenRefIds.set(f.name, refIds);
          body[`${f.name}Id`] = { results: refIds };
        } else if (f.kind === 'date_offset') {
          // Resolved at RUN time so cadence-derived surfaces (Review due,
          // overdue, Tolerance due) land on whatever day the demo runs.
          body[f.name] = new Date(Date.now() + f.value * 86400000).toISOString();
        }
      }
      const createResp = await fetchWithRetry(apiUrl(`web/lists/getbytitle('${odataName(item.list)}')/items`), {
        method: 'POST', headers: spHeaders(digest), body: JSON.stringify(body),
      });
      if (!createResp.ok) {
        throw new Error(spError(await createResp.text()) || `item create failed (HTTP ${createResp.status})`);
      }
      const createdId = (await createResp.json()).d.Id;
      // Before `createdIds`, so an unverified row resolves no later demo_ref.
      await verifyMultiValues(item, createdId, writtenRefIds);
      createdIds.set(item.key, createdId);
      summary.created.push({ list: item.list, key: item.key, id: createdId });
      log('INFO', `'${item.list}': created demo row '${item.key}' (Id ${createdId}).`);
    } catch (err) {
      log('ERROR', `'${item.list}' demo row '${item.key}': ${err.message}`);
      summary.errors.push({ list: item.list, key: item.key, error: err.message });
    }
  }

  log('DONE', `Demo data complete. Created ${summary.created.length}, skipped ${summary.skipped.length} existing, errors ${summary.errors.length}.`);
  log('INFO', 'Every demo row is prefixed "{{ demo_title_prefix }}". Delete before active use; rollback.js.txt confirms every list before delete.');
  console.log(summary);
  return summary;
})();
