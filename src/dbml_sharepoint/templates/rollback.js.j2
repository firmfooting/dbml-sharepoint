{# src/dbml_sharepoint/templates/rollback.js.j2 #}
/**
 * dbml-sharepoint ROLLBACK script.
{% include "_provenance.js.j2" %}
 *
 * DELETES every list declared by this schema at this site. Refuses EVERY list
 * unless the user types DELETE NON-EMPTY for that list and any items present.
 * Deletion-blocked lists (AllowDeletion = false) are unlocked per list
 * after confirmation and re-locked if their delete fails.
 */
(async () => {
  const SITE_URL  = {{ site_url | tojson }};
  const SITE_PATH_LEAF = SITE_URL.replace(/\/$/, '').split('/').pop();
  const TARGET_LISTS = {{ target_lists | tojson(indent=2) }};

  const log = (level, msg) => console.log(`[SP-ROLLBACK] [${level}] ${msg}`);
  const summary = { deleted: [], skipped: [], errors: [] };

{% include "_site_guard.js.j2" %}

{% include "_http.js.j2" %}

{% include "_http_write.js.j2" %}

{% include "_http_batch.js.j2" %}

{% include "_digest_cached.js.j2" %}
  log('WARN', 'Rollback deletes lists BY TITLE. A pre-existing non-deploy list whose title collides with a APP_ list would be deleted. Verify the target list is deploy-owned before confirming.');

  const typed = prompt(`Type the site leaf path to confirm rollback (${SITE_PATH_LEAF}):`);
  if (typed !== SITE_PATH_LEAF) {
    log('INFO', 'Aborted by user (typed value did not match site leaf).');
    return { aborted: 'user-cancelled' };
  }

  // === Preflight: ManageLists + ManagePermissions ===
  // Rollback deletes lists which may have broken inheritance; ManagePermissions
  // is required to reassign or remove unique role assignments on those lists.
  // ManageLists is Low bit 0x800; ManagePermissions is Low bit 0x2000000.
  const permsResp = await fetchWithRetry(apiUrl('web?$select=EffectiveBasePermissions'), {
    headers: { 'Accept': 'application/json;odata=verbose' },
  });
  const permsJson = await permsResp.json();
  const requiredLow = 0x800 | 0x2000000;  // ManageLists | ManagePermissions
  const haveLow = Number(permsJson?.d?.EffectiveBasePermissions?.Low || 0);
  if ((haveLow & requiredLow) !== requiredLow) {
    log('ERROR', 'Current user lacks ManageLists+ManagePermissions on this site.');
    return { aborted: 'insufficient-permissions' };
  }

  // One lists enumeration serves every existence + count check: a
  // by-title GET on an absent list answers 404, which the browser paints
  // red and operators read as a failure (same live finding as deploy.js.txt's
  // absence probes; seen on this script 2026-07-24). The enumeration is
  // always HTTP 200. Counts are a start-of-run snapshot; classification
  // and recycling read live items anyway.
  // Page through the complete live list catalogue. An omitted page cannot be
  // treated as an absent target: that would skip its per-list confirmation.
  let listCountsByTitle = null;
  async function itemCount(name) {
    if (listCountsByTitle === null) {
      // Titles are live data, so avoid Object.prototype keys such as
      // `constructor` or `__proto__` becoming false list matches.
      const discovered = Object.create(null);
      let nextUrl = apiUrl('web/lists?$select=Title,ItemCount&$top=5000');
      let pages = 0;
      while (nextUrl) {
        if (++pages > 100) throw new Error('list enumeration exceeded 100 pages; aborting');
        const r = await fetchWithRetry(nextUrl, {
          headers: { 'Accept': 'application/json;odata=verbose' },
        });
        if (!r.ok) {
          throw new Error(`list enumeration failed: HTTP ${r.status} ${spError(await r.text())}`);
        }
        const j = await r.json();
        const continuation = j && j.d ? j.d.__next : undefined;
        if (continuation !== undefined && continuation !== null && typeof continuation !== 'string') {
          throw new Error(`list enumeration: malformed OData __next; expected a string or null`);
        }
        for (const l of ((j && j.d && j.d.results) || [])) {
          discovered[l.Title] = Number.isInteger(l.ItemCount) ? l.ItemCount : 0;
        }
        nextUrl = continuation || null;
      }
      // Publish only a complete enumeration. A page failure leaves the cache
      // null, so no later target can mistake a partial catalogue for absence.
      listCountsByTitle = discovered;
    }
    return (name in listCountsByTitle) ? listCountsByTitle[name] : null;
  }

  // Recycle a list's items BEFORE deleting the list. Live findings
  // 2026-07-24 (two teardowns on a retention-governed site): SharePoint
  // refuses to delete a list that still CONTAINS items ("List cannot be
  // deleted while on hold or retention policy"), while an emptied list
  // deletes fine and item recycling is always allowed; the policy keeps
  // its copies in the Preservation Hold Library
  // (https://learn.microsoft.com/purview/retention-policies-sharepoint).
  // recycle(), never a permanent DELETE: nothing this script does is
  // unrestorable. This is reached only after the operator typed DELETE
  // NON-EMPTY for THIS list, so it recycles EVERY item: they just
  // authorised deleting the list including its contents, and emptying it
  // first is what makes that delete actually succeed under retention.
  async function recycleItems(name) {
    let total = 0;
    // Reported in a finally, not after the loop: a drain that fails part way
    // through has already moved rows to the recycle bin, and a run that says
    // nothing about them leaves the operator no reason to restore them.
    try {
      for (;;) {
        const r = await fetchWithRetry(apiUrl(`web/lists/getbytitle('${odataName(name)}')/items?$select=Id&$top=200`), {
          headers: { 'Accept': 'application/json;odata=verbose' },
        });
        if (!r.ok) throw new Error(`item read failed: HTTP ${r.status}`);
        const rows = ((await r.json()).d || {}).results || [];
        if (rows.length === 0) break;
        const digest = await getDigest();
        for (const row of rows) {
          const rec = await fetchWithRetry(apiUrl(`web/lists/getbytitle('${odataName(name)}')/items(${row.Id})/recycle()`), {
            method: 'POST',
            headers: { 'Accept': 'application/json;odata=verbose', 'X-RequestDigest': digest },
          });
          if (!rec.ok) {
            throw new Error(`recycle of item ${row.Id} failed: HTTP ${rec.status} ${spError(await rec.text())}`);
          }
          total += 1;
        }
        if (total > 5000) throw new Error(`recycled ${total} items without draining '${name}'; aborting as a safety stop`);
      }
    } finally {
      log('INFO', `'${name}': recycled ${total} item(s) (restorable from the recycle bin).`);
    }
  }

  // AllowDeletion=false (deployed via prevent_list_deletion, or set by
  // hand) rejects list DELETE on EVERY surface: UI, CSOM and this
  // script's REST call all get "This list cannot be deleted." Rollback
  // probes the ACTUAL state once deletion is authorised for a list,
  // unlocks it, and re-locks on a failed delete. Sealed COLUMNS need no
  // counterpart here: SP.Field.Sealed guards the field object (its
  // schema edits and its own deletion), and list deletion never consults
  // per-field Sealed; every out-of-the-box list carries built-in sealed
  // fields and deletes fine. Do NOT add an unseal pass.
  async function readAllowDeletion(name) {
    const r = await fetchWithRetry(apiUrl(`web/lists/getbytitle('${odataName(name)}')?$select=AllowDeletion`), {
      headers: { 'Accept': 'application/json;odata=verbose' },
    });
    if (!r.ok) return null;
    const j = await r.json();
    return (j && j.d && typeof j.d.AllowDeletion === 'boolean') ? j.d.AllowDeletion : null;
  }

  async function setAllowDeletion(name, value) {
    const digest = await getDigest();
    const r = await fetchWithRetry(apiUrl(`web/lists/getbytitle('${odataName(name)}')`), {
      method: 'POST',
      headers: spHeaders(digest, { 'IF-MATCH': '*', 'X-HTTP-Method': 'MERGE' }),
      body: JSON.stringify({ __metadata: { type: 'SP.List' }, AllowDeletion: value }),
    });
    return r.ok;
  }

  // Read the live Description and answer whether THIS family provisioned the
  // list. Read at delete time, never captured earlier: a marker recorded when
  // the script was generated says what was true then, not what is true now.
  //
  // The Id rides along on a request already being made. The marker alone
  // cannot see a same-titled replacement, because a replacement can carry a
  // copied Description; the Id is what separates them. Same argument
  // `ownedListIdentity` makes in the deploy, and the same cost, since
  // `$select=Id,Description` is one request just as `$select=Description` was.
  //
  // Returns null when the question could not be answered at all, which the
  // caller must treat as "do not delete" rather than as "not ours".
  async function readOwnership(name, expectedMarker) {
    if (typeof expectedMarker !== 'string' || expectedMarker === '') return null;
    const r = await fetchWithRetry(apiUrl(`web/lists/getbytitle('${odataName(name)}')?$select=Id,Description`), {
      headers: { 'Accept': 'application/json;odata=verbose' },
    });
    if (!r.ok) return null;
    const j = await r.json();
    const description = (j && j.d && typeof j.d.Description === 'string') ? j.d.Description : '';
    const id = (j && j.d && typeof j.d.Id === 'string') ? j.d.Id : null;
    if (id === null) return null;
    return { ours: description.indexOf(expectedMarker) !== -1, id };
  }

  // FLAGGED, because the re-lock below has to keep this uncertainty: a list
  // whose delete could not be settled is not one known to be still there.
  const unsettled = (message) => {
    const err = new Error(message);
    err.deletionUnknown = true;
    return err;
  };

  for (const target of TARGET_LISTS) {
    const name = target.title;
    // What this run has done to THIS list's deletion block: 'untouched' until
    // it tries to take one off, 'unknown' from the moment the unlock is
    // attempted, and 'off' once a readback proves the block came off. Out
    // here because the re-lock that reads it runs in the catch below.
    let unlock = 'untouched';
    try {
      const count = await itemCount(name);
      if (count === null) { summary.skipped.push({ list: name, reason: 'not-found' }); continue; }
      // The deploy refuses to adopt an object it did not provision; rollback
      // must refuse to delete one, or the gate exists on the way in and not
      // on the way out (helm/helm#31333, which shipped that asymmetry from
      // 2020 to 2026). A title collision is enough to reach it, and the
      // list-name prefix is optional.
      const owned = await readOwnership(name, target.expected_marker);
      if (owned === null) {
        summary.skipped.push({ list: name, reason: 'provenance-unreadable' });
        log('WARN', `'${name}': could not read its Description to confirm this family provisioned it; skipping rather than deleting.`);
        continue;
      }
      if (!owned.ours) {
        summary.skipped.push({ list: name, reason: 'not-ours' });
        log('WARN', `'${name}': exists but carries no '${target.expected_marker}' marker, so it was not provisioned by this family. Skipping; nothing has been deleted. Rename it, or delete it by hand if you are certain.`);
        continue;
      }
      // Confirm EVERY list, not only a snapshot classified as non-empty.
      // ItemCount is not an atomic gate: an item can exist despite a stale
      // zero or arrive after enumeration. The same phrase therefore
      // authorises this list and any items present when recycling starts.
      // Re-prompt PER list so one answer never authorises another target.
      // A library's items are files and folders, and recycling a folder
      // takes its children with it, recoverably (MEASURED 2026-09-03,
      // `library.folder.delete-recycles` in folder-probe.js: /recycle
      // answered HTTP 200, the folder and its child read back absent, and
      // the bin held the returned id).
      const override = prompt(target.is_library
        ? `'${name}' is a document library currently reporting ${count} files and folders. Type DELETE NON-EMPTY to delete THIS library AND every file and folder in it (recycled first, restorable from the site recycle bin; you will be asked again for every list), or anything else to skip:`
        : `'${name}' currently reports ${count} items. Type DELETE NON-EMPTY to delete THIS list AND any items present (recycled first, restorable; you will be asked again for every list), or anything else to skip:`);
      if (override !== 'DELETE NON-EMPTY') {
        summary.skipped.push({
          list: name,
          reason: count > 0 ? 'non-empty' : 'empty-unconfirmed',
          items: count,
        });
        continue;
      }
      // Authorised by a human, who took as long as they took. The check that
      // authorised this ran BEFORE the confirmation above, and that call
      // blocks for however long somebody reads and types, so by here the
      // classification is of arbitrary age while everything after it is
      // irreversible in practice. Ask again, against the same title, before
      // the first destructive write.
      //
      // Both halves have to still hold. An unreadable answer is not evidence
      // of ownership and is not evidence against it, so it skips: the same
      // fail-closed posture as the first check. A different Id is a
      // same-titled list that arrived during the pause, which is the case the
      // marker on its own cannot see.
      const stillOwned = await readOwnership(name, target.expected_marker);
      if (stillOwned === null || !stillOwned.ours || stillOwned.id !== owned.id) {
        const why = stillOwned === null
          ? 'its Description could not be read again'
          : !stillOwned.ours
            ? `it no longer carries the '${target.expected_marker}' marker`
            : `the title now resolves to a different list (${owned.id} before the prompt, ${stillOwned.id} now)`;
        summary.skipped.push({ list: name, reason: 'ownership-changed-during-confirmation' });
        log('WARN', `'${name}': confirmed for deletion, but ${why}. Nothing has been recycled or deleted. Re-run to see the site as it is now.`);
        continue;
      }
      // Read and recycle live items even when the earlier count was zero,
      // then delete. recycle() keeps every item restorable.
      await recycleItems(name);
      // Unlock only once deletion is authorised for THIS list; skipped
      // lists keep their protection untouched.
      const allowDeletion = await readAllowDeletion(name);
      if (allowDeletion === null) {
        log('WARN', `${name}: AllowDeletion probe failed; attempting delete anyway.`);
      } else if (allowDeletion === false) {
        // Recorded BEFORE the write, not after its readback: a MERGE that
        // took effect and a readback that then failed leaves the block off
        // with nothing to put it back, and the catch below is what does.
        unlock = 'unknown';
        if (!(await setAllowDeletion(name, true))) {
          throw new Error('deletion-block unlock MERGE failed');
        }
        const back = await readAllowDeletion(name);
        if (back === false) {
          // The one case needing no restore: the readback ANSWERED, and it
          // says the write was discarded and the block is still on.
          unlock = 'untouched';
          throw new Error('deletion-block unlock did not take effect');
        }
        if (back !== true) {
          throw new Error('deletion-block unlock could not be read back');
        }
        unlock = 'off';
        log('INFO', `${name}: deletion block cleared for this delete (AllowDeletion = true).`);
      }
      // Fetch a fresh digest per delete: FormDigestValue expires (~30 min), so
      // confirmation-prompt pauses or many-list runs can otherwise 403 mid-run
      // and leave the site partially rolled back.
      const digest = await getDigest();
      // A request that never came back is not a delete that did not happen:
      // the connection can drop after SharePoint has accepted it, so the
      // by-id readback below settles it rather than the transport failure.
      let r = null;
      try {
        r = await fetchWithRetry(apiUrl(`web/lists/getbytitle('${odataName(name)}')`), {
          method: 'POST',
          headers: spHeaders(digest, { 'IF-MATCH': '*', 'X-HTTP-Method': 'DELETE' }),
        });
      } catch (transport) {
        log('WARN', `${name}: the DELETE never answered (${transport.message}); reading the list back by its id to settle whether it went.`);
      }
      if (r && !r.ok) {
        // Surface SharePoint's actual reason (live finding 2026-07-24: a
        // bare 'HTTP 500' left a blocked teardown undiagnosable).
        const detail = spError(await r.text());
        if (/hold or retention policy/i.test(detail)) {
          // Live-confirmed 2026-07-24: retention blocks deleting a list
          // that still CONTAINS items; an emptied list deletes fine. If
          // an EMPTY list is still refused, a site-level hold applies,
          // which is compliance enforcement this script will never bypass.
          log('WARN', `${name}: SharePoint refused the LIST delete under a retention policy or hold. After your per-list DELETE NON-EMPTY confirmation, rollback recycles any live items before deleting. If this list was emptied and is STILL refused, a site-level hold applies and a compliance admin must release it (a delay hold can persist after release) before rollback can proceed.`);
        }
        throw new Error(`HTTP ${r.status}${detail ? `, ${detail}` : ''}`);
      }
      // A 200 on the DELETE is not the list being gone, and this is the
      // destructive script: an operator told "Deleted X" stops looking for X.
      // By id, not by title, so a same-titled replacement created since does
      // not read as the list this run deleted. Same check `confirmDeleted`
      // makes in columns.js, which rollback did not have.
      const what = r ? `answered HTTP ${r.status}` : 'never answered';
      let gone;
      try {
        gone = await fetchWithRetry(apiUrl(`web/lists(guid'${stillOwned.id}')?$select=Id`), {
          headers: { 'Accept': 'application/json;odata=verbose' },
        });
      } catch (transport) {
        // The readback rejects for the same reason the DELETE can, and a
        // request that never answered settles nothing either way.
        throw unsettled(`the delete ${what}, and the readback that would confirm it never answered (${transport.message}); whether '${name}' is gone is unknown.`);
      }
      if (gone.ok) {
        throw new Error(`the delete ${what} and the list still reads back by its id (${stillOwned.id}); it has NOT been deleted.`);
      }
      if (gone.status !== 404) {
        let detail;
        try {
          detail = await gone.text();
        } catch (body) {
          // The status alone cannot say which 400 this is, so a body that
          // never arrived leaves the readback as unable to settle it.
          throw unsettled(`the delete ${what}, and the body of the HTTP ${gone.status} readback that would confirm it never arrived (${body.message}); whether '${name}' is gone is unknown.`);
        }
        if (!isAbsent400(gone.status, detail)) {
          throw unsettled(`the delete ${what}, and the readback that would confirm it failed with HTTP ${gone.status}; whether '${name}' is gone is unknown.`);
        }
      }
      summary.deleted.push(name);
      log('INFO', `Deleted ${name}, confirmed absent by list id.`);
    } catch (err) {
      summary.errors.push({ list: name, error: err.message });
      log('ERROR', `${name}: ${err.message}`);
      // Best-effort re-lock: this run may have removed the protection and the
      // delete did not go through; never strand the list unprotected. Here
      // rather than on the refused-DELETE path alone, because a delete whose
      // response never arrived, and one whose readback could not settle it,
      // strand the list the same way.
      //
      // READ BACK, like the unlock that took it off: a MERGE SharePoint
      // discarded answers exactly as one it applied does, so the MERGE's own
      // status cannot tell an operator the protection is back. An unreadable
      // answer reads as not restored, which is the same fail-closed posture
      // every other readback here takes.
      if (unlock !== 'untouched' && !summary.deleted.includes(name)) {
        const after = err.deletionUnknown
          ? 'a delete that could not be confirmed'
          : (unlock === 'off' ? 'a failed delete' : 'an unlock that could not be read back');
        const merged = await setAllowDeletion(name, false).catch(() => false);
        const relocked = merged && (await readAllowDeletion(name).catch(() => null)) === false;
        log(relocked ? 'INFO' : 'ERROR', `${name}: deletion block ${relocked ? 'restored (read back)' : 'could NOT be confirmed restored'} after ${after}.`);
      }
    }
  }
  log('DONE', `Deleted ${summary.deleted.length}, skipped ${summary.skipped.length}, errors ${summary.errors.length}.`);
  console.log(summary);
  return summary;
})();
