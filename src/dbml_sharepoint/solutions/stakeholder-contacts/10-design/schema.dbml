// ============================================================================
// Stakeholder contacts — organisations, their people, and the interaction log.
// Render the ERD by pasting this file into https://dbdiagram.io
// ============================================================================

Project stakeholder_contacts { database_type: 'SharePoint Online Lists' }

Enum org_type {
  "Government"
  "Supplier / vendor"
  "Partner"
  "Community group"
  "Media"
  "Peak body / industry"
  "Other"
}

Enum interaction_type {
  "Meeting"
  "Call"
  "Email"
  "Event"
  "Site visit"
  "Other"
}

Table Organisation {
  Id       int       [pk, increment]
  Title    nvarchar  [not null, note: 'Organisation name']
  OrgType  org_type  [not null]
  Website  hyperlink
  Owner    person    [note: 'Who owns this relationship overall']
  Notes    richtext  [note: 'What they do, why they matter to us, sensitivities']

  indexes {
    OrgType
  }

  Note: 'The external bodies this organisation deals with: government, suppliers, partners, community groups and media, each with the person here who owns the relationship.'
}

Table Contact {
  Id           int      [pk, increment]
  Title        nvarchar [not null, note: 'Full name']
  // Lookup to Organisation.
  Organisation int      [not null, ref: > Organisation.Id, note: 'The organisation they work for']
  Role         nvarchar [note: 'Their position']
  Email        nvarchar
  Phone        nvarchar
  IsActive     boolean  [default: true, note: 'Uncheck when they move on — do not delete (see governance)']
  Notes        nvarchar [note: 'Preferences worth knowing (e.g. "prefers phone"). Professional facts only — see privacy rules']

  indexes {
    Organisation
    IsActive
  }

  Note: 'The individual people at those organisations, with their role and how to reach them. Anyone who moves on is marked inactive rather than deleted, so past interactions still read.'
}

Table Interaction {
  Id              int              [pk, increment]
  Title           nvarchar         [not null, note: 'One line: "Quarterly review — funding timeline discussed"']
  // Lookup to Contact.
  Contact         int              [not null, ref: > Contact.Id, note: 'The person this interaction was with']
  InteractionDate date             [not null]
  InteractionType interaction_type [not null, default: 'Meeting']
  RecordedBy      person           [note: 'Who from our side (defaults to you)']
  Summary         richtext         [note: 'What was discussed, agreed or promised — enough for a colleague to pick up the thread']

  indexes {
    Contact
    InteractionDate
    InteractionType
  }

  Note: 'A note of every meeting, call, email or visit, so that a relationship is remembered by the organisation rather than by whoever happened to be in the room.'
}
