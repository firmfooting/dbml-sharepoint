// ============================================================================
// RAID log: four flat lists for one project site. Risks, Actions, Issues and
// Decisions, read together in the project meeting. Only Action and Issue link
// to anything, and both links are optional.
// Render the ERD by pasting this file into https://dbdiagram.io
// ============================================================================

Project raid_log { database_type: 'SharePoint Online Lists' }

// The four lists are named Project* because the unprefixed list name has to
// stay unique across the shipped families: risk-register already owns Risk and
// meeting-actions already owns Decision, and two families sharing a name would
// collide the moment either deployed without a prefix.
// See test_no_two_templates_declare_the_same_entity_name.

// Matrix rows 1-5, and matrix columns 1-5. Both are lifted unchanged from
// risk-register: the matrix formulas in mapping.yaml are keyed to exactly
// these members in exactly this order.
Enum raid_likelihood {
  "Rare"
  "Unlikely"
  "Likely"
  "Very Likely"
  "Almost Certain"
}

Enum raid_consequence {
  "Minor"
  "Moderate"
  "Substantial"
  "Major"
  "Business Critical"
}

// A project risk is open or it is closed. There is no Provisional step: on a
// project there is nobody between the person who spots the risk and the person
// who owns it, so a draft state would only be a queue nobody drains.
Enum raid_risk_status {
  "Open"
  "Closed"
}

Enum raid_risk_response {
  "Accept"
  "Manage"
  "Tolerate"
  "Transfer"
  "Terminate"
  "Monitor"
}

Enum raid_action_status {
  "Open"
  "In progress"
  "Done"
  "Dropped"
}

Enum raid_issue_severity {
  "Minor"
  "Moderate"
  "Major"
  "Critical"
}

Enum raid_issue_status {
  "Open"
  "In progress"
  "Resolved"
  "Closed"
}

Table ProjectRisk {
  Id          int              [pk, increment]
  Title       nvarchar         [not null, note: 'The risk, stated as an uncertain event: "Supplier misses the integration milestone"']
  Detail      richtext         [note: 'Cause -> event -> consequence. What could trigger it, what happens to the project if it does']
  Likelihood  raid_likelihood  [not null, note: 'How likely the assessed consequence is, with whatever is already in place']
  Consequence raid_consequence [not null, note: 'The highest reasonable consequence for the project, with whatever is already in place']
  // Calculated: the 5x5 matrix formula lives in mapping.yaml so the rating
  // cannot drift from the matrix it came from. The formulas are keyed to the
  // two enums above; read the coupling note in mapping.yaml before editing
  // either.
  ResidualRiskRating calculated_text   [note: 'Calculated automatically from Likelihood and Consequence: Low, Medium, High or Extreme']
  RiskScore   calculated_number [note: 'Calculated automatically: the matrix score 1-25. Sort the log by this, highest first']
  RiskOwner   person           [not null, note: 'Manages the risk day to day. One person, never a team']
  RiskResponse raid_risk_response [note: 'What the project is doing about it. Tolerate is always for a set period and belongs in the decision log']
  Status      raid_risk_status [not null, default: 'Open', note: 'Close only once the risk can no longer happen or no longer matters, and say why in Closure Note']
  ReviewDate  date             [not null, note: 'When this risk is next looked at. Set by hand, and moved forward every time it is actually reviewed']
  ClosureNote richtext         [note: 'Why the risk is being closed: it happened and became an issue, it can no longer happen, or the project ended']

  // Filter columns for the declared views. The calculated rating and score
  // cannot be indexed by SharePoint and are rejected by the build validator.
  // Title carries no entry here: it is the display column of a lookup target,
  // so the build indexes it automatically.
  indexes {
    Status
    RiskResponse
    ReviewDate
  }

  Note: 'Uncertain events that could still stop this project delivering, each rated on the 5x5 matrix, owned by one person and carrying the date it is next reviewed.'
}

Table ProjectAction {
  Id            int                [pk, increment]
  Title         nvarchar           [not null, note: 'The action, stated as a verb: "Book the integration test window"']
  AssignedTo    person             [not null, note: 'One named person. "The team" is how actions quietly die']
  DueDate       date               [not null, note: 'A real date. "ASAP" is not a date and neither is the end of the project']
  Status        raid_action_status [not null, default: 'Open', note: 'Dropped is an honest answer. An action that no longer makes sense is not still Open']
  // Lookup to ProjectRisk. OPTIONAL on purpose: most actions are ordinary
  // project work, and demanding a risk for each one would produce invented
  // links rather than real ones.
  RelatedRisk   int                [ref: > ProjectRisk.Id, note: 'The risk this action is reducing, if it is reducing one. Leave blank for ordinary project work']
  CompletedDate date               [note: 'The date the work was actually finished. Required once Status is Done']
  Notes         richtext           [note: 'Progress, blockers, and why a date moved if it moved']

  indexes {
    Status
    AssignedTo
    DueDate
    RelatedRisk
  }

  Note: 'Work the project has handed to somebody, each with one owner and a real date. The open rows here are the follow-up list every project meeting reads from.'
}

Table ProjectIssue {
  Id          int                 [pk, increment]
  Title       nvarchar            [not null, note: 'The issue, stated as a fact: "The test environment is not available"']
  Severity    raid_issue_severity [not null, default: 'Minor', note: 'How much this is hurting the project right now, not how much it might']
  Status      raid_issue_status   [not null, default: 'Open', note: 'Resolved means the issue has stopped happening. Closed means somebody has confirmed it']
  Owner       person              [not null, note: 'Drives this issue to a resolution. One person, never a team']
  RaisedDate  date                [not null, default: '[today]', note: 'When the issue was first raised. Fills with today automatically; change it if you are recording something older']
  // Lookup to ProjectRisk. Optional, same reasoning as ProjectAction: an
  // issue that arrived out of nowhere is the normal case, and a risk that
  // materialised is the interesting one.
  RelatedRisk  int                [ref: > ProjectRisk.Id, note: 'The risk that materialised into this issue, if one did. Leave blank if the issue was never on the risk log']
  ResolvedDate date               [note: 'The date the issue stopped happening']
  Detail       richtext           [note: 'What is happening, since when, and what it is costing the project']
  Resolution   richtext           [note: 'What was done, and what would stop it recurring']

  indexes {
    Status
    Severity
    Owner
    RaisedDate
    RelatedRisk
  }

  Note: 'Things that have already gone wrong on this project, recorded as facts rather than as possibilities, each owned by somebody until it is resolved and closed.'
}

Table ProjectDecision {
  Id           int      [pk, increment]
  Title        nvarchar [not null, note: 'The decision, stated as a decision: "We will drop reporting from phase one"']
  DecisionDate date     [not null, note: 'When the decision was actually made, not when it was typed in here']
  DecidedBy    person   [note: 'Who made the call. Blank when it was a group, and the group belongs in Detail']
  Detail       richtext [note: 'Context, the options considered, and who disagreed. Enough that nobody reopens it in six months']

  indexes {
    DecisionDate
  }

  Note: 'What the project decided and why, recorded as a decision rather than as a discussion, so nobody has to reopen the argument or re-read a set of minutes.'
}
