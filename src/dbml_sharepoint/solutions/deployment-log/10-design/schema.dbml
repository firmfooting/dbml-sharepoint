// ============================================================================
// Central deployment log: two lists, on one site, written by every deploy in
// the fleet. Render the ERD by pasting this file into dbdiagram.io
// ============================================================================

Project deployment_log { database_type: 'SharePoint Online Lists' }

// What a Deployments row records. Every member is written by the deploy
// script, never typed: `deployment start` opens a run, `deployment stop`
// closes a clean one, `abort` closes one that recorded errors, `provenance`
// names what built the bundle, and `change` is a type-2 change row the
// deploy has not yet moved to its own list (`Changes`, below) -- today's
// writer still posts it here, with `StampKind: 'change'`, because it has one
// central write target rather than two. Adding a member here means teaching
// the deployer to write it, because nothing else produces rows.
Enum stamp_kind {
  "deployment start"
  "deployment stop"
  "abort"
  "provenance"
  "change"
}

// The table name IS the SharePoint list title, and `firmfooting_` is the
// mapping's prefix: this list is `firmfooting_Deployments` on every site it
// reaches, because it holds rows from every firmfooting application, of
// which dbml-sharepoint is one. That exact spelling is what every other
// family's deploy probes (analysis/sidecars.py, EXTERNAL_LOG_DEFAULT) and
// what DBMLSP_DEPLOY_LOG_LIST defaults to. Renaming the table renames the
// address; change both or neither. The org token is the mapping's `prefix`,
// so an org taking this family edits that one line rather than this file.
// Every column below but `Title` and `Id` comes straight from
// `CENTRAL_LOG_COLUMNS` (analysis/sidecars.py), the same anti-drift
// principle `Changes` uses below.
Table Deployments {
  Id       int        [pk, increment]
  // The human-readable stamp, the one column a generic list is guaranteed
  // to have. A deploy that finds the structured columns absent writes this
  // alone, so the sentence has to stand by itself.
  Title    nvarchar   [not null, note: 'The stamp as one sentence: what happened, to which release, when. Written by the deploy script']
  StampKind stamp_kind [not null, note: 'What this row records. Written by the deploy script; a row you type by hand is not a deployment record']
  StampUtc datetime   [not null, note: 'When the stamp was written, in UTC. The deploy sends UTC so rows from sites in different regions sort against each other']
  SourceSite nvarchar [note: 'The site the deploy ran against. This is the column that makes the log fleet-wide rather than per-site']
  ReleaseTag nvarchar [note: 'The release the bundle was built from, as release.yaml declared it']
  SchemaVersion nvarchar [note: 'The schema version the bundle was built from']
  DeployerVersion nvarchar [note: 'The dbml-sharepoint version that generated the bundle']
  Operator nvarchar   [note: 'The account that pasted the script. Read from SharePoint at run time, not typed']
  Details  longtext   [note: 'What the run did: error count, lists created and renamed, columns created and skipped, elapsed time. Free text, because the shape of it changes with the deployer']
  Application nvarchar [not null, note: 'The firmfooting application that wrote this row. Written from a constant the writing tool owns, so a reader never has to parse it out of DeployerVersion']

  // Supported indexes for the declared views and the filters a reader
  // reaches for. StampKind is indexed because three of the four declared
  // views filter on it; StampUtc because the default view sorts on it and
  // this list grows with every deploy in the fleet. Application is indexed
  // for the same reason as on `Changes`: cross-application reporting
  // filters on it, and this list is deliberately unbounded.
  indexes {
    StampKind
    SourceSite
    StampUtc
    Application
  }

  Note: 'Deployment stamps from every firmfooting application and every site this tool provisions: what was deployed, where, by whom, and whether it finished.'
}

// The central change log's type-2 half, split from `Deployments` so that
// each list's name is true of every row in it (the split mirrors the
// per-site pair this tool already keeps: `dbml_Deployments` never carries a
// change row and `dbml_Changes` never carries a stamp). `firmfooting_Changes`
// is what a deploy with a reachable central log probes for change rows
// (analysis/sidecars.py, EXTERNAL_CHANGE_LOG_DEFAULT). Every column below
// but `Title` and `Id` comes straight from `CENTRAL_CHANGE_COLUMNS`
// (analysis/sidecars.py, derived from `CHANGE_FIELDS`), which is what a
// central change row actually POSTs; the set is not hand-picked here, so it
// cannot drift from what the fleet writes.
Table Changes {
  Id       int        [pk, increment]
  // A change row still needs a human-readable line: this is what the
  // SharePoint UI shows in every default view, and a log whose rows all
  // read "Item" is unreadable in the browser.
  Title    nvarchar   [not null, note: 'The change as one sentence: the key this row belongs to. Written by the deploy script']
  SourceSite nvarchar [note: 'The site the change was made on. ChangeKey is unique only within a site, so a reader groups by SourceSite and ChangeKey together']
  ChangeKey nvarchar [note: 'The reporting row key this change belongs to. Unique within a site, not across the fleet']
  ChangeKind nvarchar [note: 'What changed: rename, create, permission']
  TargetName nvarchar [note: 'The list, level or group the change lands on']
  OldValue nvarchar [note: 'The value before the change; empty for a create']
  NewValue nvarchar [note: 'The value after the change']
  // The change's own timestamp, and the one this list sorts and closes on.
  // No separate StampUtc: CENTRAL_CHANGE_COLUMNS carries no such column, so
  // this list declares none, rather than a column the fleet never fills.
  EffectiveFrom datetime [note: 'When the change took effect']
  EffectiveTo datetime [note: 'When the next change for this key took effect. Empty on the current row']
  IsCurrent boolean [note: 'Whether this row is the current one for its key, site and application. Exactly one row per (SourceSite, ChangeKey, Application) carries true']
  ReleaseTag nvarchar [note: 'The release that made the change, as release.yaml declared it']
  Application nvarchar [not null, note: 'The firmfooting application that wrote this row. ChangeKey is unique only within a site, so two applications provisioning lists on one site can raise the same key; the type-2 close filters on this column as well, so it never closes a row that belongs to a different application']

  // SourceSite, ChangeKey, Application and IsCurrent are the type-2 close
  // filter, read as one four-way AND (`SourceSite eq X and ChangeKey eq Y
  // and Application eq Z and IsCurrent eq true`). EVERY side of an AND has
  // to be indexed for the filter to survive the 5,000-item list view
  // threshold, and this is a list that grows with every change any
  // firmfooting application makes, on any site.
  indexes {
    SourceSite
    ChangeKey
    IsCurrent
    Application
  }

  Note: 'Type-2 change rows from every firmfooting application and site this tool provisions: what changed, when, and whether the row is still current.'
}
