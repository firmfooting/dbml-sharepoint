// ============================================================================
// Measures register: the KPI catalogue with definition discipline.
// Render the ERD by pasting this file into https://dbdiagram.io
// ============================================================================

Project measures_register { database_type: 'SharePoint Online Lists' }

Enum measure_frequency {
  "Weekly"
  "Monthly"
  "Quarterly"
  "Annually"
}

Enum measure_direction {
  "Higher is better"
  "Lower is better"
  "Within range"
}

Enum measure_status {
  "Active"
  "Under development"
  "Retired"
}

Table Measure {
  Id          int                [pk, increment]
  Title       nvarchar           [not null, note: 'The measure name as reported: "Complaints acknowledged within 2 days (%)"']
  MeasureArea nvarchar           [not null, note: 'Function or theme it belongs to: Quality, Finance, People, Service']
  Owner       person             [not null, note: 'Who is accountable for this number being right and reported']
  // Definition discipline is expanded in the adoption guide.
  Definition  richtext           [not null, note: 'Numerator, denominator, inclusions/exclusions, date anchors. Written so two strangers would compute the same number']
  DataSource  nvarchar           [not null, note: 'Where the raw data comes from: system, list, extract']
  Frequency   measure_frequency  [not null, default: 'Monthly']
  Direction   measure_direction  [not null, note: 'Which way is good']
  Target      nvarchar           [note: 'The target and its unit: "95%", "under 10 days", "between 85 and 100". Blank = monitored, not targeted']
  ReportedTo  nvarchar           [not null, note: 'The forum(s) that see it: team meeting, executive, board, regulator']
  Status      measure_status     [not null, default: 'Active']
  LastReviewedDate date          [note: 'When the definition was last actually re-tested against the two-strangers test. Blank means nobody ever has, which is why an Active measure cannot be saved without it']
  NextReviewDue    calculated_date [note: 'When the definition is next re-tested. Calculated twelve months on from Last Reviewed Date, which is the cadence 50-govern sets. Nobody can type it, so nobody can push a review out. Blank on a retired measure and until the first review is dated']
  ReviewDate  date               [note: 'Retired, superseded by Next Review Due. Kept declared so the deploy still manages it; transfer the values, then delete the column with the columns sidecar']
  Notes       richtext           [note: 'Definition change history (dated), known data caveats']

  indexes {
    Status
    MeasureArea
    Frequency
  }

  Note: 'The numbers the organisation reports on, and for each the definition it is calculated by, so two people working from different data arrive at the same figure.'
}
