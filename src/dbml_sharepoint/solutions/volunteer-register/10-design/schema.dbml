// ============================================================================
// Volunteer register: one list; checks with expiries are the point.
// Render the ERD by pasting this file into https://dbdiagram.io
// ============================================================================

Project volunteer_register { database_type: 'SharePoint Online Lists' }

Enum volunteer_status {
  "Applying"
  "Active"
  "Inactive"
  "Exited"
}

Table Volunteer {
  Id                int              [pk, increment]
  Title             nvarchar         [not null, note: 'Volunteer name']
  VolunteerRole     nvarchar         [not null, note: 'What they do: "Ward visitor", "Driver", "Op-shop", "Events"']
  Team              nvarchar         [note: 'Programme or team they belong to']
  Coordinator       person           [not null, note: 'The staff member who coordinates this volunteer']
  StartDate         date
  Status            volunteer_status [not null, default: 'Applying']
  // Compliance mechanics: the monthly expiry sweep works this column.
  PoliceCheckExpiry date             [note: 'Expiry date of the police check. Leave blank if a check is not yet held']
  WWCCNumber        nvarchar         [note: 'Working with Children Check (or your jurisdiction equivalent) card number']
  // Which roles require a WWCC is defined in the governance matrix.
  WWCCExpiry        date             [note: 'Expiry date of the WWCC. Leave blank if not held; some roles do not require one']
  InductionDate     date             [note: 'When their induction was completed']
  EmergencyContact  nvarchar         [note: 'Name and phone only, the minimum needed on the day']
  // Privacy rules (governance doc) limit what may be recorded about a volunteer.
  Notes             richtext         [note: 'Availability, relevant skills, role history. Record professional facts only']

  indexes {
    Status
    Team
    PoliceCheckExpiry
    WWCCExpiry
  }

  Note: 'Everyone volunteering with the organisation, what they do, who coordinates them, and the expiry dates of the checks that let them keep doing it.'
}
