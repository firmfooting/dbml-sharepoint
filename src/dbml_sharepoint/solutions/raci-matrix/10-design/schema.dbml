// ============================================================================
// RACI matrix: activities, the parties involved in them, and the party
// vocabulary both point at.
// Render the ERD by pasting this file into https://dbdiagram.io
// ============================================================================

Project raci_matrix { database_type: 'SharePoint Online Lists' }

Enum party_kind {
  "Individual"
  "Role"
  "Forum"
  "External"
}

Enum party_status {
  "Active"
  "Inactive"
}

Enum activity_domain {
  "Governance"
  "Finance"
  "People"
  "Service delivery"
  "Information & technology"
  "Facilities & assets"
  "Quality & risk"
  "External relations"
}

Enum activity_kind {
  "Task"
  "Approval"
  "Decision"
}

Enum criticality {
  "Statutory"
  "High"
  "Routine"
}

Enum review_status {
  "Current"
  "Needs review"
  "Retired"
}

Enum involvement_role {
  "Consulted"
  "Informed"
}

Enum involvement_channel {
  "Standing agenda item"
  "Meeting"
  "Email"
  "Report or dashboard"
  "Ad hoc"
}

Table Activity {
  Id               int             [pk, increment]
  Title            nvarchar        [not null, note: 'The activity as a verb phrase: "Approve a new supplier", "Publish the quarterly report"']
  Domain           activity_domain [not null, note: 'The area of the business this activity belongs to. Used to group the register for review']
  ActivityKind     activity_kind   [not null, default: 'Task', note: 'Task: Responsible does the work, Accountable owns the outcome. Approval: Responsible prepares, Accountable signs. Decision: Responsible runs the process, Accountable makes the call']
  Criticality      criticality     [not null, default: 'Routine', note: 'Statutory means law, licence or funding agreement requires it. Sets how often this row must be re-confirmed: Statutory 6 months, High 12, Routine 24']
  Detail           richtext        [note: 'What this activity covers and, just as usefully, what it does not. Write the boundary that stops somebody claiming a neighbouring activity is included']
  Responsible      person          [not null, note: 'The one person who does the work. A named individual, never a team; a team that is Responsible means nobody is']
  Accountable      person          [not null, note: 'The one person who answers for the outcome. Exactly one, always: two people accountable means each assumes the other is watching']
  AccountableForum int             [ref: > Party.Id, note: 'The forum this accountability is exercised through, where there is one. The person above still answers for it; a committee cannot be performance-managed']
  EscalationRoute  nvarchar        [note: 'Where this goes when Responsible and Accountable cannot agree. Required for a Decision and for anything Statutory']
  ReviewStatus     review_status   [not null, default: 'Current', note: 'Set Needs review the moment you know a row is wrong; that is what makes it visible. Retired keeps the history without cluttering the register']
  LastConfirmed    date            [not null, default: '[today]', note: 'The date somebody last checked that this row is still true. Fills automatically when the activity is created - update it each time you re-confirm the row. The whole confirmation cadence counts from here']
  ConfirmedBy      person          [note: 'Who did that check. Not the same as who last edited the row; an edit is not a confirmation']
  ConfirmationDue  calculated_date [note: 'When this row must be re-confirmed. Calculated from Last Confirmed and Criticality; blank on a retired row']

  indexes {
    ReviewStatus
    Criticality
    Accountable
    Domain
  }

  Note: 'One row per thing done, approved or decided, naming the one person who does it and the one who answers for it. Consulted and informed parties live in Involvement.'
}

Table Party {
  Id        int          [pk, increment]
  Title     nvarchar     [not null, unique, note: 'The party as everyone refers to it: "Executive Director", "Clinical Governance Committee"']
  PartyKind party_kind   [not null, default: 'Individual', note: 'Individual is one named person; Role is a position whoever holds it; Forum is a committee or meeting; External is outside the organisation']
  Contact   person       [note: 'For an Individual, themselves. For a Role, whoever holds it now. For a Forum, its chair or secretariat. Update this instead of renaming the party when the holder changes']
  Status    party_status [not null, default: 'Active', note: 'Set Inactive when a person leaves or a forum is disbanded. Never delete a party; activities and involvements point at it and would be orphaned']
  Notes     nvarchar     [note: 'Anything a reader needs to interpret this party correctly: its terms of reference, its meeting cadence, who it reports to']

  indexes {
    PartyKind
    Status
  }

  Note: 'The vocabulary of everyone who can hold a role in the matrix: individuals, roles, forums and external bodies. Retire a party by setting its Status, not by deleting it.'
}

Table Involvement {
  Id          int                 [pk, increment]
  Title       nvarchar            [not null, note: 'State the INPUT, not the person: "Pricing tolerance and contract terms". A party you cannot write this sentence for is not Consulted; they are Informed, or nothing']
  Activity    int                 [not null, ref: > Activity.Id, note: 'The activity this party is involved in']
  Party       int                 [not null, ref: > Party.Id, note: 'Who is involved. A person, a role, a forum or an external body']
  Involvement involvement_role    [not null, default: 'Informed', note: 'Consulted means their input is required BEFORE the activity proceeds. Informed means they are told, and cannot hold it up']
  Channel     involvement_channel [not null, default: 'Email', note: 'How this happens in practice. An involvement with no channel is a promise nobody keeps']
  Notes       nvarchar            [note: 'Anything a reader needs: timing, the standing item it sits under, what happens if they do not respond']

  indexes {
    Activity
    Party
    Involvement
  }

  Note: 'One row per party consulted or informed about an activity. The title states the input they give, which stops the list becoming a register of everyone who asked.'
}
