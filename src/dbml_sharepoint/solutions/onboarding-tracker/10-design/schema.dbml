// ============================================================================
// Onboarding tracker: starters, and the cross-functional tasks per starter.
// Render the ERD by pasting this file into https://dbdiagram.io
// ============================================================================

Project onboarding_tracker { database_type: 'SharePoint Online Lists' }

Enum starter_status {
  "Preparing"
  "Started"
  "Complete"
  "Withdrawn"
}

Enum task_function {
  "HR"
  "IT"
  "Facilities"
  "Finance / payroll"
  "Manager"
  "Other"
}

Enum task_status {
  "Open"
  "Done"
  "Not applicable"
}

Table Starter {
  Id         int             [pk, increment]
  Title      nvarchar        [not null, note: 'Name of the new starter']
  Role       nvarchar        [not null, note: 'Position title']
  Department nvarchar        [note: 'Team / department they join']
  StartDate  date            [not null]
  Manager    person          [not null, note: 'Hiring manager, owns the overall experience']
  Status     starter_status  [not null, default: 'Preparing']
  Notes      richtext        [note: 'Anything the functions need to know (part-time pattern, location, equipment specifics)']

  indexes {
    StartDate
    Status
  }

  Note: 'People joining the organisation, with their role, start date and hiring manager. The tasks for each one live in the companion list and point back here.'
}

Table OnboardingTask {
  Id           int            [pk, increment]
  Title        nvarchar       [not null, note: 'The task: "Create AD account", "Order laptop", "Payroll setup"']
  // Lookup to Starter.
  Starter      int            [not null, ref: > Starter.Id, note: 'The new starter this task is for']
  TaskFunction task_function  [not null, note: 'Which function owns this task']
  AssignedTo   person         [note: 'The specific person, once picked up']
  DueDate      date           [not null, note: 'Usually relative to the start date, before or shortly after']
  Status       task_status    [not null, default: 'Open']
  DoneDate     date
  Notes        nvarchar

  indexes {
    Starter
    TaskFunction
    Status
    DueDate
  }

  Note: 'What HR, IT, facilities, payroll and the manager must do for a new starter, with an owner and date. One row per task, so nothing falls between them.'
}
