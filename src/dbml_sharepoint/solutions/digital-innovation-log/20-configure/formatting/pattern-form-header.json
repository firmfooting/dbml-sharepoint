{
  "elmType": "div",
  "attributes": { "class": "ms-borderColor-neutralTertiary" },
  "style": {
    "width": "99%",
    "border-top-width": "0px",
    "border-bottom-width": "1px",
    "border-left-width": "0px",
    "border-right-width": "0px",
    "border-style": "solid",
    "margin-bottom": "16px",
    "padding-bottom": "8px"
  },
  "children": [
    {
      "elmType": "div",
      "style": { "display": "flex", "box-sizing": "border-box", "align-items": "center" },
      "children": [
        {
          "elmType": "div",
          "attributes": {
            "iconName": "Rocket",
            "class": "ms-fontSize-42 ms-fontWeight-regular ms-fontColor-themePrimary",
            "title": "Reusable M365 pattern"
          },
          "style": { "flex": "none", "padding": "0px", "height": "auto" }
        },
        {
          "elmType": "div",
          "style": { "box-sizing": "border-box", "width": "100%", "text-align": "left", "padding": "4px 8px", "overflow": "hidden" },
          "children": [
            {
              "elmType": "div",
              "attributes": { "class": "ms-fontColor-neutralSecondary ms-fontWeight-bold ms-fontSize-16" },
              "txtContent": "=if([$Title] == '', 'New pattern', 'Pattern: ' + [$Title])"
            },
            {
              "elmType": "div",
              "attributes": { "class": "ms-fontColor-neutralSecondary ms-fontSize-12" },
              "txtContent": "One pattern, many teams."
            },
            {
              "elmType": "div",
              "attributes": { "class": "ms-fontColor-neutralSecondary ms-fontSize-12" },
              "txtContent": "=if([$Status] == '', 'Status: Proposed', 'Status: ' + [$Status])"
            }
          ]
        }
      ]
    }
  ]
}
