// ============================================================================
// Process register: the business-process inventory with a calculated
// digitisation-priority score. Render the ERD on https://dbdiagram.io
// ============================================================================

Project process_register { database_type: 'SharePoint Online Lists' }

Enum process_criticality {
  "Low"
  "Medium"
  "High"
}

Enum process_state {
  "Paper / manual"
  "Email / ad hoc"
  "Spreadsheet"
  "Shared list / basic digital"
  "System of record"
}

Enum pain_level {
  "Minor"
  "Moderate"
  "Severe"
}

Enum digitisation_status {
  "Not assessed"
  "Assessed"
  "Planned"
  "In progress"
  "Digitised"
  "Not worth digitising"
}

Table BusinessProcess {
  Id                   int                  [pk, increment]
  Title                nvarchar             [not null, note: 'The process, verb first: "Approve staff travel", "Register visitors"']
  Function             nvarchar             [not null, note: 'Which team or function runs it']
  Owner                person               [not null, note: 'The person accountable for how this process works']
  Purpose              richtext             [note: 'What the process achieves and for whom (two sentences)']
  Criticality          process_criticality  [not null, default: 'Medium', note: 'Scored against the governance definitions']
  CurrentState         process_state        [not null, note: 'How it is actually done today. Be honest, the spreadsheet counts as a spreadsheet']
  PainLevel            pain_level           [not null, default: 'Moderate', note: 'How much the current state hurts: rework, delays, errors, key-person risk']
  PainNotes            richtext             [note: 'The specific pain: where it breaks, who it burns, what it costs']
  // Calculated: formula in mapping.yaml. The programme worklist sorts by this score.
  DigitisationPriority calculated_number    [note: 'Digitisation priority from 1 to 9: criticality multiplied by pain level. Higher means digitise sooner. Calculates itself once Criticality and Pain level are set.']
  DigitisationStatus   digitisation_status  [not null, default: 'Not assessed']
  TargetState          nvarchar             [note: 'Where it should end up: which system, which template, which form']
  SystemUrl            hyperlink            [note: 'Link to the digitised process once it exists (the list, form or system)']
  LastReviewedDate     date                 [note: 'When somebody last checked this row is still true. Blank means nobody ever has, which is a finding rather than a gap to fill with a guess']
  NextReviewDue        calculated_date      [note: 'Next inventory review of this row. Calculated twelve months after Last Reviewed Date, which is the annual refresh 50-govern sets. Nobody can type it, so nobody can push a refresh out. Blank until the row has been through its first review']
  ReviewDate           date                 [note: 'Retired, superseded by Next Review Due. Kept declared so the deploy still manages it; transfer the values, then delete the column with the columns sidecar']

  indexes {
    Function
    DigitisationStatus
    CurrentState
  }

  Note: 'An inventory of how work actually gets done today, by paper, email, spreadsheet or a real system, with a score ranking which are worth digitising first.'
}
