// ============================================================================
// Service requests — one intake list, per-team queues by category.
// Render the ERD by pasting this file into https://dbdiagram.io
// ============================================================================

Project service_requests { database_type: 'SharePoint Online Lists' }

Enum request_category {
  "Facilities / maintenance"
  "IT / equipment"
  "Admin / office services"
  "Grounds / vehicles"
  "Other"
}

Enum request_priority {
  "Low"
  "Normal"
  "Urgent"
}

Enum request_status {
  "Submitted"
  "Accepted"
  "In progress"
  "Waiting - parts or approval"
  "Completed"
  "Declined"
}

Table Request {
  Id             int              [pk, increment]
  Title          nvarchar         [not null, note: 'The request in one line: "Meeting room 2 screen not detecting laptops"']
  Category       request_category [not null, note: 'Routes the request to the right team queue']
  Priority       request_priority [not null, default: 'Normal', note: 'Urgent = blocking work or a safety issue; triage may re-set it']
  RequestLocation nvarchar        [note: 'Where: building / room / asset tag if known']
  RequestedBy    person           [note: 'Who is asking (defaults to you)']
  RequestedDate  date             [not null]
  Detail         richtext         [note: 'What is needed and why; photos help — attach them to the item']
  AssignedTo     person           [note: 'Set when a team member picks it up']
  Status         request_status   [not null, default: 'Submitted']
  CompletedDate  date
  // Calculated column — formula in mapping.yaml (RequestedDate -> CompletedDate).
  DaysToComplete calculated_number [note: 'How many days the request took, from requested to completed. Calculated automatically. Blank until both dates are set.']
  Resolution     nvarchar         [note: 'What was done, or why declined']

  indexes {
    Status
    Category
    Priority
    RequestedDate
  }
}
