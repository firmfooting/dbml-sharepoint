// ============================================================================
// Vehicle log — the fleet catalogue + every trip, kilometres calculated.
// Render the ERD by pasting this file into https://dbdiagram.io
// ============================================================================

Project vehicle_log { database_type: 'SharePoint Online Lists' }

Enum vehicle_status {
  "In service"
  "In workshop"
  "Disposed"
}

Enum trip_type {
  "Business"
  "Private - approved"
  "Commute - approved"
}

Table Vehicle {
  Id           int            [pk, increment]
  Title        nvarchar       [not null, note: 'How staff refer to it: "White HiLux", "Pool car 2"']
  Rego         nvarchar       [not null, unique, note: 'Registration plate — unique']
  MakeModel    nvarchar       [not null]
  HomeLocation nvarchar       [note: 'Where it lives / where keys are kept']
  Status       vehicle_status [not null, default: 'In service']
  Notes        nvarchar       [note: 'Fuel card ref, e-tag, quirks the next driver should know']

  indexes {
    Status
  }

  Note: 'The fleet: each pool car, ute or van, its plate, where the keys live and whether it is on the road. Every trip is recorded against one of these entries.'
}

Table Trip {
  Id         int       [pk, increment]
  Title      nvarchar  [note: 'Optional note; trips are identified by vehicle + time']
  // Lookup to Vehicle.
  Vehicle    int       [not null, ref: > Vehicle.Id, note: 'The vehicle this trip belongs to']
  Driver     person    [not null, note: 'Who drove (defaults to you)']
  TripType   trip_type [not null, default: 'Business']
  Purpose    nvarchar  [not null, note: 'Destination and business reason: "Warragul clinic - equipment delivery". This column is your tax substantiation — specific, not "errands"']
  DepartedAt datetime  [not null]
  ReturnedAt datetime
  OdoStart   number    [not null, note: 'Odometer reading at departure — read it, do not guess it']
  OdoEnd     number    [note: 'Odometer at return']
  // calculated_number — formula in mapping.yaml (OdoEnd minus OdoStart).
  TripKm     calculated_number [note: 'Calculated automatically: kilometres travelled, end odometer minus start. Fills itself in once both readings are entered. A negative number means a mis-read odometer — fix the readings']
  Notes      nvarchar  [note: 'Fuel added, damage noticed, warning lights']

  indexes {
    Vehicle
    Driver
    DepartedAt
  }

  Note: 'One row per journey, with the driver, the odometer at each end and the business reason. That reason is what makes the log defensible to finance and to the tax office.'
}
