{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/column-formatting.schema.json",
  "elmType": "div",
  "style": { "display": "flex", "border-radius": "4px", "margin": "1px 4px 1px 0" },
  "attributes": {
    "class": "=if(@currentField == '', 'sp-field-severity--low ms-fontColor-neutralSecondary', '')"
  },
  "children": [
    {
      "elmType": "span",
      "style": { "display": "=if(@currentField == '', 'inline-block', 'none')", "padding": "0 4px" },
      "attributes": { "iconName": "=if(@currentField == '', 'Forward', '')" }
    },
    {
      "elmType": "span",
      "style": { "padding": "0 4px" },
      "txtContent": "=if(@currentField == '', 'Out now', toLocaleString(@currentField))"
    }
  ]
}
