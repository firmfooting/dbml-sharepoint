Project legal_compliance_register { database_type: 'SharePoint Online Lists' }

// Customise these executive divisions and the mapping's folders together.
Enum division {
  "Clinical services"
  "Corporate services"
  "Community services"
  "Executive and governance"
}

Enum item_type {
  "SAQ"
  "REG"
}

// These quarters identify the publisher's issue, not the assessment cycle.
Enum quarter {
  "Q1"
  "Q2"
  "Q3"
  "Q4"
}

Enum review_requirement {
  "Not required"
  "Required"
}

Enum assessment_status {
  "Required"
  "In progress"
  "Complete"
  "No longer required"
}

// A new container avoids changing the old SAQ.Topic lookup into a text field.
Table Document {
  Id                   int                [pk, increment]
  TopicName            nvarchar           [note: 'The portal topic name, including jurisdiction, shared by its SAQs and REGs']
  PortalTopicId        nvarchar           [note: 'Topic ID from the publisher workbook. Repeated across reference files and assessments of the same topic']
  ItemType             item_type          [not null, default: 'SAQ', note: 'SAQ is an assessment workbook; REG is reference material and has no assessment workflow']
  IssuedYear           int                [note: 'Publisher issuance year from the original filename, not the upload year or assessment year']
  IssuedQuarter        quarter            [note: 'Publisher issuance quarter from the original filename, not the assessment quarter']
  Division             division           [note: 'The executive division whose folder holds this file']
  AssessmentRef        nvarchar           [note: 'Organisation-assigned assessment reference, also included in the filename. Each new assessment gets a new file even when the publisher issue is unchanged']
  ExecutiveResponsible person             [note: 'Assigned by the platform owner according to the executive division folder; assigns the business owner and may review the completed SAQ']
  BusinessOwner        person             [note: 'Assigned by the executive to complete this assessment in Excel']
  PlatformOwner        person             [note: 'Files and assigns this assessment, then records the completed workbook in the compliance platform']
  DueDate              date               [note: 'When the business owner must complete this assessment']
  Status               assessment_status  [default: 'Required', note: 'SAQ progress only. Complete means the business owner has finished; portal recording is tracked separately']
  CompletedDate        date               [note: 'When the business owner completed the SAQ in Excel']
  ReviewRequirement    review_requirement [default: 'Not required', note: 'The executive requests a review before portal recording. Choose Not required when executive review is not needed']
  ReviewedDate         date               [note: 'When the executive reviewed the completed SAQ. Optional unless review was requested']
  ExternalRecorded     date               [note: 'When the platform owner recorded this assessment in the compliance platform']
  // MEASURED 2026-09-13: Notes collides with a built-in library field.
  TrackingNotes        longtext           [note: 'Plain-text assignment, migration or handoff notes. Responses, compliance, risk, controls and gaps stay in Excel']

  indexes {
    TopicName
    PortalTopicId
    ItemType
    Division
    AssessmentRef
    Status
    DueDate
    ExecutiveResponsible
    BusinessOwner
    PlatformOwner
  }

  Note: 'SAQ assessments and REG references, tracking assignment, completion, optional executive review and portal recording. Content stays in Excel.'
}
