// The smallest useful dbml-sharepoint schema: one list, four columns.
Project minimal { database_type: 'SharePoint Online Lists' }

Enum ticket_status {
  "Open"
  "In Progress"
  "Done"
}

Table Ticket {
  Id        int           [pk, increment]
  Title     nvarchar      [not null, note: 'Short summary']
  Status    ticket_status [not null, default: 'Open']
  Owner     person        [note: 'Who is handling this']
  DueDate   date

  indexes {
    Status
  }

  Note: 'Requests raised by staff and tracked to completion, each one owned by a named person and carrying the status and due date the queue is worked from.'
}
